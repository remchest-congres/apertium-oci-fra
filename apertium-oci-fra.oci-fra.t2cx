    <!-- RÈGLAS çò -->

    <!-- çò > -il(s)/elle(s) -->

    <rule comment="RÈGLA: çò SV_vblex_p3: çò ditz > dit-il">
      <pattern>
        <pattern-item n="cela"/>
        <pattern-item n="SV_vblex_p3"/>
      </pattern>
      <action>
        <call-macro n="f_is_net"><with-param pos="2"/></call-macro>
        <call-macro n="f_bcond"><with-param pos="1"/><with-param pos="2"/></call-macro>
        <out>
          <chunk>
            <get-case-from pos="1">
              <clip pos="2" part="lem"/>
            </get-case-from>
            <clip pos="2" part="tags"/>
            <clip pos="2" part="chcontent"/>
          </chunk>
        </out>
        <call-macro n="generate_il"><with-param pos="2"/></call-macro>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: çò SPron_pro SV_vblex_p3: çò li ditz > lui dit-il">
      <pattern>
        <pattern-item n="cela"/>
        <pattern-item n="SPron_pro"/>
        <pattern-item n="SV_vblex_p3"/>
      </pattern>
      <action>
        <call-macro n="f_is_net"><with-param pos="3"/></call-macro>
        <call-macro n="f_bcond"><with-param pos="1"/><with-param pos="2"/></call-macro>
        <out>
          <chunk>
            <get-case-from pos="1">
              <clip pos="2" part="lem"/>
            </get-case-from>
            <clip pos="2" part="tags"/>
            <clip pos="2" part="chcontent"/>
          </chunk>
          <b pos="2"/>
          <chunk>
            <clip pos="3" part="whole"/>
          </chunk>
        </out>
        <call-macro n="generate_il"><with-param pos="3"/></call-macro>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: çò SV_vbhaver_p3 PP: çò a dit > a-t-il dit">
