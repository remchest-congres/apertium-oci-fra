              <equal><clip pos="1" part="lem"/><lit v="."/></equal>
            </test>
            <let><var n="BOS"/><lit v="yes"/></let>
          </when>
          <when>
            <test>
              <equal><clip pos="1" part="lem"/><lit v="—"/></equal>
            </test>
          </when>
          <otherwise>
