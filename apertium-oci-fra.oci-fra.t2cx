<?xml version="1.0" encoding="UTF-8"?>
<interchunk>
  <section-def-cats>
    <def-cat n="DET">
      <cat-item tags="Det"/>
      <cat-item tags="Det.*"/>
    </def-cat>
    <def-cat n="SN">
      <cat-item tags="SN"/>
      <cat-item tags="SN.*"/>
    </def-cat>
    <def-cat n="SA">
      <cat-item tags="SA"/>
      <cat-item tags="SA.*"/>
    </def-cat>
    <def-cat n="PP">
      <cat-item lemma="pp" tags="SA.*"/>
      <cat-item lemma="haverpp" tags="SA.*"/>
      <cat-item tags="SA.pp.*"/>
    </def-cat>
    <def-cat n="cela">
      <cat-item lemma="cela" tags="SAdv.enon"/>
    </def-cat>
    <def-cat n="SPron_pro">
      <cat-item tags="SPron.pro"/>
      <cat-item tags="SPron.pro.*"/>
    </def-cat>
    <def-cat n="SAdv">
      <cat-item tags="SAdv"/>
      <cat-item tags="SAdv.pas_neg"/>
      <cat-item lemma="ne" tags="SAdv.enon"/>
      <cat-item lemma="donc" tags="cnjadv"/>
      <cat-item lemma="cependant" tags="cnjadv"/>
      <cat-item lemma="néanmoins" tags="cnjadv"/>
      <cat-item lemma="nonobstant" tags="cnjadv"/>
      <cat-item lemma="tout de même" tags="cnjadv"/>
      <cat-item lemma="toutefois" tags="cnjadv"/>
    </def-cat>
    <def-cat n="tellement_guere_adv">
      <cat-item lemma="tellement" tags="SAdv"/>
      <cat-item lemma="tellement" tags="SAdv.*"/>
      <cat-item lemma="guère" tags="SAdv"/>
      <cat-item lemma="guère" tags="SAdv.*"/>
    </def-cat>
    <def-cat n="SV">
      <cat-item tags="SV"/>
      <cat-item tags="SV.*"/>
    </def-cat>
    <def-cat n="SV_vbhaver">
      <cat-item tags="SV.vbhaver"/>
      <cat-item tags="SV.vbhaver.*"/>
      <cat-item lemma="havercj" tags="SV.*"/>
      <cat-item lemma="haverinf_ger" tags="SV.*"/>
      <cat-item lemma="avoir" tags="SV.*"/>
    </def-cat>
    <def-cat n="SV_vbhaver_p1_p2">
      <cat-item tags="SV.vbhaver.*.p1.*"/>
      <cat-item lemma="havercj" tags="SV.*.p1.*"/>
      <cat-item lemma="haverinf_ger" tags="SV.*.p1.*"/>
      <cat-item lemma="avoir" tags="SV.*.p1.*"/>
      <cat-item tags="SV.vbhaver.*.p2.*"/>
      <cat-item lemma="havercj" tags="SV.*.p2.*"/>
      <cat-item lemma="haverinf_ger" tags="SV.*.p2.*"/>
      <cat-item lemma="avoir" tags="SV.*.p2.*"/>
    </def-cat>
    <def-cat n="SV_vbhaver_p3">
      <cat-item tags="SV.vbhaver.*.p3.*"/>
      <cat-item lemma="havercj" tags="SV.*.p3.*"/>
      <cat-item lemma="haverinf_ger" tags="SV.*.p3.*"/>
      <cat-item lemma="avoir" tags="SV.*.p3.*"/>
    </def-cat>
    <def-cat n="SV_vbhaver_p3pl">
      <cat-item tags="SV.vbhaver.*.p3.pl"/>
      <cat-item lemma="havercj" tags="SV.*.p3.pl"/>
      <cat-item lemma="haverinf_ger" tags="SV.*.p3.pl"/>
      <cat-item lemma="avoir" tags="SV.*.p3.pl"/>
    </def-cat>
    <def-cat n="SV_faire_voir">
      <cat-item lemma="faire" tags="SV.*"/>
      <cat-item lemma="voir" tags="SV.*"/>
    </def-cat>
    <def-cat n="SV_considerer_voir">
      <cat-item lemma="considérer" tags="SV.*"/>
      <cat-item lemma="voir" tags="SV.*"/>
    </def-cat>
    <def-cat n="SV_inf">
      <cat-item tags="SV.*.inf"/>
    </def-cat>

    <def-cat n="SV_ser">
      <cat-item tags="SV.vbser.*"/>
    </def-cat>

    <def-cat n="SV_vblex_p1_p2">
      <cat-item tags="SV.vblex.*.p1.*"/>
      <cat-item tags="SV.vblex.*.p2.*"/>
    </def-cat>
    <def-cat n="SV_vblex_p3">
      <cat-item tags="SV.vblex.*.p3.*"/>
    </def-cat>
    <def-cat n="SV_vblex_p3pl">
      <cat-item tags="SV.vblex.*.p3.pl"/>
    </def-cat>

    <def-cat n="SDet">
      <cat-item tags="Det"/>
      <cat-item tags="Det.*"/>
    </def-cat>

    <def-cat n="SPron">
      <cat-item tags="SPron"/>
      <cat-item tags="SPron.*"/>
    </def-cat>

    <def-cat n="Num">
      <cat-item tags="Num"/>
      <cat-item tags="Num.*"/>
    </def-cat>

    <def-cat n="cnjcoo">
      <cat-item tags="cnjcoo"/>
      <cat-item tags="cnjcoo.*"/>
    </def-cat>

    <def-cat n="cnjsub">
      <cat-item tags="cnjsub"/>
      <cat-item tags="cnjsub.*"/>
    </def-cat>

    <def-cat n="cnjadv">
      <cat-item tags="cnjadv"/>
      <cat-item tags="cnjadv.*"/>
    </def-cat>

    <def-cat n="rel">
      <cat-item tags="rel"/>
      <cat-item tags="rel.*"/>
    </def-cat>

    <def-cat n="PREP">
      <cat-item tags="PREP"/>
      <cat-item tags="PREP.*"/>
    </def-cat>
    <def-cat n="PREP_de">
      <cat-item lemma="de" tags="PREP"/>
    </def-cat>

    <def-cat n="UNK">
      <cat-item tags="unknown"/>
    </def-cat>
    <def-cat n="SN_UNK">
      <cat-item tags="SN"/>
      <cat-item tags="SN.*"/>
      <cat-item tags="unknown"/>
    </def-cat>
    <def-cat n="SNpl_UNK">
      <cat-item tags="SN.*.pl"/>
      <cat-item tags="SN.*.pl.*"/>
      <cat-item tags="unknown"/>
    </def-cat>

    <def-cat n="LPAR">
      <cat-item tags="LPAR"/>
    </def-cat>
    <def-cat n="SENT">
      <cat-item tags="sent"/>
    </def-cat>
    <def-cat n="SENT_CNJ_REL">
      <cat-item tags="sent"/>
      <cat-item tags="cnjsub"/>
      <cat-item tags="cnjadv"/>
      <cat-item tags="cnjcoo"/>
      <cat-item tags="rel"/>
      <cat-item tags="rel.*"/>
    </def-cat>
    <def-cat n="SAdv_CNJCOO">
      <cat-item tags="SAdv"/>
      <cat-item tags="SAdv.pas_neg"/>
      <cat-item lemma="ne" tags="SAdv.enon"/>
      <cat-item tags="cnjcoo"/>
      <cat-item lemma="donc" tags="cnjadv"/>
      <cat-item lemma="cependant" tags="cnjadv"/>
      <cat-item lemma="néanmoins" tags="cnjadv"/>
      <cat-item lemma="nonobstant" tags="cnjadv"/>
      <cat-item lemma="tout de même" tags="cnjadv"/>
      <cat-item lemma="toutefois" tags="cnjadv"/>
    </def-cat>

    <def-cat n="ij">
      <cat-item tags="ij"/>
    </def-cat>
  </section-def-cats>

  <section-def-attrs>
    <def-attr n="chunk">
      <attr-item tags="SN"/>
      <attr-item tags="SV"/>
    </def-attr>

    <def-attr n="pers">
      <attr-item tags="p1"/>
      <attr-item tags="p2"/>
      <attr-item tags="p3"/>
    </def-attr>

    <def-attr n="gen">
      <attr-item tags="m"/>
      <attr-item tags="f"/>
      <attr-item tags="mf"/>
      <attr-item tags="GD"/>
    </def-attr>

    <def-attr n="nbr">
      <attr-item tags="sg"/>
      <attr-item tags="pl"/>
      <attr-item tags="sp"/>
      <attr-item tags="ND"/>
    </def-attr>

    <def-attr n="sl_nbr">
      <attr-item tags="sl_sg"/>
      <attr-item tags="sl_pl"/>
      <attr-item tags="sl_sp"/>
    </def-attr>

    <def-attr n="a_np">
      <attr-item tags="np"/>
    </def-attr>

    <def-attr n="a_pron_pas_neg">
      <attr-item tags="pas_neg"/>
    </def-attr>

    <def-attr n="a_part">
      <attr-item tags="partitiu"/>
    </def-attr>

    <def-attr n="temps">
      <attr-item tags="inf"/>
      <attr-item tags="ger"/>
      <attr-item tags="pp"/>
      <attr-item tags="pri"/>
      <attr-item tags="ifi"/>
      <attr-item tags="pii"/>
      <attr-item tags="fti"/>
      <attr-item tags="cni"/>
      <attr-item tags="prs"/>
      <attr-item tags="pis"/>
      <attr-item tags="fts"/>
      <attr-item tags="imp"/>
    </def-attr>

  </section-def-attrs>

  <section-def-vars>
    <def-var n="verb"/>
    <def-var n="is_expression"/>
    <def-var n="is_net"/>
    <def-var n="es_pot_gen_part" v="yes"/>
    <def-var n="BOS" v="yes"/>	<!-- begin of sentence -->
  </section-def-vars>

  <section-def-lists>
    <def-list n="v_movement">
      <list-item v="arriver"/>
      <list-item v="venir"/>
      <list-item v="sortir"/>
      <list-item v="partir"/>
      <list-item v="apparaître"/>
    </def-list>

    <def-list n="adv_sens_det">
      <list-item v="pas"/>
      <list-item v="même pas"/>
      <list-item v="plus"/>
      <list-item v="moins"/>
      <list-item v="autant"/>
      <list-item v="davantage"/>
      <list-item v="beaucoup"/>
      <list-item v="point"/>
      <list-item v="goutte"/>
      <list-item v="aucunement"/>
      <list-item v="pas du tout"/>
      <list-item v="plus de tout"/>
      <list-item v="peu"/>
      <list-item v="guère"/>
      <list-item v="tellement"/>
    </def-list>
  </section-def-lists>

  <section-def-macros>
    <def-macro n="f_is_net" npar="1"> <!-- par1 = SV -->
      <choose>
        <when>
          <test>
            <or>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="conclure"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="dire"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="écrire"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="faire"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="lire"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="répondre"/></equal>
              <equal><clip pos="1" part="nbr"/><lit-tag v="pl"/></equal>
              <equal><clip pos="1" part="temps"/><lit-tag v="pii"/></equal>
            </or>
          </test>
          <let><var n="is_net"/><lit-tag v="yes"/></let>
        </when>
        <otherwise>
          <let><var n="is_net"/><lit-tag v="no"/></let>
        </otherwise>
      </choose>
    </def-macro>

    <def-macro n="generate_il" npar="1"> <!-- par1 = SV -->
      <choose>
        <when>
          <test>
            <equal><var n="is_net"/><lit-tag v="yes"/></equal>
          </test>
          <out>
            <chunk>
              <lit v="subj"/>
              <lit-tag v="prn.subj"/>
              <clip pos="1" part="pers"/>
              <lit-tag v="GD"/>
              <clip pos="1" part="nbr"/>
              <lit v="{^"/>
              <lit v="-prpers_net"/>
              <lit-tag v="prn.tn.3.4.5"/>
              <lit v="$}"/>
            </chunk>
          </out>
        </when>
        <otherwise>
          <out>
            <chunk>
              <lit v="subj"/>
              <lit-tag v="prn.subj"/>
              <clip pos="1" part="pers"/>
              <lit-tag v="GD"/>
              <clip pos="1" part="nbr"/>
              <lit v="{^"/>
              <lit v="-prpers"/>
              <lit-tag v="prn.tn.3.4.5"/>
              <lit v="$}"/>
            </chunk>
          </out>
        </otherwise>
      </choose>
    </def-macro>

    <def-macro n="generate_detdef1" npar="1"> <!-- par1 = SN -->
      <choose>
        <when>
          <test>
            <equal><clip pos="1" part="a_np"/><lit-tag v="np"/></equal>
          </test>
          <!-- pas de generacion -->
        </when>
        <when>
          <test>
            <or>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="d_n"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="d_a_n"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="d_n_a"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="num_n"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="num_a_n"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="num_n_a"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="a_n"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="a_n_a"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="adv_a_n"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="adv_a_n_a"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="a_a_n"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="a_a_n_a"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="braves gens"/></equal>
            </or>
          </test>
          <!-- pas de generacion -->
        </when>
        <when>
          <test>
            <or>
              <equal><clip pos="1" part="nbr"/><lit-tag v="sg"/></equal>
              <and>
                <equal><clip pos="1" part="nbr"/><lit-tag v="sp"/></equal>
                <equal><clip pos="1" part="sl_nbr"/><lit-tag v="sl_sg"/></equal>
              </and>
            </or>
          </test>
          <out>
            <chunk>
              <lit v="det"/>
              <lit-tag v="Det"/>
              <clip pos="1" part="gen"/>
              <clip pos="1" part="nbr"/>
              <lit v="{^"/>
              <lit v="le"/>
              <lit-tag v="det.def"/>
              <clip pos="1" part="gen"/>
              <lit-tag v="sg"/>
              <lit v="$}"/>
            </chunk>
            <b/>
          </out>
        </when>
        <otherwise>
          <out>
            <chunk>
              <lit v="det"/>
              <lit-tag v="Det"/>
              <clip pos="1" part="gen"/>
              <clip pos="1" part="nbr"/>
              <lit v="{^"/>
              <lit v="le"/>
              <lit-tag v="det.def.mf.pl"/>
              <lit v="$}"/>
            </chunk>
            <b/>
          </out>
        </otherwise>
      </choose>
    </def-macro>

    <def-macro n="f_bcond" npar="2"><!--Per mirar si el blanc conté o no format. Cal posar aquesta funció en les regles en què desaparegui alguna paraula, per tal de decidir si el blanc de la paraula eliminada s'ha d'eliminar o conservar. Si conté format cal conservar-la, si no en conté cal eliminar-la perquè no apareguin dos espais seguits. -->
      <choose>
        <when>
          <test>
            <not>
              <equal>
                <b pos="1"/>
                <lit v=" "/>
              </equal>
            </not>
          </test>
          <out>
            <b pos="1"/>
          </out>
        </when>
      </choose>
    </def-macro>
  </section-def-macros>

  <section-rules>
    <!-- RÈGLAS es_pot_gen_part -->

    <rule comment="RÈGLA: DET">
      <pattern>
        <pattern-item n="DET"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: SA">
      <pattern>
        <pattern-item n="SA"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
        </out>
        <choose>
          <when>
            <test>
              <and>
                <equal><clip pos="1" part="temps"/><lit-tag v="pp"/></equal>
                <or>
                  <equal><clip pos="1" part="a_part"/><lit-tag v="partitiu"/></equal>
                  <equal caseless="yes"><clip pos="1" part="lem"/><lit v="avoir"/></equal>
                  <equal caseless="yes"><clip pos="1" part="lem"/><lit v="falloir"/></equal>
                  <equal caseless="yes"><clip pos="1" part="lem"/><lit v="être"/></equal>
                </or>
              </and>
            </test>
            <let><var n="es_pot_gen_part"/><lit v="yes"/></let>
            <let><var n="es_pot_gen_part"/><lit v="no"/></let>
          </when>
          <otherwise>
            <let><var n="es_pot_gen_part"/><lit v="no"/></let>
          </otherwise>
        </choose>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: SV">
      <pattern>
        <pattern-item n="SV"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="whole"/>
          </chunk>
        </out>
        <choose>
          <when>
            <test>
              <or>
                <equal><clip pos="1" part="a_part"/><lit-tag v="partitiu"/></equal>
                <equal caseless="yes"><clip pos="1" part="lem"/><lit v="avoir"/></equal>
                <equal caseless="yes"><clip pos="1" part="lem"/><lit v="falloir"/></equal>
                <equal caseless="yes"><clip pos="1" part="lem"/><lit v="être"/></equal>
              </or>
            </test>
            <let><var n="es_pot_gen_part"/><lit v="yes"/></let>
            <let><var n="verb"/><clip pos="1" part="lem"/></let>
          </when>
          <otherwise>
            <let><var n="es_pot_gen_part"/><lit v="no"/></let>
            <let><var n="verb"/><lit v=""/></let>
          </otherwise>
        </choose>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: Num">
      <pattern>
        <pattern-item n="Num"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: PREP">
      <pattern>
        <pattern-item n="PREP"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: LPAR">
      <pattern>
        <pattern-item n="LPAR"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
        </out>
        <choose>
          <when>
            <test>
              <equal><clip pos="1" part="lem"/><lit v="("/></equal>
            </test>
            <let><var n="es_pot_gen_part"/><lit v="no"/></let>
          </when>
        </choose>
        <choose>
          <when>
            <test>
              <equal><clip pos="1" part="lem"/><lit v="«"/></equal>
            </test>
          </when>
          <otherwise>
            <let><var n="BOS"/><lit v="no"/></let>
          </otherwise>
        </choose>
      </action>
    </rule>

    <rule comment="RÈGLA: SAdv">
      <pattern>
        <pattern-item n="SAdv"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: tellement_guere_adv de (per empechar la generacion)">
      <pattern>
        <pattern-item n="tellement_guere_adv"/>
        <pattern-item n="PREP_de"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="whole"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="whole"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: SPron">
      <pattern>
        <pattern-item n="SPron"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: cnjcoo">
      <pattern>
        <pattern-item n="cnjcoo"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: cnjsub">
      <pattern>
        <pattern-item n="cnjsub"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="yes"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: cnjadv">
      <pattern>
        <pattern-item n="cnjadv"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="yes"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: rel">
      <pattern>
        <pattern-item n="rel"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
        </out>
