  <section-def-macros>
    <def-macro n="f_expression" npar="2"> <!-- par1 = SV, par2 = SN (n) -->
      <choose>
        <when>
          <test>
            <or>
              <equal caseless="yes"><clip pos="2" part="lem"/><lit v="lundi"/></equal>
              <equal caseless="yes"><clip pos="2" part="lem"/><lit v="mardi"/></equal>
              <equal caseless="yes"><clip pos="2" part="lem"/><lit v="mercredi"/></equal>
              <equal caseless="yes"><clip pos="2" part="lem"/><lit v="jeudi"/></equal>
              <equal caseless="yes"><clip pos="2" part="lem"/><lit v="vendredi"/></equal>
              <equal caseless="yes"><clip pos="2" part="lem"/><lit v="samedi"/></equal>
              <equal caseless="yes"><clip pos="2" part="lem"/><lit v="dimanche"/></equal>
              <and>
                <equal caseless="yes"><clip pos="1" part="lem"/><lit v="prendre"/></equal>
                <or>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="conscience"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="place"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="soin"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="femme"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="mari"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="époux"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="gendre"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="bru"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="contact"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="langue"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="exemple"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="connaissance"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="appui"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="congé"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="conseil"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="coutume"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="feu"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="figure"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="fin"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="forme"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="froid"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="garde"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="goût"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="note"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="parti"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="part"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="patience"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="prétexte"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="racine"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="refuge"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="acte"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="possession"/></equal> <!-- possessions -->
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="corps"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="date"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="effet"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="naissance"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="pied"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="position"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="tournure"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="commande"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="effet"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="garde"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="goût"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="peur"/></equal>
                </or>
              </and>
              <and>
                <equal caseless="yes"><clip pos="1" part="lem"/><lit v="avoir"/></equal>
                <or>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="affaire"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="avantage"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="besoin"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="cours"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="coutume de"/></equal>	<!-- xxxx -->
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="droit"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="égard"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="horreur"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="lieu"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="peur"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="froid"/></equal>
