                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="scandale"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="souche"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="visite"/></equal>
                </or>
              </and>
              <and>
