    </rule>

    <rule comment="RÈGLA: SENT IJ CM SN CM (pas de generacion del partitiu: probablement es un vocatiu)">
      <pattern>
        <pattern-item n="SENT"/>
        <pattern-item n="ij"/>
        <pattern-item n="CM"/>
        <pattern-item n="SN"/>
        <pattern-item n="CM"/>
