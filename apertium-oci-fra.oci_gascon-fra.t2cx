        </call-macro>
        <choose>
          <when>
            <test>
              <and>
                <equal caseless="yes"><clip pos="2" part="lem"/><lit v="être"/></equal>
                <equal><clip pos="2" part="nbr"/><lit-tag v="pl"/></equal>
                <equal><clip pos="3" part="nbr"/><lit-tag v="pl"/></equal>
              </and>
            </test>
            <call-macro n="generate_de"/>
            <call-macro n="generate_detdef1">
              <with-param pos="3"/>
            </call-macro>
          </when>
          <when>
            <test>
              <and>
                <not><equal><var n="is_expression"/><lit-tag v="yes"/></equal></not>
                <not>
                  <and>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="être"/></equal>
                    <or>
                      <equal><clip pos="2" part="nbr"/><lit-tag v="sg"/></equal>
                      <equal><clip pos="3" part="nbr"/><lit-tag v="sg"/></equal>
                    </or>
                  </and>
                </not>
              </and>
            </test>
            <call-macro n="generate_de"/>
          </when>
        </choose>
        <out>
          <chunk>
            <clip pos="3" part="lem"/>
            <clip pos="3" part="tags"/>
            <clip pos="3" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: ne_adv SPron_pro SV_partitiu SN: arrés ne'u balha pas d'aiga > personne ne lui donne d'eau">
      <pattern>
        <pattern-item n="ne_adv"/>
        <pattern-item n="SPron_pro"/>
        <pattern-item n="SV_partitiu"/>
        <pattern-item n="SN_n"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="lem"/>
            <clip pos="2" part="tags"/>
            <clip pos="2" part="chcontent"/>
          </chunk>
          <b pos="2"/>
          <chunk>
            <clip pos="3" part="lem"/>
            <clip pos="3" part="tags"/>
            <clip pos="3" part="chcontent"/>
          </chunk>
          <b pos="3"/>
        </out>
        <call-macro n="f_expression">
          <with-param pos="3"/>
          <with-param pos="4"/>
        </call-macro>
        <choose>
          <when>
            <test>
              <and>
                <not><equal><var n="is_expression"/><lit-tag v="yes"/></equal></not>
                <not>
                  <and>
                    <equal caseless="yes"><clip pos="3" part="lem"/><lit v="être"/></equal>
                    <or>
                      <equal><clip pos="3" part="nbr"/><lit-tag v="sg"/></equal>
                      <equal><clip pos="4" part="nbr"/><lit-tag v="sg"/></equal>
                    </or>
                  </and>
                </not>
              </and>
            </test>
            <call-macro n="generate_de"/>
          </when>
        </choose>
        <out>
          <chunk>
            <clip pos="4" part="lem"/>
            <clip pos="4" part="tags"/>
            <clip pos="4" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: ne_adv SPron_pro SPron_pro SV_partitiu SN: arrés ne'u ne balha pas d'aiga > personne ne lui en donne d'eau">
      <pattern>
        <pattern-item n="ne_adv"/>
        <pattern-item n="SPron_pro"/>
        <pattern-item n="SPron_pro"/>
        <pattern-item n="SV_partitiu"/>
        <pattern-item n="SN_n"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="lem"/>
            <clip pos="2" part="tags"/>
            <clip pos="2" part="chcontent"/>
          </chunk>
          <b pos="2"/>
          <chunk>
            <clip pos="3" part="lem"/>
            <clip pos="3" part="tags"/>
            <clip pos="3" part="chcontent"/>
          </chunk>
          <b pos="3"/>
          <chunk>
            <clip pos="4" part="lem"/>
            <clip pos="4" part="tags"/>
            <clip pos="4" part="chcontent"/>
          </chunk>
          <b pos="4"/>
        </out>
        <call-macro n="f_expression">
          <with-param pos="4"/>
          <with-param pos="5"/>
        </call-macro>
        <choose>
          <when>
            <test>
              <and>
                <not><equal><var n="is_expression"/><lit-tag v="yes"/></equal></not>
                <not>
                  <and>
                    <equal caseless="yes"><clip pos="4" part="lem"/><lit v="être"/></equal>
                    <or>
                      <equal><clip pos="4" part="nbr"/><lit-tag v="sg"/></equal>
                      <equal><clip pos="5" part="nbr"/><lit-tag v="sg"/></equal>
                    </or>
                  </and>
                </not>
              </and>
            </test>
            <call-macro n="generate_de"/>
          </when>
        </choose>
        <out>
          <chunk>
            <clip pos="5" part="lem"/>
            <clip pos="5" part="tags"/>
            <clip pos="5" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <!-- FIN RÈGLAS D'INCLUSION DE L'ARTICLE DEFINIT DEL PARTITIU -->
  </section-rules>
</interchunk>

