<?xml version="1.0" encoding="UTF-8"?>
<interchunk>
  <section-def-cats>
    <def-cat n="SN">
      <cat-item tags="SN"/>
      <cat-item tags="SN.*"/>
    </def-cat>
    <def-cat n="SN_pl">
      <cat-item tags="SN.*.pl"/>
      <cat-item tags="SN.*.pl.*"/>
    </def-cat>
    <def-cat n="SN_pl_sp">
      <cat-item tags="SN.*.pl"/>
      <cat-item tags="SN.*.sp"/>
      <cat-item tags="SN.*.pl.*"/>
      <cat-item tags="SN.*.sp.*"/>
    </def-cat>
    <def-cat n="SN_n">
      <cat-item lemma="n" tags="SN.*"/>
      <cat-item tags="SN.n.*"/>
      <cat-item lemma="a_n" tags="SN.*"/>
      <cat-item lemma="n_a" tags="SN.*"/>
    </def-cat>
    <def-cat n="SN_n_pl">
      <cat-item lemma="n" tags="SN.*.pl"/>
      <cat-item tags="SN.n.*.pl"/>
      <cat-item lemma="a_n" tags="SN.*.pl"/>
      <cat-item lemma="n_a" tags="SN.*.pl"/>
      <cat-item lemma="n_adv_a" tags="SN.*.pl"/>
      <cat-item lemma="n" tags="SN.*.pl.*"/>
      <cat-item tags="SN.n.*.pl.*"/>
      <cat-item lemma="a_n" tags="SN.*.pl.*"/>
      <cat-item lemma="n_a" tags="SN.*.pl.*"/>
      <cat-item lemma="n_adv_a" tags="SN.*.pl.*"/>
    </def-cat>
    <def-cat n="SA">
      <cat-item tags="SA"/>
      <cat-item tags="SA.*"/>
    </def-cat>
    <def-cat n="PP">
      <cat-item lemma="pp" tags="SA.*"/>
      <cat-item lemma="haverpp" tags="SA.*"/>
      <cat-item tags="SA.pp.*"/>
    </def-cat>
    <def-cat n="PP_partitiu">
      <cat-item lemma="pp" tags="SA.*.partitiu"/>
      <cat-item lemma="haverpp" tags="SA.*.partitiu"/>
      <cat-item tags="SA.pp.*.partitiu"/>
      <cat-item lemma="être" tags="SA.pp.*"/>
      <cat-item lemma="avoir" tags="SA.pp.*"/>
      <cat-item lemma="falloir" tags="SA.pp.*"/>
    </def-cat>
    <def-cat n="SPron_pro">
      <cat-item tags="SPron.pro"/>
      <cat-item tags="SPron.pro.*"/>
    </def-cat>
    <def-cat n="SPron_i">
      <cat-item lemma="y" tags="SPron.pro"/>
      <cat-item lemma="y" tags="SPron.pro.*"/>
    </def-cat>
    <def-cat n="SAdv">
