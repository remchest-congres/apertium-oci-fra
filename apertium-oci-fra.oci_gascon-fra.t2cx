                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="venjance"/></equal>
                </or>
              </and>
              <and>
                <equal caseless="yes"><clip pos="1" part="lem"/><lit v="poser"/></equal>
                <or>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="problème"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="question"/></equal>
                </or>
              </and>
              <and>
                <equal caseless="yes"><clip pos="1" part="lem"/><lit v="chercher"/></equal>
                <or>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="bagarre"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="dispute"/></equal>
                </or>
              </and>
              <and>
                <equal caseless="yes"><clip pos="1" part="lem"/><lit v="livrer"/></equal>
                <or>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="batalle"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="passage"/></equal>
                </or>
              </and>
              <and>
                <equal caseless="yes"><clip pos="1" part="lem"/><lit v="dire"/></equal>
                <or>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="oui"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="non"/></equal>
                </or>
              </and>
              <and>
                <equal caseless="yes"><clip pos="1" part="lem"/><lit v="laisser"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="côté"/></equal>
              </and>
              <and>
                <equal caseless="yes"><clip pos="1" part="lem"/><lit v="entendre"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="raison"/></equal>
              </and>
              <and>
                <equal caseless="yes"><clip pos="1" part="lem"/><lit v="perdre"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="connaissance"/></equal>
              </and>
            </or>
          </test>
          <let><var n="is_expression"/><lit v="yes"/></let>
        </when>
        <otherwise>
          <let><var n="is_expression"/><lit v="no"/></let>
        </otherwise>
      </choose>
    </def-macro>

    <def-macro n="generate_de" npar="0">
      <!-- ^de<PREP>{^de<pr>$}$ -->
      <out>
        <chunk>
          <lit v="de"/>
          <lit-tag v="PREP"/>
          <lit v="{^"/>
          <lit v="de"/>
          <lit-tag v="pr"/>
          <lit v="$}"/>
        </chunk>
        <b/>
      </out>
    </def-macro>

    <def-macro n="generate_De" npar="0">
        <!-- ^De<PREP>{^de<pr>$}$ -->
      <out>
        <chunk>
          <lit v="De"/>
          <lit-tag v="PREP"/>
          <lit v="{^"/>
          <lit v="de"/>
          <lit-tag v="pr"/>
          <lit v="$}"/>
        </chunk>
        <b/>
      </out>
    </def-macro>

    <def-macro n="generate_detdef1" npar="1"> <!-- par1 = SN -->
      <choose>
        <when>
          <test>
            <equal><clip pos="1" part="a_np"/><lit-tag v="np"/></equal>
          </test>
          <!-- pas de generacion -->
        </when>
        <when>
          <test>
            <or>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="d_n"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="d_a_n"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="d_n_a"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="num_n"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="num_a_n"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="num_n_a"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="a_n"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="a_n_a"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="adv_a_n"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="adv_a_n_a"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="a_a_n"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="a_a_n_a"/></equal>
              <equal caseless="yes"><clip pos="1" part="lem"/><lit v="braves gens"/></equal>
            </or>
          </test>
          <!-- pas de generacion -->
        </when>
        <when>
          <test>
            <or>
              <equal><clip pos="1" part="nbr"/><lit-tag v="sg"/></equal>
              <and>
                <equal><clip pos="1" part="nbr"/><lit-tag v="sp"/></equal>
                <equal><clip pos="1" part="sl_nbr"/><lit-tag v="sl_sg"/></equal>
              </and>
            </or>
          </test>
          <out>
            <chunk>
              <lit v="det"/>
              <lit-tag v="Det"/>
              <clip pos="1" part="gen"/>
              <clip pos="1" part="nbr"/>
              <lit v="{^"/>
              <lit v="le"/>
              <lit-tag v="det.def"/>
              <clip pos="1" part="gen"/>
              <lit-tag v="sg"/>
              <lit v="$}"/>
            </chunk>
            <b/>
          </out>
        </when>
        <otherwise>
          <out>
            <chunk>
              <lit v="det"/>
              <lit-tag v="Det"/>
              <clip pos="1" part="gen"/>
              <clip pos="1" part="nbr"/>
              <lit v="{^"/>
              <lit v="le"/>
              <lit-tag v="det.def.mf.pl"/>
              <lit v="$}"/>
            </chunk>
            <b/>
          </out>
        </otherwise>
      </choose>
    </def-macro>

    <def-macro n="generate_detdef2" npar="2"> <!-- par1 = SN, par2 = SAdv -->
      <choose>
        <when>
          <test>
            <or>
              <equal><clip pos="2" part="a_pron_pas_neg"/><lit-tag v="pas_neg"/></equal>
              <in caseless="yes"><clip pos="2" part="lem"/><list n="adv_sens_det"/></in>
            </or>
          </test>
          <!-- pas de generacion -->
        </when>
        <when>
          <test>
            <or>
              <equal><clip pos="1" part="nbr"/><lit-tag v="sg"/></equal>
              <and>
                <equal><clip pos="1" part="nbr"/><lit-tag v="sp"/></equal>
                <equal><clip pos="1" part="sl_nbr"/><lit-tag v="sl_sg"/></equal>
              </and>
            </or>
          </test>
          <out>
            <chunk>
              <lit v="det"/>
              <lit-tag v="Det"/>
              <clip pos="1" part="gen"/>
              <clip pos="1" part="nbr"/>
              <lit v="{^"/>
              <lit v="le"/>
              <lit-tag v="det.def"/>
              <clip pos="1" part="gen"/>
              <lit-tag v="sg"/>
              <lit v="$}"/>
            </chunk>
            <b/>
          </out>
        </when>
        <otherwise>
          <out>
            <chunk>
              <lit v="det"/>
              <lit-tag v="Det"/>
              <clip pos="1" part="gen"/>
              <clip pos="1" part="nbr"/>
              <lit v="{^"/>
              <lit v="le"/>
              <lit-tag v="det.def.mf.pl"/>
              <lit v="$}"/>
            </chunk>
            <b/>
          </out>
        </otherwise>
      </choose>
    </def-macro>

    <def-macro n="generate_detdef3" npar="3"> <!-- par1 = SN, par2 = SAdv, par3 = SAdv -->
      <choose>
        <when>
          <test>
            <or>
              <equal><clip pos="2" part="a_pron_pas_neg"/><lit-tag v="pas_neg"/></equal>
              <in caseless="yes"><clip pos="2" part="lem"/><list n="adv_sens_det"/></in>

              <equal><clip pos="3" part="a_pron_pas_neg"/><lit-tag v="pas_neg"/></equal>
              <in caseless="yes"><clip pos="3" part="lem"/><list n="adv_sens_det"/></in>
            </or>
          </test>
          <!-- pas de generacion -->
        </when>
        <when>
          <test>
            <or>
              <equal><clip pos="1" part="nbr"/><lit-tag v="sg"/></equal>
              <and>
                <equal><clip pos="1" part="nbr"/><lit-tag v="sp"/></equal>
                <equal><clip pos="1" part="sl_nbr"/><lit-tag v="sl_sg"/></equal>
              </and>
            </or>
          </test>
          <out>
            <chunk>
              <lit v="det"/>
              <lit-tag v="Det"/>
              <clip pos="1" part="gen"/>
              <clip pos="1" part="nbr"/>
              <lit v="{^"/>
              <lit v="le"/>
              <lit-tag v="det.def"/>
              <clip pos="1" part="gen"/>
              <lit-tag v="sg"/>
              <lit v="$}"/>
            </chunk>
            <b/>
          </out>
        </when>
        <otherwise>
          <out>
            <chunk>
              <lit v="det"/>
              <lit-tag v="Det"/>
              <clip pos="1" part="gen"/>
              <clip pos="1" part="nbr"/>
              <lit v="{^"/>
              <lit v="le"/>
              <lit-tag v="det.def.mf.pl"/>
              <lit v="$}"/>
            </chunk>
            <b/>
          </out>
        </otherwise>
      </choose>
    </def-macro>
  </section-def-macros>

  <section-rules>
    <!-- RÈGLAS es_pot_gen_part -->

    <rule comment="RÈGLA: SN_n">
      <pattern>
        <pattern-item n="SN_n"/>
      </pattern>
      <action>
        <choose>
          <when>
            <test>
              <and>
                <equal><var n="es_pot_gen_part"/><lit v="yes"/></equal>
                <equal><clip pos="1" part="nbr"/><lit-tag v="pl"/></equal>
              </and>
            </test>
            <choose>
              <when>
                <test>
                  <equal><var n="BOS"/><lit v="yes"/></equal>
                </test>
                <call-macro n="generate_De"/>
                <modify-case><clip pos="1" part="lem"/><lit v="aa"/></modify-case>
              </when>
              <otherwise>
                <call-macro n="generate_de"/>
              </otherwise>
            </choose>
            <call-macro n="generate_detdef1">
              <with-param pos="1"/>
            </call-macro>
          </when>
        </choose>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: SN">
      <pattern>
        <pattern-item n="SN"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: SN_n CM (per empachar la generacion del partitiu si possible vocatiu)">
      <pattern>
        <pattern-item n="SN_n"/>
        <pattern-item n="CM"/>
      </pattern>
      <action>
        <choose>
          <when>
            <test>
              <and>
                <equal><var n="es_pot_gen_part"/><lit v="yes"/></equal>
                <equal><clip pos="1" part="nbr"/><lit-tag v="pl"/></equal>
                <not><equal><var n="BOS"/><lit v="yes"/></equal></not>
              </and>
            </test>
            <call-macro n="generate_de"/>
            <out>  <!-- space problems -->
              <b/>
            </out>
            <call-macro n="generate_detdef1">
              <with-param pos="1"/>
            </call-macro>
          </when>
        </choose>
        <out>
          <chunk>
            <clip pos="1" part="whole"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="whole"/>
          </chunk>
        </out>
        <!-- <let><var n="es_pot_gen_part"/><lit v="no"/></let> -->
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: SN_n et_ou SN_n">
      <pattern>
        <pattern-item n="SN_n"/>
        <pattern-item n="et_ou"/>
        <pattern-item n="SN_n"/>
      </pattern>
      <action>
        <choose>
          <when>
            <test>
              <and>
                <equal><var n="es_pot_gen_part"/><lit v="yes"/></equal>
                <equal><clip pos="1" part="nbr"/><lit-tag v="pl"/></equal>
              </and>
            </test>
            <choose>
              <when>
                <test>
                  <equal><var n="BOS"/><lit v="yes"/></equal>
                </test>
                <call-macro n="generate_De"/>
                <modify-case><clip pos="1" part="lem"/><lit v="aa"/></modify-case>
              </when>
              <otherwise>
                <call-macro n="generate_de"/>
              </otherwise>
            </choose>
            <call-macro n="generate_detdef1">
              <with-param pos="1"/>
            </call-macro>
          </when>
        </choose>
        <out>
          <chunk>
            <clip pos="1" part="whole"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="whole"/>
          </chunk>
          <b pos="2"/>
        </out>
        <choose>
          <when>
            <test>
              <and>
                <equal><var n="es_pot_gen_part"/><lit v="yes"/></equal>
                <equal><clip pos="3" part="nbr"/><lit-tag v="pl"/></equal>
              </and>
            </test>
            <call-macro n="generate_de"/>
            <call-macro n="generate_detdef1">
              <with-param pos="3"/>
            </call-macro>
          </when>
        </choose>
        <out>
          <chunk>
            <clip pos="3" part="whole"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: SN_n et_ou SN_n CM (per empachar la generacion del partitiu si possible vocatiu: 'Amis et amies,')">
      <pattern>
        <pattern-item n="SN_n"/>
        <pattern-item n="et_ou"/>
        <pattern-item n="SN_n"/>
        <pattern-item n="CM"/>
      </pattern>
      <action>
        <choose>
          <when>
            <test>
              <and>
                <equal><var n="es_pot_gen_part"/><lit v="yes"/></equal>
                <equal><clip pos="1" part="nbr"/><lit-tag v="pl"/></equal>
                <not><equal><var n="BOS"/><lit v="yes"/></equal></not>
              </and>
            </test>
            <call-macro n="generate_de"/>
            <call-macro n="generate_detdef1">
              <with-param pos="1"/>
            </call-macro>
          </when>
        </choose>
        <out>
          <chunk>
            <clip pos="1" part="whole"/>
          </chunk>
          <b pos="1"/>
          <b/>  <!-- space problems -->
          <chunk>
            <clip pos="2" part="whole"/>
          </chunk>
          <b pos="2"/>
          <b/>  <!-- space problems -->
        </out>
        <choose>
          <when>
            <test>
              <and>
                <equal><var n="es_pot_gen_part"/><lit v="yes"/></equal>
                <equal><clip pos="3" part="nbr"/><lit-tag v="pl"/></equal>
                <not><equal><var n="BOS"/><lit v="yes"/></equal></not>
              </and>
            </test>
            <call-macro n="generate_de"/>
            <out>  <!-- space problems -->
              <b/>
            </out>
            <call-macro n="generate_detdef1">
              <with-param pos="3"/>
            </call-macro>
          </when>
        </choose>
        <out>
          <chunk>
            <clip pos="3" part="whole"/>
          </chunk>
          <b pos="3"/>
          <chunk>
            <clip pos="4" part="whole"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: QUEL SN (pas de generacion del partitiu)">
      <pattern>
        <pattern-item n="quel"/>
        <pattern-item n="SN"/>
