    <rule comment="RÈGLA: NE PAS SV_partitiu_inf PR_de SN (empacha la generacion de l'article determinat): non pas balhar d'aiga > ne pas donner d'eau">
      <pattern>
        <pattern-item n="ne_adv"/>
        <pattern-item n="pas_adv"/>
        <pattern-item n="SV_partitiu_inf"/>
        <pattern-item n="SN_n"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="whole"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="whole"/>
          </chunk>
          <b pos="2"/>
          <chunk>
            <clip pos="3" part="whole"/>
          </chunk>
          <b pos="3"/>
        </out>
        <call-macro n="f_expression">
          <with-param pos="3"/>
          <with-param pos="4"/>
        </call-macro>
        <choose>
          <when>
            <test>
              <and>
                <equal caseless="yes"><clip pos="3" part="lem"/><lit v="être"/></equal>
                <equal><clip pos="4" part="nbr"/><lit-tag v="pl"/></equal>
              </and>
            </test>
            <call-macro n="generate_de"/>
            <call-macro n="generate_detdef1">
              <with-param pos="4"/>
            </call-macro>
          </when>
          <when>
            <test>
              <and>
                <not><equal><var n="is_expression"/><lit v="yes"/></equal></not>
                <not>
                  <and>
                    <equal caseless="yes"><clip pos="3" part="lem"/><lit v="être"/></equal>
                    <equal><clip pos="4" part="nbr"/><lit-tag v="sg"/></equal>
                  </and>
                </not>
              </and>
            </test>
            <call-macro n="generate_de"/>
          </when>
        </choose>
        <out>
          <chunk>
            <clip pos="4" part="whole"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: NE PAS SAdv_SPron_pro SV_partitiu_inf PR_de SN (empacha la generacion de l'article determinat): non pas lo balhar d'aiga > ne pas lui donner d'eau">
