                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="chaud"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="soif"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="raison"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="pied"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="prise"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="recours"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="souvenance"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="tendance"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="tort"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="trait à"/></equal>	<!-- xxxx -->
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="vue"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="cure"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="envie"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="accès"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="besoin"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="hâte"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="part"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="prise"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="manière"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="façon"/></equal>
