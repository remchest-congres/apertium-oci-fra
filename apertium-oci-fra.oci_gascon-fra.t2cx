              <and>
                <equal caseless="yes"><clip pos="1" part="lem"/><lit v="porter"/></equal>
                <or>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="atteinte"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="secours"/></equal>
                </or>
              </and>
              <and>
                <equal caseless="yes"><clip pos="1" part="lem"/><lit v="tirer"/></equal>
