          </chunk>
          <b pos="2"/>
          <chunk>
            <clip pos="3" part="whole"/>
          </chunk>
          <b pos="3"/>
          <chunk>
            <clip pos="4" part="whole"/>
          </chunk>
          <b pos="4"/>
          <chunk>
            <clip pos="5" part="whole"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <!-- FIN RÈGLAS es_pot_gen_part -->

    <!-- RÈGLAS D'INCLUSION DE L'ARTICLE DEFINIT DEL PARTITIU -->

    <rule comment="RÈGLA: SV_partitiu SN: que vòli aiga > je veux de l'eau">
      <pattern>
        <pattern-item n="SV_partitiu"/>
        <pattern-item n="SN_n"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
        </out>
        <call-macro n="f_expression">
          <with-param pos="1"/>
          <with-param pos="2"/>
        </call-macro>
        <choose>
          <when>
            <test>
              <and>
                <equal caseless="yes"><clip pos="1" part="lem"/><lit v="être"/></equal>
                <equal><clip pos="1" part="nbr"/><lit-tag v="pl"/></equal>
                <equal><clip pos="2" part="nbr"/><lit-tag v="pl"/></equal>
              </and>
            </test>
            <call-macro n="generate_de"/>
            <call-macro n="generate_detdef1">
              <with-param pos="2"/>
            </call-macro>
          </when>
          <when>
            <test>
              <and>
                <not><equal><var n="is_expression"/><lit v="yes"/></equal></not>
                <not><equal caseless="yes"><clip pos="2" part="lem"/><lit v="monsieur"/></equal></not>
                <not><equal caseless="yes"><clip pos="2" part="lem"/><lit v="madame"/></equal></not>
                <not><equal caseless="yes"><clip pos="2" part="lem"/><lit v="mademoiselle"/></equal></not>
                <not>
                  <and>
                    <equal caseless="yes"><clip pos="1" part="lem"/><lit v="être"/></equal>
                    <or>
                      <equal><clip pos="1" part="nbr"/><lit-tag v="sg"/></equal>
                      <equal><clip pos="2" part="nbr"/><lit-tag v="sg"/></equal>
                    </or>
                  </and>
                </not>
              </and>
            </test>
            <call-macro n="generate_de"/>
            <call-macro n="generate_detdef1">
              <with-param pos="2"/>
            </call-macro>
          </when>
        </choose>
        <out>
          <chunk>
            <clip pos="2" part="lem"/>
            <clip pos="2" part="tags"/>
            <clip pos="2" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: SV_partitiu SN et_ou SN: que vòli aiga e vin > je veux de l'eau e du vin">
      <pattern>
        <pattern-item n="SV_partitiu"/>
        <pattern-item n="SN_n"/>
        <pattern-item n="et_ou"/>
        <pattern-item n="SN_n"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
        </out>
        <call-macro n="f_expression">
          <with-param pos="1"/>
          <with-param pos="2"/>
        </call-macro>
        <choose>
          <when>
            <test>
              <and>
                <equal caseless="yes"><clip pos="1" part="lem"/><lit v="être"/></equal>
                <equal><clip pos="1" part="nbr"/><lit-tag v="pl"/></equal>
                <equal><clip pos="2" part="nbr"/><lit-tag v="pl"/></equal>
              </and>
            </test>
            <call-macro n="generate_de"/>
            <call-macro n="generate_detdef1">
              <with-param pos="2"/>
            </call-macro>
            <out>
              <chunk>
                <clip pos="2" part="whole"/>
              </chunk>
              <b pos="2"/>
              <chunk>
                <clip pos="3" part="whole"/>
              </chunk>
              <b pos="3"/>
            </out>
            <call-macro n="generate_de"/>
            <call-macro n="generate_detdef1">
              <with-param pos="4"/>
            </call-macro>
            <out>
              <chunk>
                <clip pos="4" part="whole"/>
              </chunk>
            </out>
          </when>
          <when>
            <test>
              <and>
                <not><equal><var n="is_expression"/><lit v="yes"/></equal></not>
                <not><equal caseless="yes"><clip pos="2" part="lem"/><lit v="monsieur"/></equal></not>
                <not><equal caseless="yes"><clip pos="2" part="lem"/><lit v="madame"/></equal></not>
                <not><equal caseless="yes"><clip pos="2" part="lem"/><lit v="mademoiselle"/></equal></not>
                <not><equal caseless="yes"><clip pos="4" part="lem"/><lit v="monsieur"/></equal></not>
                <not><equal caseless="yes"><clip pos="4" part="lem"/><lit v="madame"/></equal></not>
                <not><equal caseless="yes"><clip pos="4" part="lem"/><lit v="mademoiselle"/></equal></not>
                <not>
                  <and>
                    <equal caseless="yes"><clip pos="1" part="lem"/><lit v="être"/></equal>
                    <or>
                      <equal><clip pos="1" part="nbr"/><lit-tag v="sg"/></equal>
                      <equal><clip pos="2" part="nbr"/><lit-tag v="sg"/></equal>
                    </or>
                  </and>
                </not>
              </and>
            </test>
            <call-macro n="generate_de"/>
            <call-macro n="generate_detdef1">
              <with-param pos="2"/>
            </call-macro>
            <out>
              <chunk>
                <clip pos="2" part="whole"/>
              </chunk>
              <b pos="2"/>
              <chunk>
                <clip pos="3" part="whole"/>
              </chunk>
              <b pos="3"/>
            </out>
            <call-macro n="generate_de"/>
            <call-macro n="generate_detdef1">
              <with-param pos="4"/>
            </call-macro>
            <out>
              <chunk>
                <clip pos="4" part="whole"/>
              </chunk>
            </out>
          </when>
          <otherwise>
            <out>
              <chunk>
                <clip pos="2" part="whole"/>
              </chunk>
              <b pos="2"/>
              <chunk>
                <clip pos="3" part="whole"/>
              </chunk>
              <b pos="3"/>
              <chunk>
                <clip pos="4" part="whole"/>
              </chunk>
            </out>
          </otherwise>
        </choose>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: arriver_venir_p3pl PR_de SN_pl: que venguèron espanhòus > vinrent des Espagnols">
