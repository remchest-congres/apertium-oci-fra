    <!-- RÈGLAS CNJADV_MEMESI + PRI/PII  > QUAN + FTI/CNI -->

    <rule comment="RÈGLA: CNJADV_MEMESI SV_pri_pii > QUAN SV_fti_cni: Même si vous avez > Quan auratz ; Même si vous aviez > Quan auretz">
      <pattern>
        <pattern-item n="CNJADV_MEMESI"/>
        <pattern-item n="SV_pri_pii"/>
      </pattern>
      <action>
        <choose>
          <when>
            <test>
              <equal><clip pos="2" part="temps"/><lit-tag v="pri"/></equal>
            </test>
            <let><clip pos="2" part="temps"/><lit-tag v="fti"/></let>
          </when>
          <when>
            <test>
              <equal><clip pos="2" part="temps"/><lit-tag v="pii"/></equal>
            </test>
            <let><clip pos="2" part="temps"/><lit-tag v="cni"/></let>
          </when>
        </choose>
        <call-macro n="escriure_quan"><with-param pos="1"/></call-macro>
        <out>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="lem"/>
            <clip pos="2" part="tags"/>
            <clip pos="2" part="chcontent"/>
          </chunk>
        </out>
      </action>
    </rule>

    <rule comment="RÈGLA: CNJADV_MEMESI SN_UNK SV_pri_pii > QUAN SN_UNK SV_fti_cni: Même si Jean a > Quan Jean aurà ; Même si Jean avait > Quan Jean auré">
