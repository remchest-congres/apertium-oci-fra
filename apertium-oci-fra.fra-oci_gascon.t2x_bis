            <clip pos="3" part="chcontent"/>
          </chunk>
        </out>
      </action>
    </rule>

    <rule comment="RÈGLA: CNJADV_MEMESI DET SN_UNK SV_pri_pii > QUAN DET SN_UNK SV_fti_cni: Même si la maison a > Quan l'ostal aurà ; Même si la maison avait > Quan l'ostal auré">
