      <e><i><w/><s n="adv"/><d/></i></e>
      <e><i><w/><s n="adv"/><d/><w/><s n="adv"/><d/></i></e>
      <e><i><w/><s n="adv"/><d/><w/><s n="adv"/><t/><d/></i></e>
    </pardef>
    <pardef n="verb">
      <e><i><w/><s n="vblex"/><t/><d/></i></e>
      <e><i><w/><s n="vbhaver"/><t/><d/></i></e>
      <e><i><w/><s n="vbser"/><t/><d/></i></e>
