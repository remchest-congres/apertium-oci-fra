    <def-cat n="SAdv_SPron_pro">
      <cat-item tags="SAdv"/>
      <cat-item tags="SAdv.pas_neg"/>
      <cat-item lemma="ne" tags="SAdv.enon"/>
      <cat-item lemma="donc" tags="cnjadv"/>
      <cat-item lemma="cependant" tags="cnjadv"/>
      <cat-item lemma="néanmoins" tags="cnjadv"/>
      <cat-item lemma="nonobstant" tags="cnjadv"/>
      <cat-item lemma="tout de même" tags="cnjadv"/>
      <cat-item lemma="toutefois" tags="cnjadv"/>
      <cat-item tags="SPron.pro"/>
      <cat-item tags="SPron.pro.*"/>
