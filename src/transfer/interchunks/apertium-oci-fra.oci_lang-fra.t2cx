      <cat-item tags="cnjcoo"/>
      <cat-item tags="rel"/>
      <cat-item tags="rel.*"/>
    </def-cat>
  </section-def-cats>

  <section-def-attrs>
    <def-attr n="chunk">
      <attr-item tags="SN"/>
      <attr-item tags="SV"/>
    </def-attr>

    <def-attr n="gen">
      <attr-item tags="m"/>
      <attr-item tags="f"/>
      <attr-item tags="mf"/>
      <attr-item tags="GD"/>
    </def-attr>

    <def-attr n="nbr">
      <attr-item tags="sg"/>
      <attr-item tags="pl"/>
      <attr-item tags="sp"/>
      <attr-item tags="ND"/>
    </def-attr>

    <def-attr n="sl_nbr">
      <attr-item tags="sl_sg"/>
      <attr-item tags="sl_pl"/>
      <attr-item tags="sl_sp"/>
    </def-attr>

    <def-attr n="a_np">
      <attr-item tags="np"/>
    </def-attr>

    <def-attr n="a_pron_pas_neg">
      <attr-item tags="pas_neg"/>
    </def-attr>
  </section-def-attrs>

  <section-def-vars>
    <def-var n="verb"/>
    <def-var n="is_expression"/>
    <def-var n="is_net"/>
    <def-var n="es_pot_gen_part" v="yes"/>
    <def-var n="BOS" v="yes"/>	<!-- begin of sentence -->
  </section-def-vars>

  <section-def-lists>
    <def-list n="adv_sens_det">
      <list-item v="pas"/>
      <list-item v="même pas"/>
      <list-item v="plus"/>
      <list-item v="moins"/>
      <list-item v="autant"/>
      <list-item v="davantage"/>
      <list-item v="beaucoup"/>
      <list-item v="point"/>
      <list-item v="goutte"/>
      <list-item v="aucunement"/>
      <list-item v="pas du tout"/>
      <list-item v="plus de tout"/>
      <list-item v="peu"/>
      <list-item v="guère"/>
      <list-item v="tellement"/>
    </def-list>
  </section-def-lists>

  <section-def-macros>
    <def-macro n="f_expression_de" npar="2"> <!-- par1 = SV, par2 = SN (n) -->
      <choose>
        <when>
          <test>
            <or>
              <and>
                <or>
                  <equal caseless="yes"><clip pos="1" part="lem"/><lit v="être"/></equal>
                  <equal caseless="yes"><clip pos="1" part="lem"/><lit v="mettre"/></equal>
                  <equal caseless="yes"><clip pos="1" part="lem"/><lit v="tomber"/></equal>
                </or>
                <equal caseless="yes"><clip pos="2" part="lem"/><lit v="accord"/></equal>
              </and>
              <and>
                <equal caseless="yes"><clip pos="1" part="lem"/><lit v="mettre"/></equal>
                <equal caseless="yes"><clip pos="2" part="lem"/><lit v="côté"/></equal>
              </and>
            </or>
          </test>
          <let><var n="is_expression"/><lit v="yes"/></let>
        </when>
        <otherwise>
          <let><var n="is_expression"/><lit v="no"/></let>
        </otherwise>
      </choose>
    </def-macro>

    <def-macro n="f_expression" npar="2"> <!-- par1 = SV, par2 = SN (n) -->
      <choose>
        <when>
          <test>
            <or>
              <equal caseless="yes"><clip pos="2" part="lem"/><lit v="lundi"/></equal>
