            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
        </out>
        <choose>
          <when>
            <test>
             <equal><var n="es_pot_gen_part"/><lit v="no"/></equal>
            </test>
          </when>
          <when>
            <test>
              <or>
                <and>
                  <equal caseless="yes"><var n="verb"/><lit v="perdre"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="valeur"/></equal>
                </and>
                <and>
                  <equal caseless="yes"><var n="verb"/><lit v="prendre"/></equal>
                  <equal caseless="yes"><clip pos="2" part="lem"/><lit v="retard"/></equal>
                </and>
                <and>
                  <equal caseless="yes"><var n="verb"/><lit v="jouer"/></equal>
                  <or>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="musique"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="piano"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="violon"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="alto"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="violoncelle"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="contrebasse"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="flûte"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="hautbois"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="clarinette"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="trompette"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="trombone"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="saxo"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="saxophone"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="harpe"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="guitare"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="basse"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="clavier"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="clavecin"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="clavicorde"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="organe"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="cornemuse"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="fifre"/></equal>
                    <equal caseless="yes"><clip pos="2" part="lem"/><lit v="n_a"/></equal>
                  </or>
                </and>
              </or>
            </test>
            <call-macro n="generate_detdef1">
              <with-param pos="2"/>
            </call-macro>
          </when>
        </choose>
        <out>
          <chunk>
            <clip pos="2" part="lem"/>
            <clip pos="2" part="tags"/>
            <clip pos="2" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: PR_de SN_pl">
      <pattern>
        <pattern-item n="PREP_de"/>
        <pattern-item n="SN_pl"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
        </out>
        <choose>
          <when>
            <test>
             <equal><var n="es_pot_gen_part"/><lit v="yes"/></equal>
            </test>
            <call-macro n="generate_detdef1">
              <with-param pos="2"/>
            </call-macro>
          </when>
        </choose>
        <out>
          <chunk>
            <clip pos="2" part="lem"/>
            <clip pos="2" part="tags"/>
            <clip pos="2" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: PR_de SN_pl CM (pas de canvi en 'es_pot_gen_part' per continuar generant, si cal, de partitius">
      <pattern>
        <pattern-item n="PREP_de"/>
        <pattern-item n="SN_pl"/>
        <pattern-item n="CM"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
        </out>
        <choose>
          <when>
            <test>
             <equal><var n="es_pot_gen_part"/><lit v="yes"/></equal>
            </test>
            <call-macro n="generate_detdef1">
              <with-param pos="2"/>
            </call-macro>
            <out>
              <b/>
            </out>
          </when>
        </choose>
        <out>
          <chunk>
            <clip pos="2" part="lem"/>
            <clip pos="2" part="tags"/>
            <clip pos="2" part="chcontent"/>
          </chunk>
          <chunk>
            <clip pos="3" part="whole"/>
          </chunk>
        </out>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <!-- règlas amb 'ne' (sens 'pas' en francés) -->

    <rule comment="RÈGLA: ne_adv SV_partitiu PR_de SN: degun vòl pas d'aiga > personne ne veut d'eau">
      <pattern>
        <pattern-item n="ne_adv"/>
        <pattern-item n="SV_partitiu"/>
        <pattern-item n="PREP_de"/>
        <pattern-item n="SN_UNK"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="lem"/>
            <clip pos="2" part="tags"/>
            <clip pos="2" part="chcontent"/>
          </chunk>
          <b pos="2"/>
          <chunk>
            <clip pos="3" part="lem"/>
            <clip pos="3" part="tags"/>
            <clip pos="3" part="chcontent"/>
          </chunk>
          <b pos="3"/>
          <chunk>
            <clip pos="4" part="lem"/>
            <clip pos="4" part="tags"/>
            <clip pos="4" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: ne_adv SPron_pro SV_partitiu PR_de SN: degun li balha pas d'aiga > personne ne lui donne d'eau">
      <pattern>
        <pattern-item n="ne_adv"/>
        <pattern-item n="SPron_pro"/>
        <pattern-item n="SV_partitiu"/>
        <pattern-item n="PREP_de"/>
        <pattern-item n="SN_UNK"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="lem"/>
            <clip pos="2" part="tags"/>
            <clip pos="2" part="chcontent"/>
          </chunk>
          <b pos="2"/>
          <chunk>
            <clip pos="3" part="lem"/>
            <clip pos="3" part="tags"/>
            <clip pos="3" part="chcontent"/>
          </chunk>
          <b pos="3"/>
          <chunk>
            <clip pos="4" part="lem"/>
            <clip pos="4" part="tags"/>
            <clip pos="4" part="chcontent"/>
          </chunk>
          <b pos="4"/>
          <chunk>
            <clip pos="5" part="lem"/>
            <clip pos="5" part="tags"/>
            <clip pos="5" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: ne_adv SPron_pro SPron_pro SV_partitiu PR_de SN: degun li'n balha pas d'aiga > personne ne lui en donne d'eau">
      <pattern>
        <pattern-item n="ne_adv"/>
        <pattern-item n="SPron_pro"/>
        <pattern-item n="SPron_pro"/>
        <pattern-item n="SV_partitiu"/>
        <pattern-item n="PREP_de"/>
        <pattern-item n="SN_UNK"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="lem"/>
            <clip pos="2" part="tags"/>
            <clip pos="2" part="chcontent"/>
          </chunk>
          <b pos="2"/>
          <chunk>
            <clip pos="3" part="lem"/>
            <clip pos="3" part="tags"/>
            <clip pos="3" part="chcontent"/>
          </chunk>
          <b pos="3"/>
          <chunk>
            <clip pos="4" part="lem"/>
            <clip pos="4" part="tags"/>
            <clip pos="4" part="chcontent"/>
          </chunk>
          <b pos="4"/>
          <chunk>
            <clip pos="5" part="lem"/>
            <clip pos="5" part="tags"/>
            <clip pos="5" part="chcontent"/>
          </chunk>
          <b pos="5"/>
          <chunk>
            <clip pos="6" part="lem"/>
            <clip pos="6" part="tags"/>
            <clip pos="6" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: CM_SENT PP PR_de SN: , compausat de cançons > , composé de chansons (règla per empachar la generacion del det.def)">
      <pattern>
        <pattern-item n="CM_SENT"/>
        <pattern-item n="PP_partitiu"/>
        <pattern-item n="PREP_de"/>
        <pattern-item n="SN_UNK"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="lem"/>
            <clip pos="2" part="tags"/>
            <clip pos="2" part="chcontent"/>
          </chunk>
          <b pos="2"/>
          <chunk>
            <clip pos="3" part="lem"/>
            <clip pos="3" part="tags"/>
            <clip pos="3" part="chcontent"/>
          </chunk>
          <b pos="3"/>
          <chunk>
            <clip pos="4" part="lem"/>
            <clip pos="4" part="tags"/>
            <clip pos="4" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: CM_SENT SAdv PP PR_de SN: , de còps compausat de cançons > , parfois composé de chansons (règla per empachar la generacion del det.def)">
      <pattern>
        <pattern-item n="CM_SENT"/>
        <pattern-item n="SAdv"/>
        <pattern-item n="PP_partitiu"/>
        <pattern-item n="PREP_de"/>
        <pattern-item n="SN_UNK"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="lem"/>
            <clip pos="2" part="tags"/>
            <clip pos="2" part="chcontent"/>
          </chunk>
          <b pos="2"/>
          <chunk>
            <clip pos="3" part="lem"/>
            <clip pos="3" part="tags"/>
            <clip pos="3" part="chcontent"/>
          </chunk>
          <b pos="3"/>
          <chunk>
            <clip pos="4" part="lem"/>
            <clip pos="4" part="tags"/>
            <clip pos="4" part="chcontent"/>
          </chunk>
          <b pos="4"/>
          <chunk>
            <clip pos="5" part="lem"/>
            <clip pos="5" part="tags"/>
            <clip pos="5" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: SN PP PR_de SN: disc compausat de cançons > disque composé de chansons (règla per empachar la generacion del det.def)">
      <pattern>
        <pattern-item n="SN"/>
        <pattern-item n="PP_partitiu"/>
        <pattern-item n="PREP_de"/>
        <pattern-item n="SN_UNK"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="lem"/>
            <clip pos="2" part="tags"/>
            <clip pos="2" part="chcontent"/>
          </chunk>
          <b pos="2"/>
          <chunk>
            <clip pos="3" part="lem"/>
            <clip pos="3" part="tags"/>
            <clip pos="3" part="chcontent"/>
          </chunk>
          <b pos="3"/>
          <chunk>
            <clip pos="4" part="lem"/>
            <clip pos="4" part="tags"/>
            <clip pos="4" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="es_pot_gen_part"/><lit v="no"/></let>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <!-- FIN RÈGLAS D'INCLUSION DE L'ARTICLE DEFINIT DEL PARTITIU -->

    <!-- RÈGLAS çò -->

    <rule comment="RÈGLA: çò SV_vblex_p3pl PR_de SNpl: çò dison de dròlles > disent des enfants">
      <pattern>
        <pattern-item n="cela"/>
        <pattern-item n="SV_vblex_p3pl"/>
        <pattern-item n="PREP_de"/>
        <pattern-item n="SNpl_UNK"/>
      </pattern>
      <action>
        <call-macro n="f_bcond"><with-param pos="1"/><with-param pos="2"/></call-macro>
        <out>
          <chunk>
            <get-case-from pos="1">
              <clip pos="2" part="lem"/>
            </get-case-from>
            <clip pos="2" part="tags"/>
            <clip pos="2" part="chcontent"/>
          </chunk>
          <b pos="2"/>
          <chunk>
            <clip pos="3" part="lem"/>
            <clip pos="3" part="tags"/>
            <clip pos="3" part="chcontent"/>
          </chunk>
          <b pos="3"/>
        </out>
        <call-macro n="generate_detdef1">
          <with-param pos="4"/>
        </call-macro>
        <out>
          <chunk>
            <clip pos="4" part="lem"/>
            <clip pos="4" part="tags"/>
            <clip pos="4" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="BOS"/><lit v="no"/></let>
      </action>
    </rule>

    <!-- FIN RÈGLAS çò -->
  </section-rules>
</interchunk>

