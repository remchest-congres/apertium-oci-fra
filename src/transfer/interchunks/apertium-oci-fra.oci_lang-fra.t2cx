    <def-cat n="ne_adv">
      <cat-item lemma="ne" tags="SAdv"/>
    </def-cat>
    <def-cat n="pas_adv">
      <cat-item lemma="pas" tags="SAdv"/>
    </def-cat>
    <def-cat n="SV">
