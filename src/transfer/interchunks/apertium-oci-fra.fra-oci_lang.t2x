    <rule comment="RÈGLA: SV_haver PP_partitiu PR_de DET_def SN E_O PR_de DET_def SN: J'ai bu de l'eau e du vin > Ai begut d'aiga e de vin">
      <pattern>
        <pattern-item n="SV_haver"/>
        <pattern-item n="PP_partitiu"/>
        <pattern-item n="PREP_de"/>
        <pattern-item n="DET_def"/>
        <pattern-item n="SN_UNK"/>
