  <section-def-attrs>
    <def-attr n="chunk">
      <attr-item tags="SN"/>
      <attr-item tags="SV"/>
    </def-attr>
  </section-def-attrs>

  <section-def-vars>
    <def-var n="finfrasa" v="yes"/>
  </section-def-vars>

  <section-rules>
    <rule comment="RÈGLA: arriver_venir_p3pl SN_personne_pl (aquela règla es per empachar la generacion prn.tn)">
      <pattern>
        <pattern-item n="arriver_venir_p3pl"/>
        <pattern-item n="SN_personne_pl"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="lem"/>
            <clip pos="2" part="tags"/>
            <clip pos="2" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="finfrasa"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: apparaîssent SN_pl (aquela règla es per empachar la generacion prn.tn)">
      <pattern>
        <pattern-item n="apparaitre_p3pl"/>
        <pattern-item n="SN_pl"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="lem"/>
            <clip pos="2" part="tags"/>
            <clip pos="2" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="finfrasa"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: arriver_venir_p3pl De SN_personne_pl (aquela règla es per empachar la generacion prn.tn)">
      <pattern>
        <pattern-item n="arriver_venir_p3pl"/>
		    <pattern-item n="SAdv"/>
        <pattern-item n="SN_personne_pl"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="lem"/>
            <clip pos="2" part="tags"/>
            <clip pos="2" part="chcontent"/>
          </chunk>
          <b pos="2"/>
          <chunk>
            <clip pos="3" part="lem"/>
            <clip pos="3" part="tags"/>
            <clip pos="3" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="finfrasa"/><lit v="no"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: apparaîssent SAdv SN_pl (aquela règla es per empachar la generacion prn.tn)">
      <pattern>
        <pattern-item n="apparaitre_p3pl"/>
        <pattern-item n="SAdv"/>
        <pattern-item n="SN_pl"/>
      </pattern>
      <action>
        <out>
          <chunk>
            <clip pos="1" part="lem"/>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="lem"/>
            <clip pos="2" part="tags"/>
            <clip pos="2" part="chcontent"/>
          </chunk>
          <b pos="2"/>
          <chunk>
            <clip pos="3" part="lem"/>
            <clip pos="3" part="tags"/>
            <clip pos="3" part="chcontent"/>
          </chunk>
        </out>
        <let><var n="finfrasa"/><lit v="no"/></let>
      </action>
    </rule>
  </section-rules>
</interchunk>

