  <rules>
    <!-- **************** ADJ **************** -->

    <!-- brave >> gentil, bon/gros -->
    <rule weight="0.8">
      <match lemma="brave" tags="adj.*"><select lemma="gentil"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="brave" tags="adj.*"><select lemma="gros"/></match>
      <match tags="n.*"/>
    </rule>
    <rule weight="1.2">
      <match lemma="brave" tags="adj.*"><select lemma="gentil"/></match>
      <or>
        <seq n="personas"/>
      </or>
    </rule>

    <!-- vertadièr >> vrai, véritable -->
    <!-- vertadèr >> vrai, véritable -->
    <rule weight="0.8">
      <match lemma="vertadèr" tags="adj.*"><select lemma="vrai"/></match>
    </rule>

    <!-- sadol/hart >> repu, saoûl -->
    <rule weight="0.8">
      <match lemma="hart" tags="adj.*"><select lemma="repu"/></match>
    </rule>


    <!-- **************** PREADV **************** -->

    <!-- tant >> si, aussi -->
    <rule weight="0.8">
      <match lemma="tant" tags="preadv"><select lemma="si"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="tant" tags="preadv"><select lemma="aussi"/></match>
      <match tags="vblex.pp.*"/>
      <match lemma="de" tags="pr"/>
    </rule>
    <rule weight="1.0">
      <match lemma="tant" tags="preadv"><select lemma="aussi"/></match>
      <or>
        <match tags="adj.*"/>
        <match tags="vblex.pp.*"/>
        <match tags="adv"/>
      </or>
      <match lemma="coma" tags="cnjadv"><select lemma="que"/></match>
    </rule>
    <rule weight="1.2">
      <match lemma="tant" tags="preadv"><select lemma="aussi"/></match>
      <or>
        <match tags="adj.*"/>
        <match tags="vblex.pp.*"/>
        <match tags="adv"/>
      </or>
      <match tags="cnjcoo"/>
      <or>
        <match tags="adj.*"/>
        <match tags="adv"/>
      </or>
      <match lemma="coma" tags="cnjadv"><select lemma="que"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="tant" tags="preadv"><select lemma="aussi"/></match>
      <or>
        <match tags="adj.*"/>
        <match tags="vblex.pp.*"/>
      </or>
      <match tags="n.*"/>
    </rule>
    <rule weight="1.0">
      <or>
        <match tags="vbser.*"/>
        <match lemma="semblar" tags="vblex.*"/>
        <match lemma="paréisser" tags="vblex.*"/>
        <match lemma="pareisher" tags="vblex.*"/>
        <match lemma="paréisher" tags="vblex.*"/>
        <match lemma="devenir" tags="vblex.*"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="adv.*"/>
      </repeat>
      <match lemma="tant" tags="preadv"><select lemma="si"/></match>
      <or>
        <match tags="adj.*"/>
        <match tags="vblex.pp.*"/>
        <match tags="adv"/>
      </or>
      <match lemma="que" tags="cnjsub"/>
    </rule>

    <!-- autant >> si, aussi -->
    <rule weight="0.8">
      <match lemma="autant" tags="preadv"><select lemma="si"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="autant" tags="preadv"><select lemma="aussi"/></match>
      <match tags="vblex.pp.*"/>
      <match lemma="de" tags="pr"/>
    </rule>
    <rule weight="1.0">
      <match lemma="autant" tags="preadv"><select lemma="aussi"/></match>
      <or>
        <match tags="adj.*"/>
        <match tags="vblex.pp.*"/>
        <match tags="adv"/>
      </or>
      <match lemma="com" tags="cnjadv"><select lemma="que"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="autant" tags="preadv"><select lemma="aussi"/></match>
      <or>
        <match tags="adj.*"/>
        <match tags="vblex.pp.*"/>
        <match tags="adv"/>
      </or>
      <match tags="cnjcoo"/>
      <or>
        <match tags="adj.*"/>
        <match tags="vblex.pp.*"/>
        <match tags="adv"/>
      </or>
      <match lemma="com" tags="cnjadv"><select lemma="que"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="autant" tags="preadv"><select lemma="aussi"/></match>
      <or>
        <match tags="adj.*"/>
        <match tags="vblex.pp.*"/>
      </or>
      <match tags="n.*"/>
    </rule>
    <rule weight="1.0">
      <or>
        <match tags="vbser.*"/>
        <match lemma="semblar" tags="vblex.*"/>
        <match lemma="paréisser" tags="vblex.*"/>
        <match lemma="pareisher" tags="vblex.*"/>
        <match lemma="paréisher" tags="vblex.*"/>
        <match lemma="devenir" tags="vblex.*"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="adv.*"/>
      </repeat>
      <match lemma="autant" tags="preadv"><select lemma="si"/></match>
      <or>
        <match tags="adj.*"/>
        <match tags="vblex.pp.*"/>
        <match tags="adv"/>
      </or>
      <match lemma="que" tags="cnjsub"/>
    </rule>

    <!-- **************** ADV **************** -->

    <!-- GASCON: IDEM PRECEDENT -->
    <!-- autant >> autant, tant -->
    <rule weight="0.8">
      <match lemma="autant" tags="adv"><select lemma="autant"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="autant" tags="adv"><select lemma="tant"/></match>
      <or>
        <match tags="prn.*"/>
        <match tags="n.acr.*"/>
        <match tags="np.*"/>
      </or>
      <match lemma="com" tags="adv"/>
    </rule>
    <rule weight="1.0">
      <match lemma="autant" tags="adv"><select lemma="tant"/></match>
      <match tags="det.*"/>
      <repeat from="0" upto="2">
        <match tags="adj.*"/>
      </repeat>
      <or>
        <match tags="n.*"/>
        <match tags="np.*"/>
      </or>
      <match lemma="com" tags="adv"/>
    </rule>
    <rule weight="1.0">
      <match lemma="autant" tags="adv"><select lemma="tant"/></match>
      <match tags="det.*"/>
      <or>
        <match tags="n.*"/>
        <match tags="np.*"/>
      </or>
      <repeat from="0" upto="3">
        <match tags="adj.*"/>
      </repeat>
      <match lemma="com" tags="adv"/>
    </rule>
    <rule weight="1.0">
      <match lemma="autant" tags="adv"><select lemma="tant"/></match>
      <match tags="det.*"/>
      <match tags="preadv"/>
      <match tags="adj.*"/>
      <match tags="n.*"/>
      <match lemma="com" tags="adv"/>
    </rule>
    <rule weight="1.0">
      <match lemma="autant" tags="adv"><select lemma="tant"/></match>
      <match tags="det.*"/>
      <match tags="n.*"/>
      <match tags="preadv"/>
      <match tags="adj.*"/>
      <repeat from="0" upto="2">
        <match tags="adj.*"/>
      </repeat>
      <match lemma="com" tags="adv"/>
    </rule>

    <!-- premuda >> hésitation, pression -->
    <rule weight="0.8">
      <match lemma="premuda" tags="n.*"><select lemma="hésitation"/></match>
    </rule>

    <!-- batent >> battant, volet -->
    <rule weight="0.8">
      <match lemma="batent" tags="n.*"><select lemma="volet"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="batent" tags="n.*"><select lemma="volet"/></match>
      <or>
        <match lemma="economic" tags="adj.*"/>
        <match lemma="politic" tags="adj.*"/>
        <match lemma="social" tags="adj.*"/>
        <match lemma="cultural" tags="adj.*"/>
        <match lemma="sindical" tags="adj.*"/>
        <match lemma="administratiu" tags="adj.*"/>
        <match lemma="diplomatic" tags="adj.*"/>
        <match lemma="militar" tags="adj.*"/>
        <match lemma="militari" tags="adj.*"/>
        <match lemma="religiós" tags="adj.*"/>
        <match lemma="judicial" tags="adj.*"/>
        <match lemma="penal" tags="adj.*"/>
      </or>
    </rule>

    <!-- sòu >> sou, argent, sol, salaire -->
    <rule weight="0.8">
      <match lemma="sòu" tags="n.*"><select lemma="sol"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="sòu" tags="n.m.pl"><select lemma="argent"/></match>
    </rule>
    <rule weight="1.2">
      <or><match tags="num"/><match tags="num.*"/></or>
      <match lemma="sòu" tags="n.*"><select lemma="sou"/></match>
    </rule>
    <rule weight="1.2">
      <match lemma="un" tags="det.ind.*"/>
      <match lemma="sòu" tags="n.*"><select lemma="sou"/></match>
    </rule>
    <rule weight="1.2">
      <match lemma="sòu" tags="n.*"><select lemma="sou"/></match>
      <match lemma="per" tags="pr"></match>
      <match lemma="sòu" tags="n.*"><select lemma="sou"/></match>
    </rule>

    <!-- mairia >> mairie, marraine -->
    <rule weight="0.8">
      <match lemma="mairia" tags="n.*"><select lemma="mairie"/></match>
    </rule>
    <rule weight="1.0">
      <match tags="det.pos.*"/>
      <match lemma="mairia" tags="n.*"><select lemma="mairie"/></match>
    </rule>

    <!-- òsca >> entaille, course -->
    <rule weight="0.8">
      <match lemma="òsca" tags="n.*"><select lemma="entaille"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="har" tags="vblex.*"/>
        <match lemma="hèr" tags="vblex.*"/>
        <match lemma="far" tags="vblex.*"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <or>
        <match tags="det.def.*"/>
        <match tags="det.pos.*"/>
      </or>
      <match lemma="òsca" tags="n.f.sg"><select lemma="course"/></match>
    </rule>

    <!-- part >> part, partie -->
    <rule weight="0.8">
      <match lemma="part" tags="n.*"><select lemma="part"/></match>
    </rule>
    <rule weight="1.0">
      <match tags="det.ind.*"/>
      <match lemma="part" tags="n.*"><select lemma="partie"/></match>
      <match lemma="de" tags="pr"/>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="far" tags="vblex.*"/>
        <match lemma="har" tags="vblex.*"/>
        <match lemma="hèr" tags="vblex.*"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="part" tags="n.*"><select lemma="partie"/></match>
    </rule>
    <rule weight="1.2">
      <or>
        <match lemma="far" tags="vblex.*"/>
        <match lemma="har" tags="vblex.*"/>
        <match lemma="hèr" tags="vblex.*"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="part" tags="n.*"><select lemma="part"/></match>
      <match lemma="a" tags="pr"/>
    </rule>
    <rule weight="1.2">
      <or>
        <match lemma="me" tags="prn.pro.*"/>
        <match lemma="te" tags="prn.pro.*"/>
        <match lemma="li" tags="prn.pro.*"/>
        <match lemma="nos" tags="prn.pro.*"/>
        <match lemma="mos" tags="prn.pro.*"/>
        <match lemma="vos" tags="prn.pro.*"/>
        <match lemma="lor" tags="prn.pro.*"/>
        <match lemma="ac" tags="prn.pro.*"/>
        <match lemma="lo" tags="prn.pro.*"/>
      </or>
      <or>
        <match lemma="far" tags="vblex.*"/>
        <match lemma="har" tags="vblex.*"/>
        <match lemma="hèr" tags="vblex.*"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="part" tags="n.*"><select lemma="part"/></match>
    </rule>

    <!-- barde >> barde, argile -->
    <rule weight="0.8">
      <match lemma="barde" tags="n.*"><select lemma="barde"/></match>
    </rule>

    <!-- rondalejaire >> rôdeur, randonneur -->
    <rule weight="0.8">
      <match lemma="rondalejaire" tags="n.*"><select lemma="rôdeur"/></match>
    </rule>

    <!-- casa >> maison, case -->
    <rule weight="0.8">
      <match lemma="casa" tags="n.*"><select lemma="case"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="a" tags="pr"/>
        <match lemma="per" tags="pr"/>
        <match lemma="dens" tags="pr"/>
        <match lemma="hens" tags="pr"/>
        <match lemma="davant" tags="pr"/>
        <match lemma="devant" tags="pr"/>
        <match lemma="tà" tags="pr"/>
        <match lemma="entà" tags="pr"/>
        <match lemma="enta" tags="pr"/>
        <match lemma="delà" tags="pr"/>
        <match lemma="delà de" tags="pr"/>
        <match lemma="au delà de" tags="pr"/>
        <match lemma="enlà de" tags="pr"/>
        <match lemma="ençà de" tags="pr"/>
        <match lemma="en deçà de" tags="pr"/>
      </or>
      <repeat from="0" upto="3">
        <or>
          <match tags="det.*"/>
          <match tags="adj.*"/>
          <match tags="preadv"/>
        </or>
      </repeat>
      <match lemma="casa" tags="n.*"><select lemma="maison"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="de" tags="pr"/>
      <match lemma="casa" tags="n.*"><select lemma="maison"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="de" tags="pr"/>
      <repeat from="0" upto="3">
        <or>
          <match tags="det.*"/>
          <match tags="adj.*"/>
          <match tags="preadv"/>
        </or>
      </repeat>
      <match lemma="casa" tags="n.*"><select lemma="maison"/></match>
      <or>
        <match lemma="enlà" tags="adv"/>
        <match lemma="estar" tags="vbser.ger"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match lemma="casa" tags="n.*"><select lemma="maison"/></match>
      <match tags="adj.pos.*"/>
    </rule>
    <rule weight="1.0">
      <match lemma="casa" tags="n.*"><select lemma="maison"/></match>
      <match lemma="de" tags="pr"/>
    </rule>
    <rule weight="1.2">
      <match lemma="casa" tags="n.*"><select lemma="case"/></match>
      <match lemma="de" tags="pr"/>
      <or>
        <match lemma="partença" tags="n.*"/>
        <match lemma="sortida" tags="n.*"/>
        <match lemma="arribada" tags="n.*"/>
      </or>
    </rule>

    <!-- traca >> traque/sorte -->
    <rule weight="0.8">
      <match lemma="traca" tags="n.*"><select lemma="traque"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="de" tags="pr"/>
      <match lemma="tot" tags="adj.*"/>
      <match lemma="traca" tags="n.*"><select lemma="sorte"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="un" tags="det.*"/>
        <match tags="det.dem.*"/>
      </or>
      <match lemma="traca" tags="n.*"><select lemma="sorte"/></match>
      <match lemma="de" tags="pr"/>
    </rule>
    <rule weight="1.0">
      <match tags="det.*"/>
      <match lemma="traca" tags="n.*"><select lemma="sorte"/></match>
      <match lemma="de" tags="pr"/>
      <repeat from="0" upto="3">
        <or>
          <match tags="adv"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <match tags="n.*"/>
      <repeat from="0" upto="3">
        <or>
          <match tags="adv"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <or>
          <match lemma="qui" tags="rel.*"/>
          <match lemma="que" tags="rel.*"/>
      </or>
    </rule>

    <!-- halha >> feu, crête, faille -->
    <rule weight="0.8">
      <match lemma="halha" tags="n.*"><select lemma="feu"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="halha" tags="n.*"><select lemma="faille"/></match>
      <repeat from="0" upto="3">
        <or>
          <match tags="*"/>
          <match tags=""/>
        </or>
      </repeat>
      <or>
        <match lemma="hasan" tags="n.*"/>
        <match lemma="gal" tags="n.*"/>
        <match lemma="pol" tags="n.*"/>
        <match lemma="poth" tags="n.*"/>
        <match lemma="galh" tags="n.*"/>
        <match lemma="veguèir" tags="n.*"/>
        <match lemma="pèrro" tags="n.*"/>
        <match lemma="pavés" tags="n.*"/>
      </or>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="hasan" tags="n.*"/>
        <match lemma="gal" tags="n.*"/>
        <match lemma="pol" tags="n.*"/>
        <match lemma="poth" tags="n.*"/>
        <match lemma="galh" tags="n.*"/>
        <match lemma="veguèir" tags="n.*"/>
        <match lemma="pèrro" tags="n.*"/>
        <match lemma="pavés" tags="n.*"/>
      </or>
      <repeat from="0" upto="3">
        <or>
          <match tags="*"/>
          <match tags=""/>
        </or>
      </repeat>
      <match lemma="halha" tags="n.*"><select lemma="faille"/></match>
    </rule>

    <!-- darr(i)èr >> dernier, derrière -->
    <rule weight="0.8">
      <match lemma="darrèr" tags="n.*"><select lemma="derrière"/></match>
    </rule>

    <!-- hèita >> événement, acte -->
    <rule weight="0.8">
      <match lemma="hèita" tags="n.*"><select lemma="événement"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="hèita" tags="n.*"><select lemma="acte"/></match>
      <match tags="num.*"/>
    </rule>

    <!-- lana >> laine, lande -->
    <rule weight="0.8">
        <match lemma="lana" tags="n.*"><select lemma="laine"/></match>
    </rule>
    <rule weight="1.0">
        <or>
            <seq n="pr_lieu"/>
            <match lemma="traversar" tags="vblex.*"/>
        </or>
        <match tags="det.def.*"/>
      <repeat from="0" upto="3">
          <or>
            <match tags="adv"/>
            <match tags="preadv"/>
            <match tags="adj.*"/>
          </or>
      </repeat>
        <match lemma="lana" tags="n.*"><select lemma="lande"/></match>
    </rule>
    <rule weight="1.0">
        <match lemma="lana" tags="n.f.pl"><select lemma="lande"/></match>
    </rule>
    <rule weight="1.0">
        <match lemma="lana" tags="n.*"><select lemma="lande"/></match>
        <match lemma="de" tags="pr"/>
        <or>
              <match tags="np.*"/>
              <match tags=""/>
        </or>
    </rule>

    <!-- lira >> lire, lyre -->
    <rule weight="0.8">
        <match lemma="lira" tags="n.*"><select lemma="lire"/></match>
    </rule>

    <!-- ostaleria >> hôtel, hôtellerie -->
    <rule weight="0.8">
        <match lemma="ostaleria" tags="n.*"><select lemma="hôtel"/></match>
    </rule>
    <rule weight="1.0">
        <or>
            <match lemma="domeni" tags="n.*"/>
            <match lemma="sector" tags="n.*"/>
            <match lemma="maine" tags="n.*"/>
            <match lemma="bac" tags="n.*"/>
            <match lemma="BTS" tags="n.*"/>
            <match lemma="diplòme" tags="n.*"/>
            <match lemma="estudi" tags="n.*"/>
            <match lemma="mestièr" tags="n.*"/>
            <match lemma="tribalh" tags="n.*"/>
            <match lemma="trabalh" tags="n.*"/>
            <match lemma="empleg" tags="n.*"/>
            <match lemma="trabalhar" tags="n.*"/>
            <match lemma="tribalhar" tags="n.*"/>
            <match lemma="restauracion" tags="n.*"/>
            <match lemma="activitat" tags="n.*"/>
            <match lemma="licéncia" tags="n.*"/>
        </or>
        <repeat from="0" upto="3">
            <or>
              <match tags=""/>
              <match tags="*"/>
            </or>
        </repeat>
        <match lemma="ostaleria" tags="n.*"><select lemma="hôtellerie"/></match>
    </rule>

    <!-- rondalejaire >> randonneur, rôdeur -->
    <rule weight="0.8">
        <match lemma="rondalejaire" tags="n.*"><select lemma="rôdeur"/></match>
    </rule>

    <!-- som >> sommet, sommeil -->
    <rule weight="0.8">
        <match lemma="som" tags="n.*"><select lemma="sommet"/></match>
    </rule>
    <rule weight="1.0">
        <match lemma="som" tags="n.*"><select lemma="sommeil"/></match>
        <match lemma="som" tags="n.*"/>
    </rule>
    <rule weight="1.0">
        <match lemma="som" tags="n.*"/>
        <match lemma="som" tags="n.*"><select lemma="sommeil"/></match>
    </rule>
  </rules>
</lrx>

