  <rules>
    <!-- lo >> le, lui, en -->
    <rule weight="0.8">
      <match lemma="lo" tags="prn.pro.*"><select lemma="le"/></match>
    </rule>

    <rule weight="1.0">
      <match lemma="lo" tags="prn.pro.*.sg"><select lemma="lui"/></match>
      <match lemma="ac" tags="prn.pro.*"/>
    </rule>
    <rule weight="1.0">
      <match lemma="lo" tags="prn.pro.*.pl"><select lemma="leur"/></match>
      <match lemma="ac" tags="prn.pro.*"/>
    </rule>

    <rule weight="1.0">
      <match lemma="lo" tags="prn.pro.*.sg"><select lemma="lui"/></match>
      <match tags="vblex.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <repeat from="0" upto="3">
        <or>
          <match tags="predet.*"/>
          <match tags="det.*"/>
          <match tags="num"/>
          <match tags="num.*"/>
          <match tags="preadv"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <match tags="n.*"/>
    </rule>
    <rule weight="1.0">
      <match lemma="lo" tags="prn.pro.*.pl"><select lemma="leur"/></match>
      <match tags="vblex.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <repeat from="0" upto="3">
        <or>
          <match tags="predet.*"/>
          <match tags="det.*"/>
          <match tags="num"/>
          <match tags="num.*"/>
          <match tags="preadv"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <match tags="n.*"/>
    </rule>
    <rule weight="1.0">
      <match lemma="lo" tags="prn.pro.*.sg"><select lemma="lui"/></match>
      <match tags="vblex.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <or>
        <match tags="prn.tn.*"/>
        <match tags="num.*"/>
        <match tags="num"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match lemma="lo" tags="prn.pro.*.pl"><select lemma="leur"/></match>
      <match tags="vblex.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <or>
        <match tags="prn.tn.*"/>
        <match tags="num.*"/>
        <match tags="num"/>
      </or>
    </rule>

    <rule weight="1.0">
      <match lemma="lo" tags="prn.pro.*.sg"><select lemma="lui"/></match>
      <match tags="vbhaver.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match tags="*.pp.*"/>
      <repeat from="0" upto="4">
        <or>
          <match tags="predet.*"/>
          <match tags="det.*"/>
          <match tags="num"/>
          <match tags="num.*"/>
          <match tags="preadv"/>
          <match tags="adj.*"/>
          <match tags="adv"/>
        </or>
      </repeat>
      <match tags="n.*"/>
    </rule>
    <rule weight="1.0">
      <match lemma="lo" tags="prn.pro.*.pl"><select lemma="leur"/></match>
      <match tags="vbhaver.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match tags="*.pp.*"/>
      <repeat from="0" upto="4">
        <or>
          <match tags="predet.*"/>
          <match tags="det.*"/>
          <match tags="num"/>
          <match tags="num.*"/>
          <match tags="preadv"/>
          <match tags="adj.*"/>
          <match tags="adv"/>
