<?xml version="1.0" encoding="UTF-8"?>
<lrx>
  <def-macros>
    <!-- entà >> à, pour, vers, de, [remove] -->
    <!-- tà >> à, pour, vers, de, [remove] -->
    <!-- enta >> à, pour, vers, de, [remove] -->
    <def-macro n="enta_et_sim" npar="5">
      <rule weight="0.6">
        <match plemma="1" tags="pr"><select plemma="2"/></match>
      </rule>

      <rule weight="0.8">
        <match plemma="1" tags="pr"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="pr"><select plemma="4"/></match>
        <or>
          <match lemma="dehòra" tags="adv"/>
          <match lemma="endehòra" tags="adv"/>
          <match lemma="dehòra" tags="n.*"/>
          <match lemma="dens" tags="adv"/>
          <match lemma="deguens" tags="adv"/>
          <match lemma="dehens" tags="n.*"/>
          <match lemma="endehens" tags="n.*"/>
          <match lemma="deguens" tags="n.*"/>
          <match lemma="on" tags="adv.*"/>
          <match lemma="on" tags="rel.*"/>
          <match lemma="ont" tags="adv.*"/>
          <match lemma="ont" tags="rel.*"/>
        </or>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="pr"><select plemma="2"/></match>
        <repeat from="0" upto="1">
          <match tags="det.def.*"/>
        </repeat>
        <or>
          <match tags="np.top.*"/>
          <match tags="" case="Aa"/>
        </or>
      </rule>
      <rule weight="2.2">
        <or>
          <match lemma="partir" tags="vblex.*"/>
          <match lemma="tornar# partir" tags="vblex.*"/>
        </or>
        <repeat from="0" upto="2">
          <match tags="adv"/>
        </repeat>
        <match plemma="1" tags="pr"><select plemma="3"/></match>
        <repeat from="0" upto="1">
          <match tags="det.def.*"/>
        </repeat>
        <or>
          <match tags="np.top.*"/>
          <match tags="" case="Aa"/>
        </or>
      </rule>
      <rule weight="1.0">
        <or>
          <match lemma="anar" tags="vblex.*"/>
          <match lemma="viatjar" tags="vblex.*"/>
          <match lemma="bracar" tags="vblex.*"/>
          <match lemma="sortir" tags="vblex.*"/>
          <match lemma="gésser" tags="vblex.*"/>
          <match lemma="arribar" tags="vblex.*"/>
          <match lemma="tornar" tags="vblex.*"/>
          <match lemma="partir" tags="vblex.*"/>
          <match lemma="tornar# partir" tags="vblex.*"/>
        </or>
        <repeat from="0" upto="2">
          <match tags="adv"/>
        </repeat>
        <match plemma="1" tags="pr"><select plemma="2"/></match>
      </rule>
      <rule weight="2.2">
        <or>
          <match lemma="anar" tags="vblex.*"/>
          <match lemma="viatjar" tags="vblex.*"/>
          <match lemma="bracar" tags="vblex.*"/>
          <match lemma="sortir" tags="vblex.*"/>
          <match lemma="gésser" tags="vblex.*"/>
          <match lemma="arribar" tags="vblex.*"/>
          <match lemma="tornar" tags="vblex.*"/>
          <match lemma="partir" tags="vblex.*"/>
          <match lemma="tornar# partir" tags="vblex.*"/>
        </or>
        <repeat from="0" upto="2">
          <match tags="adv"/>
        </repeat>
        <match plemma="1" tags="pr"><remove tags="pr"/></match>
        <repeat from="0" upto="2">
          <match tags="prn.pro.*"/>
        </repeat>
        <match tags="*.inf"/>
      </rule>
      <rule weight="1.0">
        <or>
          <match lemma="amanejar" tags="vblex.*"/>
          <match lemma="pressar" tags="vblex.*"/>
          <match lemma="empressar" tags="vblex.*"/>
          <match lemma="esdeburar" tags="vblex.*"/>
          <match lemma="encuentar" tags="vblex.*"/>
          <match lemma="afanar" tags="vblex.*"/>
          <match lemma="ahanar" tags="vblex.*"/>
          <match lemma="cochar" tags="vblex.*"/>
        </or>
        <repeat from="0" upto="1">
          <match tags="prn.enc.*"/>
        </repeat>
        <repeat from="0" upto="2">
          <match tags="adv"/>
        </repeat>
        <match plemma="1" tags="pr"><select plemma="5"/></match>
        <repeat from="0" upto="1">
          <match tags="adv"/>
        </repeat>
        <repeat from="0" upto="2">
          <match tags="prn.pro.*"/>
        </repeat>
        <match tags="*.inf"/>
      </rule>
    </def-macro>
  </def-macros>

