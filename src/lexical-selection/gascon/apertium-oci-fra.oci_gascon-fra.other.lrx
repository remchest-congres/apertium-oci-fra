      </repeat>
      <or>
        <seq n="verbs_intrans"/>
        <match lemma="dire" tags="vblex.*"/>
        <match lemma="díser" tags="vblex.*"/>
        <match lemma="respondre" tags="vblex.*"/>
        <match lemma="repóner" tags="vblex.*"/>
        <match lemma="atier" tags="vblex.*"/>
        <match lemma="replicar" tags="vblex.*"/>
        <match lemma="respotir" tags="vblex.*"/>
        <match lemma="rebecar" tags="vblex.*"/>
        <match lemma="explicar" tags="vblex.*"/>
        <match lemma="contar" tags="vblex.*"/>
        <match lemma="anonciar" tags="vblex.*"/>
        <match lemma="semblar" tags="vblex.*"/>
        <match lemma="paréisser" tags="vblex.*"/>
        <match lemma="paréisher" tags="vblex.*"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match lemma="lo" tags="prn.pro.*.pl"><select lemma="leur"/></match>
      <or>
        <match tags="vbhaver.*"/>
        <match tags="vbmod.*"/>
        <match lemma="far" tags="vblex.*"/>
        <match lemma="har" tags="vblex.*"/>
        <match lemma="hèr" tags="vblex.*"/>
        <match lemma="voler" tags="vblex.*"/>
        <match lemma="saber" tags="vblex.*"/>
        <match lemma="sàber" tags="vblex.*"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <or>
        <seq n="verbs_intrans"/>
        <match lemma="dire" tags="vblex.*"/>
        <match lemma="díser" tags="vblex.*"/>
        <match lemma="respondre" tags="vblex.*"/>
        <match lemma="repóner" tags="vblex.*"/>
        <match lemma="atier" tags="vblex.*"/>
        <match lemma="replicar" tags="vblex.*"/>
        <match lemma="respotir" tags="vblex.*"/>
        <match lemma="rebecar" tags="vblex.*"/>
        <match lemma="explicar" tags="vblex.*"/>
        <match lemma="contar" tags="vblex.*"/>
        <match lemma="anonciar" tags="vblex.*"/>
        <match lemma="semblar" tags="vblex.*"/>
        <match lemma="paréisser" tags="vblex.*"/>
        <match lemma="paréisher" tags="vblex.*"/>
      </or>
    </rule>

    <rule weight="1.0">
      <match lemma="lo" tags="prn.pro.*.sg"><select lemma="en"/></match>
      <repeat from="0" upto="1">
        <match tags="prn.pro.*"/>
      </repeat>
      <or>
        <match lemma="tirar# deu puisheu" tags="vblex.*"/>
        <match lemma="tirar# deu puishèu" tags="vblex.*"/>
        <match lemma="tirar# deu poishiu" tags="vblex.*"/>
        <match lemma="tirar# deth puisheu" tags="vblex.*"/>
        <match lemma="tirar# deth puishèu" tags="vblex.*"/>
        <match lemma="tirar# deth poishiu" tags="vblex.*"/>
        <match lemma="tirar# deu torn" tags="vblex.*"/>
        <match lemma="tirar# deth torn" tags="vblex.*"/>
        <match lemma="tirar# de l'empach" tags="vblex.*"/>
        <match lemma="tirar# de la halha" tags="vblex.*"/>
      </or>
    </rule>

    <!-- lo (prn.enc) >> le, lui -->
    <rule weight="0.8">
      <match lemma="lo" tags="prn.enc.*"><select lemma="le"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="lo" tags="prn.enc.*.sg"><select lemma="lui"/></match>
      <match lemma="ac" tags="prn.enc.*"/>
    </rule>
    <rule weight="1.0">
      <match lemma="lo" tags="prn.enc.*.pl"><select lemma="leur"/></match>
      <match lemma="ac" tags="prn.enc.*"/>
    </rule>
    <rule weight="1.0">
      <match lemma="lo" tags="prn.enc.*.sg"><select lemma="lui"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match tags="cnjsub"/>
    </rule>
    <rule weight="1.0">
      <match lemma="lo" tags="prn.enc.*.pl"><select lemma="leur"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match tags="cnjsub"/>
    </rule>
    <rule weight="1.0">
      <match lemma="lo" tags="prn.enc.*.sg"><select lemma="lui"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match tags="det.*"/>
    </rule>
    <rule weight="1.0">
      <match lemma="lo" tags="prn.enc.*.pl"><select lemma="leur"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match tags="det.*"/>
    </rule>

    <rule weight="1.0">
      <or>
        <seq n="verbs_intrans"/>
        <match tags="vbser.*"/>
        <match lemma="dire" tags="vblex.*"/>
        <match lemma="díser" tags="vblex.*"/>
        <match lemma="respondre" tags="vblex.*"/>
        <match lemma="repóner" tags="vblex.*"/>
        <match lemma="atier" tags="vblex.*"/>
        <match lemma="replicar" tags="vblex.*"/>
        <match lemma="respotir" tags="vblex.*"/>
        <match lemma="rebecar" tags="vblex.*"/>
        <match lemma="explicar" tags="vblex.*"/>
        <match lemma="contar" tags="vblex.*"/>
        <match lemma="anonciar" tags="vblex.*"/>
        <match lemma="semblar" tags="vblex.*"/>
        <match lemma="paréisser" tags="vblex.*"/>
        <match lemma="paréisher" tags="vblex.*"/>
      </or>
      <match lemma="lo" tags="prn.enc.*.sg"><select lemma="lui"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <seq n="verbs_intrans"/>
        <match tags="vbser.*"/>
        <match lemma="dire" tags="vblex.*"/>
        <match lemma="díser" tags="vblex.*"/>
        <match lemma="respondre" tags="vblex.*"/>
        <match lemma="repóner" tags="vblex.*"/>
        <match lemma="atier" tags="vblex.*"/>
        <match lemma="replicar" tags="vblex.*"/>
        <match lemma="respotir" tags="vblex.*"/>
        <match lemma="rebecar" tags="vblex.*"/>
        <match lemma="explicar" tags="vblex.*"/>
        <match lemma="contar" tags="vblex.*"/>
        <match lemma="anonciar" tags="vblex.*"/>
        <match lemma="semblar" tags="vblex.*"/>
        <match lemma="paréisser" tags="vblex.*"/>
        <match lemma="paréisher" tags="vblex.*"/>
      </or>
      <match lemma="lo" tags="prn.enc.*.pl"><select lemma="leur"/></match>
    </rule>

    <rule weight="1.2">
      <seq n="venir"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match tags="vblex.inf"/>
      <match lemma="lo" tags="prn.enc.*.sg"><select lemma="le"/></match>
    </rule>

    <rule weight="1.4">
      <seq n="venir"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <or>
        <seq n="verbs_intrans"/>
        <match tags="vbser.inf"/>
        <match lemma="dire" tags="vblex.inf"/>
        <match lemma="díser" tags="vblex.inf"/>
        <match lemma="respondre" tags="vblex.inf"/>
        <match lemma="repóner" tags="vblex.inf"/>
        <match lemma="atier" tags="vblex.inf"/>
        <match lemma="replicar" tags="vblex.inf"/>
        <match lemma="respotir" tags="vblex.inf"/>
        <match lemma="rebecar" tags="vblex.inf"/>
        <match lemma="explicar" tags="vblex.inf"/>
        <match lemma="contar" tags="vblex.inf"/>
        <match lemma="anonciar" tags="vblex.inf"/>
        <match lemma="semblar" tags="vblex.inf"/>
        <match lemma="paréisser" tags="vblex.inf"/>
        <match lemma="paréisher" tags="vblex.inf"/>
      </or>
      <match lemma="lo" tags="prn.enc.*.sg"><select lemma="lui"/></match>
    </rule>

    <rule weight="1.0">
      <or>
        <match tags="vbhaver.*"/>
        <match tags="vbmod.*"/>
        <match lemma="far" tags="vblex.*"/>
        <match lemma="har" tags="vblex.*"/>
        <match lemma="hèr" tags="vblex.*"/>
        <match lemma="voler" tags="vblex.*"/>
        <match lemma="saber" tags="vblex.*"/>
        <match lemma="sàber" tags="vblex.*"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <or>
        <seq n="verbs_intrans"/>
        <match lemma="dire" tags="vblex.*"/>
        <match lemma="díser" tags="vblex.*"/>
        <match lemma="respondre" tags="vblex.*"/>
        <match lemma="repóner" tags="vblex.*"/>
        <match lemma="atier" tags="vblex.*"/>
        <match lemma="replicar" tags="vblex.*"/>
        <match lemma="respotir" tags="vblex.*"/>
        <match lemma="rebecar" tags="vblex.*"/>
        <match lemma="explicar" tags="vblex.*"/>
        <match lemma="contar" tags="vblex.*"/>
        <match lemma="anonciar" tags="vblex.*"/>
        <match lemma="semblar" tags="vblex.*"/>
        <match lemma="paréisser" tags="vblex.*"/>
        <match lemma="paréisher" tags="vblex.*"/>
      </or>
      <match lemma="lo" tags="prn.enc.*.sg"><select lemma="lui"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match tags="vbhaver.*"/>
        <match tags="vbmod.*"/>
        <match lemma="far" tags="vblex.*"/>
        <match lemma="har" tags="vblex.*"/>
        <match lemma="hèr" tags="vblex.*"/>
        <match lemma="voler" tags="vblex.*"/>
        <match lemma="saber" tags="vblex.*"/>
        <match lemma="sàber" tags="vblex.*"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <or>
        <seq n="verbs_intrans"/>
        <match lemma="dire" tags="vblex.*"/>
        <match lemma="díser" tags="vblex.*"/>
        <match lemma="respondre" tags="vblex.*"/>
        <match lemma="repóner" tags="vblex.*"/>
        <match lemma="atier" tags="vblex.*"/>
        <match lemma="replicar" tags="vblex.*"/>
        <match lemma="respotir" tags="vblex.*"/>
        <match lemma="rebecar" tags="vblex.*"/>
        <match lemma="explicar" tags="vblex.*"/>
        <match lemma="contar" tags="vblex.*"/>
        <match lemma="anonciar" tags="vblex.*"/>
        <match lemma="semblar" tags="vblex.*"/>
        <match lemma="paréisser" tags="vblex.*"/>
        <match lemma="paréisher" tags="vblex.*"/>
      </or>
      <match lemma="lo" tags="prn.enc.*.pl"><select lemma="leur"/></match>
    </rule>

    <!-- aquel/aqueth >> celui, celui-là -->
    <rule weight="0.8">
      <match lemma="aqueth" tags="prn.*"><select lemma="celui-là"/></match>
    </rule>

    <rule weight="0.8">
      <match lemma="aqueth" tags="prn.*"><select lemma="celui"/></match>
      <or>
          <match tags="rel.*"/>
          <match tags="rel"/>
          <match tags="pr"/>
          <match lemma="mai" tags="adv"/>
          <match lemma="mei" tags="adv"/>
          <match lemma="mas" tags="adv"/>
          <match lemma="mes" tags="adv"/>
          <match lemma="pus" tags="adv"/>
          <match lemma="mens" tags="adv"/>
          <match lemma="mensh" tags="adv"/>
          <match lemma="tan" tags="adv"/>
          <match lemma="tant" tags="adv"/>
          <match lemma="autan" tags="adv"/>
          <match lemma="autant" tags="adv"/>
      </or>
    </rule>

    <!-- **************** PREP **************** -->

    <!-- entà >> à, pour, vers, de, [remove] -->
    <!-- tà >> à, pour, vers, de, [remove] -->
    <!-- enta >> à, pour, vers, de, [remove] -->
    <macro n="enta_et_sim"><with-param v="entà"/><with-param v="à"/><with-param v="pour"/><with-param v="vers"/><with-param v="de"/></macro>
    <macro n="enta_et_sim"><with-param v="tà"/><with-param v="à"/><with-param v="pour"/><with-param v="vers"/><with-param v="de"/></macro>
    <macro n="enta_et_sim"><with-param v="enta"/><with-param v="à"/><with-param v="pour"/><with-param v="vers"/><with-param v="de"/></macro>

    <!-- tà çò de >> chez, en ce qui concerne -->
    <rule weight="0.8">
      <match lemma="tà çò de" tags="pr"><select lemma="en ce qui concerne"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="tà çò de" tags="pr"><select lemma="chez"/></match>
      <repeat from="0" upto="1">
        <match tags="det.def.*"/>
      </repeat>
      <or>
        <match lemma="mossur" tags="n.*"/>
        <match lemma="monsur" tags="n.*"/>
        <match lemma="sénher" tags="n.*"/>
        <match lemma="monsen" tags="n.*"/>
        <match lemma="mossenh" tags="n.*"/>
        <match lemma="dauna" tags="n.*"/>
        <match lemma="dama" tags="n.*"/>
        <match lemma="dòna" tags="n.*"/>
        <match tags="np.cog.*"/>
        <match tags="np.ant.*"/>
        <match tags=""/>
      </or>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="anar" tags="vblex.*"/>
        <match lemma="seguir" tags="vblex.*"/>
        <match lemma="segre" tags="vblex.*"/>
        <match lemma="partir" tags="vblex.*"/>
        <match lemma="tornar# partir" tags="vblex.*"/>
        <match lemma="passar" tags="vblex.*"/>
        <match lemma="dirigir" tags="vblex.*"/>
        <match lemma="venir" tags="vblex.*"/>
        <match lemma="vénguer" tags="vblex.*"/>
        <match lemma="viéner" tags="vblex.*"/>
        <match lemma="vier" tags="vblex.*"/>
      </or>
      <repeat from="0" upto="3">
        <or>
          <match tags="adv"/>
          <match tags="preadv"/>
        </or>
      </repeat>
      <repeat from="0" upto="2">
          <match lemma="en" tags="pr"/>
          <match tags="n.*"/>
      </repeat>
      <match lemma="tà çò de" tags="pr"><select lemma="chez"/></match>
    </rule>
  </rules>
</lrx>

