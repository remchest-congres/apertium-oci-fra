        <match lemma="papeterie" tags="n.*"/>
        <match lemma="jouet" tags="n.*"/>
        <match lemma="jeu" tags="n.*"/>
        <match lemma="bagage" tags="n.*"/>
        <match lemma="rentrée" tags="n.*"/>
        <match lemma="chauffage" tags="n.*"/>
        <match lemma="vaisselle" tags="n.*"/>
        <match lemma="cuisine" tags="n.*"/>
        <match lemma="salle de bain" tags="n.*"/>
        <match lemma="produit" tags="n.*"/>
        <match lemma="boisson" tags="n.*"/>
        <match lemma="literie" tags="n.*"/>
        <match lemma="chambre" tags="n.*"/>
        <match lemma="voiture" tags="n.*"/>
        <match lemma="beauté" tags="n.*"/>
        <match lemma="animalerie" tags="n.*"/>
        <match lemma="maquillage" tags="n.*"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match lemma="rayon" tags="n.*"><select lemma="taulèr"/></match>
      <or>
        <match lemma="gros" tags="adj.*"/>
        <match lemma="petit" tags="adj.*"/>
      </or>
      <match lemma="électroménager" tags="n.*"/>
    </rule>
    <rule weight="1.0">
      <match lemma="rayon" tags="n.*"><select lemma="taulèr"/></match>
      <match lemma="de" tags="pr"/>
      <match lemma="le" tags="det.*"/>
      <or>
        <match lemma="gros" tags="adj.*"/>
        <match lemma="petit" tags="adj.*"/>
      </or>
      <match lemma="électroménager" tags="n.*"/>
    </rule>

    <!-- travail >> tribalh, travaux >> òbras -->
    <rule weight="0.8">
      <match lemma="travail" tags="n.*"><select lemma="tribalh"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="travail" tags="n.m.pl"><select lemma="òbra"/></match>
    </rule>
    <rule weight="1.2">
      <match lemma="travail" tags="n.*"><select lemma="tribalh"/></match>
      <or>
        <match lemma="forcé" tags="adj.*"/>
        <match lemma="humain" tags="adj.*"/>
        <match lemma="collectif" tags="adj.*"/>
        <match lemma="agricole" tags="adj.*"/>
        <match lemma="utile" tags="adj.*"/>
        <match lemma="inutile" tags="adj.*"/>
      </or>
    </rule>
    <rule weight="1.2">
      <match lemma="travail" tags="n.*"><select lemma="tribalh"/></match>
      <match lemma="de" tags="pr"/>
      <or>
        <match lemma="Hercule" tags="np.*"/>
        <match lemma="aiguille" tags="n.*"/>
        <match lemma="saison" tags="n.*"/>
        <match lemma="recherche" tags="n.*"/>
      </or>
    </rule>
    <rule weight="1.2">
      <match lemma="travail" tags="n.*"><select lemma="tribalh"/></match>
      <match lemma="de" tags="pr"/>
      <match lemma="le" tags="det.*"/>
      <or>
        <match lemma="terre" tags="n.*"/>
        <match lemma="champ" tags="n.*"/>
        <match lemma="jardin" tags="n.*"/>
      </or>
    </rule>

    <!-- performance >> proes(s)a, performances >> résultats -->
    <rule weight="0.8">
      <match lemma="performance" tags="n.*"><select lemma="proessa"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="performance" tags="n.f.pl"><select lemma="resultat"/></match>
    </rule>
  </rules>
</lrx>

