      <match lemma="dixième" tags="adj.*"/>
      <match lemma="dernier" tags="adj.*"/>
      <match lemma="1er" tags="adj.*"/>
      <match lemma="2nd" tags="adj.*"/>
      <match lemma="3ème" tags="adj.*"/>
    </or></def-seq>
  </def-seqs>

  <rules>
    <!-- **************** ADV **************** -->

    <!-- de là-bas >> d'acerà estant, d'acerà enlà, d'acerà ençà -->
    <rule weight="0.8">
      <match lemma="de là-bas" tags="adv"><select lemma="d'acerà estant"/></match>
    </rule>

    <!-- lourdement >> pesugament, de bèth tròç -->
    <rule weight="0.8">
      <match lemma="lourdement" tags="adv"><select lemma="pesugament"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="tromper" tags="vblex.*"/>
      <match lemma="lourdement" tags="adv"><select lemma="de bèth tròç"/></match>
    </rule>

    <!-- grossièrement >> grossièrament, gròssament, de bèth tròç -->
    <rule weight="0.8">
      <match lemma="grossièrement" tags="adv"><select lemma="grossièrament"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="tromper" tags="vblex.*"/>
      <match lemma="grossièrement" tags="adv"><select lemma="de bèth tròç"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="grossièrement" tags="adv"><select lemma="gròssament"/></match>
      <or>
        <match tags="num"/>
        <match tags="num.*"/>
        <match tags="adj.*"/>
      </or>
    </rule>

    <!-- il fait beau >> que hè beròi temps, hè beròi temps -->
    <rule weight="0.8">
      <match lemma="il fait beau" tags="adv"><select lemma="que hè beròi temps"/></match>
    </rule>
    <rule weight="1.0">
      <match tags="cnjsub"/>
      <repeat from="0" upto="3">
        <or>
          <match tags="adv"/>
          <match tags="cm"/>
        </or>
      </repeat>
      <match lemma="il fait beau" tags="adv"><select lemma="hè beròi temps"/></match>
    </rule>

    <!-- chez moi, toi, lui... après préposition -->
    <rule weight="0.8">
      <match lemma="chez moi" tags="adv"><select lemma="a noste"/></match>
    </rule>
    <rule weight="0.8">
      <match lemma="chez toi" tags="adv"><select lemma="a vòste"/></match>
    </rule>
    <rule weight="0.8">
      <match lemma="chez lui" tags="adv"><select lemma="a lor"/></match>
    </rule>
    <rule weight="0.8">
      <match lemma="chez elle" tags="adv"><select lemma="a lor"/></match>
    </rule>
    <rule weight="0.8">
      <match lemma="chez soi" tags="adv"><select lemma="a casa"/></match>
    </rule>
    <rule weight="0.8">
      <match lemma="chez nous" tags="adv"><select lemma="a noste"/></match>
    </rule>
    <rule weight="0.8">
      <match lemma="chez vous" tags="adv"><select lemma="a vòste"/></match>
    </rule>
    <rule weight="0.8">
      <match lemma="chez eux" tags="adv"><select lemma="a lor"/></match>
    </rule>
    <rule weight="0.8">
      <match lemma="chez elles" tags="adv"><select lemma="a lor"/></match>
    </rule>

    <rule weight="1.0">
      <match tags="pr"/>
      <match lemma="chez moi" tags="adv"><select lemma="casa mea"/></match>
    </rule>
    <rule weight="1.0">
      <match tags="pr"/>
      <match lemma="chez toi" tags="adv"><select lemma="casa toa"/></match>
    </rule>
    <rule weight="1.0">
      <match tags="pr"/>
      <match lemma="chez lui" tags="adv"><select lemma="casa soa"/></match>
    </rule>
    <rule weight="1.0">
      <match tags="pr"/>
      <match lemma="chez soi" tags="adv"><select lemma="casa soa"/></match>
    </rule>
    <rule weight="1.0">
      <match tags="pr"/>
      <match lemma="chez elle" tags="adv"><select lemma="casa soa"/></match>
    </rule>
    <rule weight="1.0">
      <match tags="pr"/>
      <match lemma="chez nous" tags="adv"><select lemma="noste"/></match>
    </rule>
    <rule weight="1.0">
      <match tags="pr"/>
      <match lemma="chez vous" tags="adv"><select lemma="vòste"/></match>
    </rule>
    <rule weight="1.0">
      <match tags="pr"/>
      <match lemma="chez eux" tags="adv"><select lemma="lor"/></match>
    </rule>

    <!-- à moitié >> a miejas, mieitat -->
    <rule weight="0.8">
      <match lemma="à moitié" tags="adv"><select lemma="a miejas"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="à moitié" tags="adv"><select lemma="mieitat"/></match>
      <or>
        <match tags="adj.*"/>
        <match tags="vblex.pp.*"/>
      </or>
    </rule>

    <!-- aussi >> tanben, tant, per mai/per tant -->
    <rule weight="0.8">
      <match lemma="aussi" tags="adv"><select lemma="tanben"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="pas" tags="adv"/>
      <match lemma="aussi" tags="adv"><select lemma="tant"/></match>
    </rule>
    <rule weight="0.8">
      <match lemma="aussi" tags="preadv"><select lemma="tanben"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="pas" tags="adv"/>
      <match lemma="aussi" tags="preadv"><select lemma="tant"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="aussi" tags="adv"><select lemma="per mei"/></match>
      <match tags="adj.*"/>
      <match lemma="que"/>
      <repeat from="0" upto="6">
        <or>
          <match tags="prn.*"/>
          <match tags="det.*"/>
          <match tags="adj.*"/>
          <match tags="n.*"/>
          <match tags="np.*"/>
          <match tags="adj.*"/>
          <match tags="adv"/>
          <match tags="preadv"/>
          <match tags="pr"/>
          <match tags=""/>
        </or>
      </repeat>
      <or>
        <match tags="vbser.prs.*"/>
        <match tags="vbhaver.prs.*"/>
        <match tags="vbmod.prs.*"/>
        <match tags="vblex.prs.*"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match lemma="aussi" tags="adv"><select lemma="per mei"/></match>
      <match tags="adj.*"/>
      <or>
        <match tags="vbser.prs.*"/>
        <match tags="vbhaver.prs.*"/>
        <match tags="vbmod.prs.*"/>
        <match tags="vblex.prs.*"/>
      </or>
      <match lemma="il" tags="prn.tn.*"/>
    </rule>

    <!-- proprement >> pròpiament/netament -->
    <rule weight="0.8">
      <match lemma="proprement" tags="adv"><select lemma="netament"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="proprement" tags="adv"><select lemma="pròpiament"/></match>
      <or>
        <match tags="adj.*"/>
        <match lemma="dire" tags="vblex.*"/>
        <match lemma="parler" tags="vblex.*"/>
        <match tags="vblex.pp.*"/>
      </or>
    </rule>

    <!-- tantôt >> totara/un còp -->
    <rule weight="0.8">
      <match lemma="tantôt" tags="adv"><select lemma="totara"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="tantôt" tags="adv"><select lemma="un còp"/></match>
      <repeat from="0" upto="4">
        <or>
          <match tags="*"/>
          <match tags=""/>
        </or>
      </repeat>
      <match lemma="tantôt" tags="adv"/>
    </rule>
    <rule weight="1.0">
      <match lemma="tantôt" tags="adv"/>
      <repeat from="0" upto="4">
        <or>
          <match tags="*"/>
          <match tags=""/>
        </or>
      </repeat>
      <match lemma="tantôt" tags="adv"><select lemma="un còp"/></match>
    </rule>

    <!-- mieux >> miélher/mei plan -->
    <rule weight="0.8">
      <match lemma="mieux" tags="adv"><select lemma="miélher"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="mieux" tags="adv"><select lemma="mei plan"/></match>
      <or>
        <match tags="adj.*"/>
        <match tags="vblex.pp.*"/>
      </or>
    </rule>
    <rule weight="1.2">
      <match tags="vbhaver.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="mieux" tags="adv"><select lemma="miélher"/></match>
      <match tags="*.pp.*"/>
    </rule>

    <!-- quant à nous, quant à vous masc ou fem -->
    <rule weight="0.8">
      <match lemma="quant à nous" tags="adv"><select lemma="nosauts"/></match>
    </rule>
    <rule weight="0.8">
      <match lemma="quant à vous" tags="adv"><select lemma="vosauts"/></match>
    </rule>

    <!-- **************** ADJ **************** -->

    <!-- criard >> cridassèr, qui tira los uèlhs -->
    <rule weight="0.8">
      <match lemma="criard" tags="adj.*"><select lemma="cridassèr"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="couleur"/>
        <match lemma="rouge"/>
        <match lemma="verd"/>
        <match lemma="bleu"/>
        <match lemma="jaune"/>
        <match lemma="orange"/>
        <match lemma="violet"/>
      </or>
      <match lemma="criard" tags="adj.*"><select lemma="qui tira los uelhs"/></match>
    </rule>

