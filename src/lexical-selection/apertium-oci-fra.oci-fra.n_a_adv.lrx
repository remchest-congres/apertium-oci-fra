  <rules>
    <!-- **************** ADJ **************** -->

    <!-- ceremonial >> cérémoniel, cérémonial -->
    <rule weight="0.8">
      <match lemma="ceremonial" tags="adj.*"><select lemma="cérémoniel"/></match>
    </rule>

    <!-- miei >> demi, moyen -->
    <rule weight="0.8">
      <match lemma="miei" tags="adj.*"><select lemma="demi"/></match>
    </rule>

    <!-- viradís >> versatile, tournant -->
    <rule weight="0.8">
      <match lemma="viradís" tags="adj.*"><select lemma="versatile"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="placa" tags="n.*"/>
        <match lemma="taula" tags="n.*"/>
      </or>
      <match lemma="viradís" tags="adj.*"><select lemma="tournant"/></match>
    </rule>

    <!-- plegadís >> souple, pliant -->
    <rule weight="0.8">
      <match lemma="plegadís" tags="adj.*"><select lemma="souple"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="sèti" tags="n.*"/>
        <match lemma="cadièra" tags="n.*"/>
      </or>
      <match lemma="plegadís" tags="adj.*"><select lemma="pliant"/></match>
    </rule>

    <!-- plegable >> pliable, pliant -->
    <rule weight="0.8">
      <match lemma="plegable" tags="adj.*"><select lemma="pliable"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="sèti" tags="n.*"/>
        <match lemma="cadièra" tags="n.*"/>
      </or>
      <match lemma="plegable" tags="adj.*"><select lemma="pliant"/></match>
    </rule>

    <!-- d'escapsa >> ouvert, habile -->
    <rule weight="0.8">
      <match lemma="d'escapsa" tags="adj.*"><select lemma="ouvert"/></match>
    </rule>
    <rule weight="1.0">
      <match tags="vbser.*"/>
      <repeat from="0" upto="2">
        <or>
          <match tags="preadv"/>
          <match tags="adv"/>
        </or>
      </repeat>
      <match lemma="d'escapsa" tags="adj.*"><select lemma="habile"/></match>
    </rule>

    <!-- ferotge >> farouche, féroce -->
    <rule weight="0.8">
      <match lemma="ferotge" tags="adj.*"><select lemma="farouche"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="animal" tags="n.*"/>
        <match lemma="bèstia" tags="n.*"/>
      </or>
      <match lemma="ferotge" tags="adj.*"><select lemma="féroce"/></match>
    </rule>

    <!-- passat >> passé, dernier -->
    <rule weight="0.8">
      <match lemma="passat" tags="adj.*"><select lemma="passé"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <seq n="temps"/>
        <seq n="jorns"/>
        <seq n="meses"/>
        <seq n="sasons"/>
        <match lemma="dimenjada" tags="n.*"/>
        <match lemma="còp" tags="n.*"><select lemma="fois"/></match>
      </or>
      <match lemma="passat" tags="adj.*"><select lemma="dernier"/></match>
    </rule>

    <!-- venent >> prochain, suivant -->
    <rule weight="0.8">
      <match lemma="venent" tags="adj.*"><select lemma="prochain"/></match>
    </rule>

    <!-- cortés >> poli, courtois -->
    <rule weight="0.8">
      <match lemma="cortés" tags="adj.*"><select lemma="poli"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="amor" tags="n.*"/>
        <match lemma="poesia" tags="n.*"/>
        <match lemma="poësia" tags="n.*"/>
        <match lemma="literatura" tags="n.*"/>
        <match lemma="cançon" tags="n.*"/>
        <match lemma="roman" tags="n.*"/>
        <match lemma="valor" tags="n.*"/>
      </or>
      <match lemma="cortés" tags="adj.*"><select lemma="courtois"/></match>
    </rule>

    <!-- màger >> plus grand, majeur, important -->
    <rule weight="0.8">
      <match lemma="màger" tags="adj.*"><select lemma="majeur"/></match>
    </rule>
    <rule weight="1.0">
      <match tags="preadv"/>
      <match lemma="màger" tags="adj.*"><select lemma="important"/></match>
    </rule>
    <rule weight="1.0">
      <match tags="det.*"/>
      <match tags="n.*"/>
      <match lemma="de" tags="pr"/>
      <match tags="det.def.*"/>
      <match lemma="màger" tags="adj.*.pl"><select lemma="important"/></match>
    </rule>

    <!-- nòu >> nouveau, neuf -->
    <rule weight="0.8">
      <match lemma="nòu" tags="adj.*"><select lemma="nouveau"/></match>
    </rule>

    <!-- franc >> franc, franc_peuple -->
    <rule weight="0.8">
      <match lemma="franc" tags="adj.*"><select lemma="franc"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="pòble" tags="n.*"/>
        <match lemma="rei" tags="n.*"/>
        <match lemma="cap" tags="n.*"/>
        <match lemma="nòble" tags="n.*"/>
        <match lemma="cavalièr" tags="n.*"/>
        <match lemma="cavalèr" tags="n.*"/>
        <match lemma="soldat" tags="n.*"/>
        <match lemma="sordat" tags="n.*"/>
        <match lemma="armada" tags="n.*"/>
        <match lemma="ataca" tags="n.*"/>
        <match lemma="expedicion" tags="n.*"/>
        <match lemma="invasion" tags="n.*"/>
        <match lemma="conquista" tags="n.*"/>
        <match lemma="reconquista" tags="n.*"/>
        <match lemma="costuma" tags="n.*"/>
        <match lemma="religion" tags="n.*"/>
        <match lemma="bastiment" tags="n.*"/>
        <match lemma="construccion" tags="n.*"/>
        <match lemma="castèl" tags="n.*"/>
        <match lemma="palais" tags="n.*"/>
        <match lemma="palaci" tags="n.*"/>
        <match lemma="palatz" tags="n.*"/>
        <match lemma="palai" tags="n.*"/>
      </or>
      <match lemma="franc" tags="adj.*"><select lemma="franc_peuple"/></match>
    </rule>

    <!-- viu >> vivant, vif -->
    <rule weight="0.8">
      <match lemma="viu" tags="adj.*"><select lemma="vivant"/></match>
    </rule>
    <rule weight="1.0">
