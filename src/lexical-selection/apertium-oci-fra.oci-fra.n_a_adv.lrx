    <!-- esplech/espleit >> exploit, outil -->
    <rule weight="0.8">
        <match lemma="esplech" tags="n.*"><select lemma="exploit"/></match>
    </rule>
    <rule weight="0.8">
        <match lemma="espleit" tags="n.*"><select lemma="exploit"/></match>
    </rule>

    <!-- fenestron/finestron >> fenêtre, télévision -->
    <rule weight="0.8">
        <match lemma="fenestron" tags="n.*"><select lemma="fenêtre"/></match>
    </rule>
    <rule weight="0.8">
        <match lemma="finestron" tags="n.*"><select lemma="fenêtre"/></match>
    </rule>
    <rule weight="1.0">
        <or>
          <match lemma="sus" tags="pr"/>
          <match lemma="dins" tags="pr"/>
          <match lemma="dens" tags="pr"/>
          <match lemma="hens" tags="pr"/>
          <match lemma="en" tags="pr"/>
        </or>
        <match tags="det.def.m.sg"/>
        <match lemma="fenestron" tags="n.m.sg"><select lemma="télévision"/></match>
    </rule>
    <rule weight="1.0">
        <or>
          <match lemma="sus" tags="pr"/>
          <match lemma="dins" tags="pr"/>
          <match lemma="dens" tags="pr"/>
          <match lemma="hens" tags="pr"/>
          <match lemma="en" tags="pr"/>
        </or>
        <match tags="det.def.m.sg"/>
        <match lemma="finestron" tags="n.m.sg"><select lemma="télévision"/></match>
    </rule>

    <!-- flamenc >> flamand, flamant -->
    <rule weight="0.8">
        <match lemma="flamenc" tags="n.*"><select lemma="flamand"/></match>
    </rule>
    <rule weight="1.2">
        <match lemma="flamenc" tags="n.m.*"><select lemma="flamand"/></match>
        <or>
          <match lemma="ròse" tags="adj.*"/>
          <match lemma="blanc" tags="adj.*"/>
        </or>
    </rule>

    <!-- material >> matériel, matériau -->
    <rule weight="0.8">
        <match lemma="material" tags="n.*"><select lemma="matériel"/></match>
    </rule>
    <rule weight="1.0">
        <match lemma="material" tags="n.m.pl"><select lemma="matériau"/></match>
    </rule>
    <rule weight="1.0">
        <match lemma="en" tags="pr"/>
        <match lemma="material" tags="n.*"><select lemma="matériau"/></match>
    </rule>
    <rule weight="1.0">
        <or>
            <match lemma="en" tags="pr"/>
            <match lemma="dens" tags="pr"/>
            <match lemma="dins" tags="pr"/>
            <match lemma="hens" tags="pr"/>
        </or>
        <match lemma="un" tags="det.*"/>
        <repeat from="0" upto="3">
            <or>
              <match tags="adv"/>
              <match tags="preadv"/>
              <match tags="adj.*"/>
            </or>
        </repeat>
        <match lemma="material" tags="n.*"><select lemma="matériau"/></match>
    </rule>
    <rule weight="1.0">
        <match lemma="material" tags="n.*"><select lemma="matériau"/></match>
        <match lemma="de" tags="pr"/>
        <or>
            <match lemma="construccion" tags="n.*"/>
            <match lemma="chantièr" tags="n.*"/>
            <match lemma="òbra" tags="n.*"/>
            <match lemma="bastison" tags="n.*"/>
        </or>
    </rule>
    <rule weight="1.0">
        <match lemma="material" tags="n.*"><select lemma="matériau"/></match>
        <or>
            <match lemma="ecologic" tags="adj.*"/>
            <match lemma="durable" tags="adj.*"/>
            <match lemma="duradís" tags="adj.*"/>
        </or>
    </rule>

    <!-- obrador >> atelier, chantier -->
    <rule weight="0.8">
        <match lemma="obrador" tags="n.*"><select lemma="chantier"/></match>
    </rule>
    <rule weight="1.0">
        <match lemma="obrador" tags="n.*"><select lemma="atelier"/></match>
        <match lemma="de" tags="pr"/>
    </rule>
    <rule weight="1.0">
        <match tags="det.pos.*"/>
        <match lemma="obrador" tags="n.*"><select lemma="atelier"/></match>
    </rule>

    <!-- pel >> cheveu, poil -->
    <rule weight="0.8" >
        <match lemma="pel" tags="n.*"><select lemma="cheveu"/></match>
    </rule>

    <rule weight="1.0" >
        <or>
            <match lemma="ariçar" tags="vblex.*"/>
            <match lemma="quilhar" tags="vblex.*"/>
            <match lemma="dreçar" tags="vblex.*"/>
            <match lemma="dreiçar" tags="vblex.*"/>
        </or>
        <match tags="det.def.*"/>
        <match lemma="pel" tags="n.*"><select lemma="poil"/></match>
    </rule>

    <!-- pietat >> pitié, piété -->
    <rule weight="0.8">
        <match lemma="pietat" tags="n.*"><select lemma="pitié"/></match>
    </rule>
    <rule weight="1.0">
        <match lemma="pietat" tags="n.*"><select lemma="piété"/></match>
        <or>
            <match lemma="filial" tags="adj.*"/>
            <match lemma="conjugal" tags="adj.*"/>
            <match lemma="crestian" tags="adj.*"/>
            <match lemma="musulman" tags="adj.*"/>
            <match lemma="religiós" tags="adj.*"/>
            <match lemma="ortodòxe" tags="adj.*"/>
            <match lemma="protestant" tags="adj.*"/>
            <match lemma="ardent" tags="adj.*"/>
        </or>
    </rule>
    <rule weight="1.0">
        <or>
            <match lemma="exercici" tags="n.*"/>
            <match lemma="scèna" tags="n.*"/>
            <match lemma="mont" tags="n.*"/>
        </or>
        <match lemma="de" tags="pr"/>
        <match lemma="pietat" tags="n.*"><select lemma="piété"/></match>
    </rule>

    <!-- primor >> minceur, primeur -->
    <rule weight="0.8">
        <match lemma="primor" tags="n.*"><select lemma="primeur"/></match>
    </rule>

    <!-- procès >> procès, processus -->
    <rule weight="0.8">
        <match lemma="procès" tags="n.*"><select lemma="procès"/></match>
    </rule>

    <!-- roman >> roman, romain -->
    <rule weight="0.8">
        <match lemma="roman" tags="n.m.*"><select lemma="roman"/></match>
    </rule>

    <!-- valon >> vallon, wallon -->
    <rule weight="0.8">
      <match lemma="valon" tags="n.m.*"><select lemma="vallon"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="valon" tags="n.m.pl"><select lemma="wallon"/></match>
    </rule>

    <!-- davalada >> descente, automne -->
    <rule weight="0.8">
      <match lemma="davalada" tags="n.f.*"><select lemma="descente"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="a" tags="pr"/>
        <match lemma="per" tags="pr"/>
        <match lemma="a partir de" tags="pr"/>
        <match lemma="a comptar de" tags="pr"/>
        <match lemma="pendent" tags="pr"/>
        <match lemma="dinc a" tags="pr"/>
        <match lemma="duscas a" tags="pr"/>
        <match lemma="tre" tags="pr"/>
        <match lemma="a la debuta de" tags="pr"/>
        <match lemma="a la fin de" tags="pr"/>
        <match lemma="al mièg de" tags="pr"/>
        <match lemma="al començament de" tags="pr"/>
        <match lemma="al mitan de" tags="pr"/>
        <match lemma="al debut de" tags="pr"/>
      </or>
      <or>
        <match lemma="lo" tags="det.*"/>
        <match tags="det.dem.*"/>
      </or>
      <match lemma="davalada" tags="n.f.*"><select lemma="automne"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="lo" tags="det.*"/>
        <match tags="det.dem.*"/>
      </or>
      <match lemma="davalada" tags="n.f.sg"><select lemma="automne"/></match>
      <repeat from="0" upto="1">
        <match tags="rel.*"/>
      </repeat>
      <repeat from="0" upto="1">
        <match tags="prn.pro.*"/>
      </repeat>
      <or>
          <match lemma="arribar" tags="vblex.*"/>
          <match lemma="venir" tags="vblex.*"/>
          <match lemma="viéner" tags="vblex.*"/>
          <match lemma="ponhar" tags="vblex.*"/>
          <match lemma="trigar" tags="vblex.*"/>
          <match lemma="tornar" tags="vblex.*"/>
          <match lemma="aprochar" tags="vblex.*"/>
          <match lemma="sarrar" tags="vblex.*"/>
          <match lemma="apropiar" tags="vblex.*"/>
          <match lemma="raprochar" tags="vblex.*"/>
          <match lemma="acabar" tags="vblex.*"/>
          <match lemma="finir" tags="vblex.*"/>
          <match lemma="començar" tags="vblex.*"/>
      </or>
    </rule>
    <rule weight="1.0">
      <or>
          <match lemma="arribar" tags="vblex.*"/>
          <match lemma="venir" tags="vblex.*"/>
          <match lemma="viéner" tags="vblex.*"/>
          <match lemma="ponhar" tags="vblex.*"/>
          <match lemma="trigar" tags="vblex.*"/>
          <match lemma="tornar" tags="vblex.*"/>
          <match lemma="aprochar" tags="vblex.*"/>
          <match lemma="sarrar" tags="vblex.*"/>
          <match lemma="apropiar" tags="vblex.*"/>
          <match lemma="raprochar" tags="vblex.*"/>
          <match lemma="acabar" tags="vblex.*"/>
          <match lemma="finir" tags="vblex.*"/>
          <match lemma="començar" tags="vblex.*"/>
      </or>
      <or>
        <match lemma="lo" tags="det.*"/>
        <match tags="det.dem.*"/>
      </or>
      <match lemma="davalada" tags="n.f.sg"><select lemma="automne"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="davalada" tags="n.f.*"><select lemma="automne"/></match>
      <match lemma="de" tags="pr"/>
      <or><match tags="num"/><match tags="num.*"/></or>
    </rule>
    <rule weight="1.0">
      <or>
          <match lemma="debuta" tags="n.*"/>
          <match lemma="debut" tags="n.*"/>
          <match lemma="fin" tags="n.*"/>
          <match lemma="començament" tags="n.*"/>
          <match lemma="començar" tags="n.*"/>
          <match lemma="mitan" tags="n.*"/>
          <match lemma="miei" tags="n.*"/>
          <match lemma="mièg" tags="n.*"/>
          <match lemma="data" tags="vblex.*"/>
          <match lemma="virada" tags="n.*"/>
      </or>
      <match lemma="de" tags="pr"/>
      <repeat from="0" upto="1">
        <or>
          <match lemma="lo" tags="det.*"/>
          <match tags="det.dem.*"/>
        </or>
      </repeat>
      <match lemma="davalada" tags="n.f.*"><select lemma="automne"/></match>
      <or><match tags="num"/><match tags="num.*"/></or>
    </rule>
  </rules>
</lrx>

