      <match lemma="en cò lor" tags="adv"><select lemma="chez eux"/></match>
    </rule>

    <!-- abans d'ora >> avant l'heure, avant le temps, avant terme -->
    <rule weight="0.8">
      <match lemma="abans d'ora" tags="adv"><select lemma="avant l'heure"/></match>
    </rule>

    <!-- abansora >> avant l'heure, avant le temps, avant terme -->
    <rule weight="0.8">
      <match lemma="abansora" tags="adv"><select lemma="avant l'heure"/></match>
    </rule>

    <!-- abantes d'ora >> avant l'heure, avant le temps, avant terme -->
    <rule weight="0.8">
      <match lemma="abantes d'ora" tags="adv"><select lemma="avant l'heure"/></match>
    </rule>

    <!-- davant d'òra >> avant l'heure, avant le temps, avant terme -->
    <rule weight="0.8">
      <match lemma="davant d'òra" tags="adv"><select lemma="avant l'heure"/></match>
    </rule>

    <!-- a ser >> ce soir, soir -->
    <!-- al ser >> ce soir, soir -->
    <!-- de ser >> ce soir, le soir, soir -->
    <!-- de sera >> ce soir, le soir, soir -->
    <macro n="al_ser"><with-param v="a ser"/><with-param v="ce soir"/><with-param v="soir"/></macro>
    <macro n="al_ser"><with-param v="al ser"/><with-param v="ce soir"/><with-param v="soir"/></macro>
    <macro n="al_ser"><with-param v="de ser"/><with-param v="ce soir"/><with-param v="soir"/></macro>
    <macro n="al_ser"><with-param v="de sera"/><with-param v="ce soir"/><with-param v="soir"/></macro>

    <!-- de matin >> le matin, matin -->
    <macro n="al_ser"><with-param v="de matin"/><with-param v="le matin"/><with-param v="matin"/></macro>


    <!-- mai >> plus (adv), plus (adv.pas_neg) -->
    <rule weight="0.8">
      <match lemma="mai" tags="adv"><select lemma="plus" tags="adv"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="pas" tags="adv"/>
      <match lemma="mai" tags="adv"><select lemma="plus" tags="adv.pas_neg"/></match>
    </rule>

    <!-- mei >> plus (adv), plus (adv.pas_neg) -->
    <rule weight="0.8">
      <match lemma="mei" tags="adv"><select lemma="plus" tags="adv"/></match>
    </rule>
    <rule weight="0.8">
      <match lemma="mai" tags="adv"><select lemma="plus" tags="adv"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="pas" tags="adv"/>
      <match lemma="mei" tags="adv"><select lemma="plus" tags="adv.pas_neg"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="pas" tags="adv"/>
      <match lemma="mai" tags="adv"><select lemma="plus" tags="adv.pas_neg"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="ne" tags="adv"/>
        <match lemma="ne" tags="adv.enon"/>
        <match lemma="non" tags="adv"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="prn.pro.*"/>
      </repeat>
      <or><match tags="vblex.*"/><match tags="vbser.*"/><match tags="vbhaver.*"/><match tags="vbmod.*"/></or>
      <match lemma="mei" tags="adv"><select lemma="plus" tags="adv.pas_neg"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="ne" tags="adv"/>
        <match lemma="ne" tags="adv.enon"/>
        <match lemma="non" tags="adv"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="prn.pro.*"/>
      </repeat>
      <or><match tags="vblex.*"/><match tags="vbser.*"/><match tags="vbhaver.*"/><match tags="vbmod.*"/></or>
      <match lemma="mai" tags="adv"><select lemma="plus" tags="adv.pas_neg"/></match>
    </rule>

    <!-- pus >> plus (adv), plus (adv.pas_neg) -->
    <rule weight="0.8">
      <match lemma="pus" tags="adv"><select lemma="plus" tags="adv"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="pas" tags="adv"/>
      <match lemma="pus" tags="adv"><select lemma="plus" tags="adv.pas_neg"/></match>
    </rule>

    <!-- mèi >> plus (adv), plus (adv.pas_neg) -->
    <rule weight="0.8">
      <match lemma="mèi" tags="adv"><select lemma="plus" tags="adv"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="pas" tags="adv"/>
      <match lemma="mèi" tags="adv"><select lemma="plus" tags="adv.pas_neg"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="ne" tags="adv"/>
        <match lemma="ne" tags="adv.enon"/>
        <match lemma="non" tags="adv"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="prn.pro.*"/>
      </repeat>
      <or><match tags="vblex.*"/><match tags="vbser.*"/><match tags="vbhaver.*"/><match tags="vbmod.*"/></or>
      <match lemma="mèi" tags="adv"><select lemma="plus" tags="adv.pas_neg"/></match>
    </rule>

    <!-- despuish >> après, depuis -->
    <rule weight="0.8">
      <match lemma="despuish" tags="adv"><select lemma="après"/></match>
    </rule>

    <!-- bravament >> beaucoup, bravement -->
    <rule weight="0.8">
      <match lemma="bravament" tags="adv"><select lemma="beaucoup"/></match>
    </rule>

    <!-- lestament >> rapidement, etc. -->
    <rule weight="0.8">
      <match lemma="lestament" tags="adv"><select lemma="rapidement"/></match>
    </rule>

    <!-- mai/mei >> plus, davantage -->
    <rule weight="0.8">
      <or>
        <match lemma="mai" tags="adv"><select lemma="plus"/></match>
        <match lemma="mei" tags="adv"><select lemma="plus"/></match>
      </or>
    </rule>

    <!-- non >> non, ne -->
    <rule weight="0.8">
      <match lemma="non" tags="adv"><select lemma="non"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="non" tags="adv"><select lemma="ne"/></match>
      <match lemma="pas" tags="adv"/>
    </rule>
    <rule weight="1.0">
      <match lemma="non" tags="adv"><select lemma="ne"/></match>
      <repeat from="0" upto="2">
        <match tags="prn.pro.*"/>
      </repeat>
      <or><match tags="vblex.*"/><match tags="vbser.*"/><match tags="vbhaver.*"/><match tags="vbmod.*"/></or>
    </rule>
    <rule weight="1.2">
      <match lemma="non" tags="adv"><select lemma="non"/></match>
      <match tags="*.pp.*"/>
    </rule>

    <!-- non (adv.enon) >> [remove], non, ne -->
    <rule weight="0.8">
      <match lemma="non" tags="adv.enon"><remove tags="adv.enon"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="non" tags="adv.enon"><select lemma="ne" tags="adv"/></match>
      <match lemma="pas" tags="adv"/>
    </rule>
    <rule weight="1.0">
      <match lemma="non" tags="adv.enon"><select lemma="ne" tags="adv"/></match>
      <repeat from="0" upto="2">
        <match tags="prn.pro.*"/>
      </repeat>
      <or><match tags="vblex.*"/><match tags="vbser.*"/><match tags="vbhaver.*"/><match tags="vbmod.*"/></or>
    </rule>
    <rule weight="1.2">
      <match lemma="non" tags="adv.enon"><remove tags="adv.enon"/></match>
      <repeat from="0" upto="2">
        <match tags="prn.pro.*"/>
      </repeat>
      <or><match tags="vblex.*"/><match tags="vbser.*"/><match tags="vbhaver.*"/><match tags="vbmod.*"/></or>
      <match lemma="pas" tags="adv"/>
    </rule>

    <!-- pas >> pas, non -->
    <rule weight="0.8">
      <match lemma="pas" tags="adv"><select lemma="pas"/></match>
    </rule>

    <!-- plan >> beaucoup, bien -->
    <rule weight="0.8">
      <match lemma="plan" tags="adv"><select lemma="bien"/></match>
    </rule>

    <!-- tant >> autant, tant -->
    <rule weight="0.8">
      <match lemma="tant" tags="adv"><select lemma="autant"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="tant" tags="adv"><select lemma="tant"/></match>
      <or>
        <match tags="prn.*"/>
        <match tags="n.acr.*"/>
        <match tags="np.*"/>
      </or>
      <match lemma="coma" tags="adv"/>
    </rule>
    <rule weight="1.0">
      <match lemma="tant" tags="adv"><select lemma="tant"/></match>
      <match tags="det.*"/>
      <repeat from="0" upto="2">
        <match tags="adj.*"/>
      </repeat>
      <or>
        <match tags="n.*"/>
        <match tags="np.*"/>
      </or>
      <match lemma="coma" tags="adv"/>
    </rule>
    <rule weight="1.0">
      <match lemma="tant" tags="adv"><select lemma="tant"/></match>
      <match tags="det.*"/>
      <or>
        <match tags="n.*"/>
        <match tags="np.*"/>
      </or>
      <repeat from="0" upto="3">
        <match tags="adj.*"/>
      </repeat>
      <match lemma="coma" tags="adv"/>
    </rule>
    <rule weight="1.0">
      <match lemma="tant" tags="adv"><select lemma="tant"/></match>
      <match tags="det.*"/>
      <match tags="preadv"/>
      <match tags="adj.*"/>
      <match tags="n.*"/>
      <match lemma="coma" tags="adv"/>
    </rule>
    <rule weight="1.0">
      <match lemma="tant" tags="adv"><select lemma="tant"/></match>
      <match tags="det.*"/>
      <match tags="n.*"/>
      <match tags="preadv"/>
      <match tags="adj.*"/>
      <repeat from="0" upto="2">
        <match tags="adj.*"/>
      </repeat>
      <match lemma="coma" tags="adv"/>
    </rule>

    <!-- GASCON: IDEM PRECEDENT -->
    <!-- autant >> autant, tant -->
    <rule weight="0.8">
      <match lemma="autant" tags="adv"><select lemma="autant"/></match>
    </rule>
