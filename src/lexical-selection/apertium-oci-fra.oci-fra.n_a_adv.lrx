      <match tags="det.*"/>
      <or>
        <match tags="n.*"/>
        <match tags="np.*"/>
      </or>
      <repeat from="0" upto="3">
        <match tags="adj.*"/>
      </repeat>
      <match lemma="com" tags="adv"/>
    </rule>
    <rule weight="1.0">
      <match lemma="autant" tags="adv"><select lemma="tant"/></match>
      <match tags="det.*"/>
      <match tags="preadv"/>
      <match tags="adj.*"/>
      <match tags="n.*"/>
      <match lemma="com" tags="adv"/>
    </rule>
