<?xml version="1.0" encoding="UTF-8"?>
<lrx>
  <def-macros>
    <def-macro n="al_ser" npar="3">
      <rule weight="0.8">
        <match plemma="1" tags="adv"><select plemma="2"/></match>
      </rule>
      <rule weight="1.0">
        <or>
          <seq n="jorns"/>
        </or>
        <repeat from="0" upto="1">
          <or><match tags="num"/><match tags="num.*"/></or>
        </repeat>
        <match plemma="1" tags="adv"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <or>
	      <match lemma="uèi" tags="adv"/>
	      <match lemma="uei" tags="adv"/>
	      <match lemma="ué" tags="adv"/>
	      <match lemma="aué" tags="adv"/>
	      <match lemma="auèi" tags="adv"/>
	      <match lemma="uòi" tags="adv"/>
	      <match lemma="ager" tags="adv"/>
	      <match lemma="ièr" tags="adv"/>
	      <match lemma="ier" tags="adv"/>
	      <match lemma="ger" tags="adv"/>
	      <match lemma="ager" tags="adv"/>
	      <match lemma="deman" tags="adv"/>
	      <match lemma="doman" tags="adv"/>
	      <match lemma="passat ièr" tags="adv"/>
	      <match lemma="passat ier" tags="adv"/>
	      <match lemma="abans-ger" tags="adv"/>
	      <match lemma="davant-ger" tags="adv"/>
	      <match lemma="davant-ièr" tags="adv"/>
	      <match lemma="davant-ier" tags="adv"/>
	      <match lemma="ièr delà" tags="adv"/>
	      <match lemma="ier delà" tags="adv"/>
	      <match lemma="ièr delai" tags="adv"/>
	      <match lemma="ier delai" tags="adv"/>
	      <match lemma="deman passat" tags="adv"/>
	      <match lemma="doman passat" tags="adv"/>
        </or>
        <match plemma="1" tags="adv"><select plemma="3"/></match>
      </rule>
    </def-macro>

    <!-- generar "un demi-(siècle, tour, etc.)" o "demi-(siècle, tour, etc.)" -->
    <def-macro n="mieg-demi" npar="3">
      <rule weight="0.8">
        <match plemma="1" tags="n.*"><select plemma="2"/></match>
      </rule>
      <rule weight="1.0">
        <or>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="num"/>
          <match tags="adj.*"/>
        </or>
        <match plemma="1" tags="n.*"><select plemma="3"/></match>
      </rule>
    </def-macro>

    <!-- generar 'chef', p.ex.: cap >> chef n.GD, chef n.m -->
    <def-macro n="gen_chef" npar="2">
      <rule weight="0.8">
        <match plemma="1" tags="n.*"><select plemma="2" tags="n.m.*"/></match>
      </rule>
      <rule weight="1.0">
        <or>
          <match tags="det.*.f.*"/>
          <match tags="adj.*.f.*"/>
        </or>
        <match plemma="1" tags="n.*"><select plemma="2" tags="n.GD.*"/></match>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="n.*"><select plemma="2" tags="n.GD.*"/></match>
        <repeat from="0" upto="1">
          <or>
            <match tags="preadv"/>
            <match tags="adv"/>
          </or>
        </repeat>
        <match tags="adj.*.f.*"/>
      </rule>
      <rule weight="1.0">
        <match tags="np.ant.f.*"/>
        <repeat from="0" upto="1">
          <or>
            <match tags="np.ant.*"/>
            <match tags="np.cog.*"/>
            <match tags="" case="Aa"/>
          </or>
        </repeat>
        <repeat from="0" upto="1">
          <match tags="cm"/>
        </repeat>
        <match plemma="1" tags="n.*"><select plemma="2" tags="n.GD.*"/></match>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="n.*"><select plemma="2" tags="n.GD.*"/></match>
        <repeat from="0" upto="10">
          <or>
            <match tags="pr"/>
            <match tags="det.*"/>
            <match tags="n.*"/>
            <match tags="adj.*"/>
            <match tags="np.top.*"/>
            <match tags="np.al.*"/>
            <match tags="" case="Aa"/>
          </or>
        </repeat>
        <repeat from="0" upto="1">
          <match tags="cm"/>
        </repeat>
        <repeat from="0" upto="1">
          <match tags="" case="Aa"/>
        </repeat>
        <match tags="np.ant.f.*"/>
      </rule>
	  </def-macro>
  </def-macros>

