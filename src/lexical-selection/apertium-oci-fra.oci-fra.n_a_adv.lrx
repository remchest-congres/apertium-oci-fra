      <match tags="det.*"/>
      <match tags="n.*"/>
      <match tags="preadv"/>
      <match tags="adj.*"/>
      <repeat from="0" upto="2">
        <match tags="adj.*"/>
      </repeat>
      <match lemma="com" tags="adv"/>
    </rule>

    <!-- mentretant >> en attendant, entre-temps -->
    <rule weight="0.8">
      <match lemma="mentretant" tags="adv"><select lemma="entre-temps"/></match>
    </rule>


    <!-- **************** N **************** -->

    <!-- riu >> rivière, cours# d'eau -->
    <rule weight="0.8">
      <match lemma="riu" tags="n.*"><select lemma="rivière"/></match>
    </rule>

    <!-- copadura >> copadura, faille -->
    <rule weight="0.8">
      <match lemma="copadura" tags="n.*"><select lemma="coupure"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="copadura" tags="n.*"><select lemma="faille"/></match>
      <or>
        <match lemma="geologic" tags="adj.*"/>
        <match lemma="tectonic" tags="adj.*"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match lemma="copadura" tags="n.*"><select lemma="faille"/></match>
      <match lemma="de" tags="pr"/>
      <repeat from="0" upto="1">
        <match tags="det.def.*"/>
      </repeat>
      <match tags="" case="Aa"/>
    </rule>

    <!-- andada >> vague, promenade -->
    <rule weight="0.8">
      <match lemma="andada" tags="n.*"><select lemma="vague"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="dar" tags="vblex.*"/>
      <repeat from="0" upto="1">
        <match tags="det.*"/>
      </repeat>
      <match lemma="andada" tags="n.*"><select lemma="promenade"/></match>
    </rule>

    <!-- mic >> ami, baiser -->
    <rule weight="0.8">
      <match lemma="mic" tags="n.*"><select lemma="ami"/></match>
    </rule>

    <!-- escalfament >> échauffement, réchauffement-->
    <rule weight="0.8">
      <match lemma="escalfament" tags="n.*"><select lemma="échauffement"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="escalfament" tags="n.*"><select lemma="réchauffement"/></match>
      <or>
        <match lemma="mondial" tags="adj.*"/>
        <match lemma="global" tags="adj.*"/>
        <match lemma="planetari" tags="adj.*"/>
        <match lemma="climatic" tags="adj.*"/>
      </or>
    </rule>

    <!-- hami >> faim, envie -->
    <rule weight="0.8">
      <match lemma="hami" tags="n.*"><select lemma="faim"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="aver" tags="vblex.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="hami" tags="n.*"><select lemma="envie"/></match>
    </rule>

    <!-- talent >> talent, envie -->
    <rule weight="0.8">
      <match lemma="talent" tags="n.*"><select lemma="talent"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="aver" tags="vblex.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="talent" tags="n.*"><select lemma="envie"/></match>
    </rule>

    <!-- gana >> fringale, envie -->
    <rule weight="0.8">
      <match lemma="gana" tags="n.*"><select lemma="fringale"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="aver" tags="vblex.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="gana" tags="n.*"><select lemma="envie"/></match>
    </rule>

    <!-- glacet >> glaçon, glace-->
    <rule weight="0.8">
      <match lemma="glacet" tags="n.*"><select lemma="glaçon"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="manjar" tags="vblex.*"/>
        <match lemma="minjar" tags="vblex.*"/>
        <match lemma="galapar" tags="vblex.*"/>
        <match lemma="galavardejar" tags="vblex.*"/>
        <match lemma="glotonejar" tags="vblex.*"/>
        <match lemma="lecar" tags="vblex.*"/>
        <match lemma="lepar" tags="vblex.*"/>
        <match lemma="lafrar" tags="vblex.*"/>
      </or>
      <repeat from="0" upto="3">
        <or>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="adj.*"/>
          <match tags="adv"/>
          <match tags="preadv"/>
        </or>
      </repeat>
      <match lemma="glacet" tags="n.*"><select lemma="glace"/></match>
    </rule>

    <!-- jaç >> couche, gisement-->
    <rule weight="0.8">
      <match lemma="jaç" tags="n.*"><select lemma="couche"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="jaç" tags="n.*"><select lemma="gisement"/></match>
      <repeat from="0" upto="1">
        <match tags="adj.*"/>
      </repeat>
      <match lemma="de" tags="pr"/>
      <repeat from="0" upto="1">
        <match tags="det.def.*"/>
      </repeat>
      <or>
        <match tags="np.top.*"/>
        <match tags="" case="Aa"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match lemma="jaç" tags="n.*"><select lemma="gisement"/></match>
      <repeat from="0" upto="1">
        <match tags="adj.*"/>
      </repeat>
      <match lemma="de" tags="pr"/>
      <or>
        <seq n="minerals"/>
        <match lemma="carbon" tags="n.*"/>
        <match lemma="antracita" tags="n.*"/>
        <match lemma="lignit" tags="n.*"/>
        <match lemma="esquiste" tags="n.*"/>
        <match lemma="sistre" tags="n.*"/>
        <match lemma="petròli" tags="n.*"/>
        <match lemma="gaz" tags="n.*"/>
        <match lemma="metan" tags="n.*"/>
        <match lemma="sal" tags="n.*"/>
        <match lemma="ambre" tags="n.*"/>
        <match lemma="fossile" tags="n.*"/>
        <match lemma="dinosaure" tags="n.*"/>
        <match lemma="œuf" tags="n.*"/>
        <match lemma="silex" tags="n.*"/>
        <match lemma="silèx" tags="n.*"/>
        <match lemma="selze" tags="n.*"/>
        <match lemma="pèirahuec" tags="n.*"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match lemma="jaç" tags="n.*"><select lemma="gisement"/></match>
      <repeat from="0" upto="1">
        <match tags="adj.*"/>
      </repeat>
      <match lemma="de" tags="pr"/>
      <match lemma="matèria" tags="n.*"/>
      <or>
        <match lemma="primièr" tags="adj.*"/>
      </or>
    </rule>

    <!-- degalh >> gaspillage, dégât, déchet -->
    <rule weight="0.8">
      <match lemma="degalh" tags="n.*"><select lemma="gaspillage"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="degalh" tags="n.m.pl"><select lemma="dégât"/></match>
    </rule>
    <rule weight="1.2">
      <match lemma="degalh" tags="n.m.pl"><select lemma="déchet"/></match>
      <match lemma="de" tags="pr"/>
    </rule>
    <rule weight="1.2">
      <match lemma="degalh" tags="n.m.pl"><select lemma="déchet"/></match>
      <or>
        <match lemma="toxic" tags="adj.*"/>
        <match lemma="perilhós" tags="adj.*"/>
        <match lemma="dangerós" tags="adj.*"/>
        <match lemma="dangierós" tags="adj.*"/>
        <match lemma="organic" tags="adj.*"/>
        <match lemma="animal"/>
        <match lemma="vegetal" tags="adj.*"/>
        <match lemma="alimentari" tags="adj.*"/>
        <match lemma="electronic" tags="adj.*"/>
        <match lemma="reciclable" tags="adj.*"/>
        <match lemma="reciclader" tags="adj.*"/>
      </or>
    </rule>
    <rule weight="1.2">
      <or>
        <match lemma="reciclatge" tags="n.*"/>
        <match lemma="tria" tags="n.*"/>
        <match lemma="compostatge" tags="n.*"/>
        <match lemma="tractament" tags="n.*"/>
        <match lemma="gestion" tags="n.*"/>
      </or>
      <repeat from="0" upto="1">
        <match tags="adj.*"/>
      </repeat>
      <match lemma="de" tags="pr"/>
      <match lemma="degalh" tags="n.m.pl"><select lemma="déchet"/></match>
    </rule>
    <rule weight="1.2">
      <match lemma="zèro"/>
      <match lemma="degalh" tags="n.*"><select lemma="déchet"/></match>
    </rule>
    <rule weight="1.4">
      <match lemma="degalh" tags="n.m.pl"><select lemma="dégât"/></match>
      <match lemma="de" tags="pr"/>
      <match tags="det.*"/>
      <or>
        <match lemma="tèrratrem" tags="n.*"/>
        <match lemma="tèrratremol" tags="n.*"/>
        <match lemma="terratremol" tags="n.*"/>
        <match lemma="tèrratremble" tags="n.*"/>
        <match lemma="tsunami" tags="n.*"/>
        <match lemma="auragan" tags="n.*"/>
        <match lemma="aurassa" tags="n.*"/>
        <match lemma="auratge" tags="n.*"/>
        <match lemma="esglàs" tags="n.*"/>
        <match lemma="incendi" tags="n.*"/>
        <match lemma="cremada" tags="n.*"/>
