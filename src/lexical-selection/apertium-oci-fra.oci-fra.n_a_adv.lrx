    </rule>
    <rule weight="1.0">
      <match lemma="aperaquí" tags="adv"><select lemma="environ"/></match>
      <match tags="det.def.*"/>
      <or>
        <match lemma="an" tags="n.*"/>
        <match lemma="annada" tags="n.*"/>
        <match lemma="sègle" tags="n.*"/>
        <match lemma="sècle" tags="n.*"/>
        <match lemma="segle" tags="n.*"/>
      </or>
      <or>
        <match tags="num"/>
        <match tags="num.*"/>
      </or>
    </rule>

    <!-- pas >> pas -->
    <rule weight="0.8">
      <match lemma="pas" tags="adv"><select lemma="pas"/></match>
    </rule>

    <!-- a lor >> chez lui, chez elle -->
    <rule weight="0.8">
      <match lemma="a lor" tags="adv"><select lemma="chez lui"/></match>
    </rule>

    <!-- en çò sieu >> chez lui, chez elle -->
    <rule weight="0.8">
      <match lemma="en çò sieu" tags="adv"><select lemma="chez lui"/></match>
    </rule>

    <!-- en cò sieu >> chez lui, chez elle -->
    <rule weight="0.8">
      <match lemma="en cò sieu" tags="adv"><select lemma="chez lui"/></match>
    </rule>

    <!-- en çò seu >> chez lui, chez elle -->
    <rule weight="0.8">
      <match lemma="en çò seu" tags="adv"><select lemma="chez lui"/></match>
    </rule>

    <!-- en cò seu >> chez lui, chez elle -->
    <rule weight="0.8">
      <match lemma="en cò seu" tags="adv"><select lemma="chez lui"/></match>
    </rule>

    <!-- en çò siu >> chez lui, chez elle -->
    <rule weight="0.8">
      <match lemma="en çò siu" tags="adv"><select lemma="chez lui"/></match>
    </rule>

    <!-- en cò siu >> chez lui, chez elle -->
