  <rules>
    <!-- **************** VBHAVER **************** -->

    <!-- vbhaver >> être, avoir -->
    <rule weight="0.8">
      <match tags="vbhaver.*"><select tags="vbhaver.*"/></match>
    </rule>
    <rule weight="1.0">
      <match tags="vbhaver.*"><select tags="vbser.*"/></match>
      <repeat from="0" upto="3">
        <match tags="adv"/>
      </repeat>
      <or>
        <match lemma="être" tags="vbser.pp.*"/>
        <match lemma="être" tags="vblex.pp.*"/>
      </or>
    </rule>

    <!-- **************** VBLEX **************** -->

    <!-- afficher >> mostrar, afichar -->
    <rule weight="0.8">
      <match lemma="afficher" tags="vblex.*"><select lemma="mostrar"/></match>
    </rule>

    <!-- piocher >> fotjar/hotjar, pescar -->
    <rule weight="1.0">
      <match lemma="piocher" tags="vblex.*"><select lemma="pescar"/></match>
      <repeat from="0" upto="5">
        <or>
          <match lemma="de" tags="pr"/>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="preadv"/>
          <match tags="adv"/>
          <match tags="adj.*"/>
          <match tags="n.*"/>
        </or>
      </repeat>
      <match lemma="dans" tags="pr"/>
