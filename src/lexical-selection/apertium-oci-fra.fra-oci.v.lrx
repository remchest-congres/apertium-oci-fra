<?xml version="1.0" encoding="UTF-8"?>
<lrx>
  <def-macros>
    <!-- Aquesta macro tria el verb p2 si p1 és intransitiu i p3 si p1 és transitiu -->
    <!-- p1 = verb fra, p2 = verb oci intransitiu, p3 = verb oci transitiu -->
    <!-- la manera de veure que el verb és transitiu és molt barroera -->
    <def-macro n="verb_intrans_trans" npar="3">
      <rule weight="0.8">
        <match plemma="1" tags="vblex.*"><select plemma="2"/></match>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*"><select plemma="3"/></match>
        <repeat from="0" upto="2">
          <match tags="adv"/>
        </repeat>
        <or>
          <match tags="det.*"/>
          <match tags="np.*"/>
        </or>
      </rule>
      <rule weight="1.2">
        <match plemma="1" tags="vblex.*"><select plemma="2"/></match>
        <repeat from="0" upto="2">
          <match tags="adv"/>
        </repeat>
        <match tags="det.*"/>
        <repeat from="0" upto="1">
          <match tags="adj.*"/>
        </repeat>
        <or>
          <match lemma="jour" tags="n.*"/>
          <match lemma="journée" tags="n.*"/>
          <match lemma="veille" tags="n.*"/>
          <match lemma="veille" tags="n.*"/>
          <match lemma="nuit" tags="n.*"/>
          <match lemma="matin" tags="n.*"/>
          <match lemma="matinée" tags="n.*"/>
          <match lemma="après-midi" tags="n.*"/>
          <match lemma="soir" tags="n.*"/>
          <match lemma="soirée" tags="n.*"/>
          <match lemma="week-end" tags="n.*"/>
          <match lemma="weekend" tags="n.*"/>
          <match lemma="semaine" tags="n.*"/>
          <match lemma="mois" tags="n.*"/>
          <match lemma="année" tags="n.*"/>
          <match lemma="lustre" tags="n.*"/>
          <match lemma="décennie" tags="n.*"/>
          <match lemma="siècle" tags="n.*"/>
          <match lemma="vacances" tags="n.*"/>
        </or>
      </rule>
      <rule weight="1.4">
        <match plemma="1" tags="vblex.*"><select plemma="3"/></match>
        <repeat from="0" upto="2">
          <match tags="adv"/>
        </repeat>
        <match tags="det.*"/>
        <repeat from="0" upto="1">
          <match tags="adj.*"/>
        </repeat>
        <or>
          <match lemma="jour" tags="n.*"/>
          <match lemma="journée" tags="n.*"/>
          <match lemma="veille" tags="n.*"/>
          <match lemma="veille" tags="n.*"/>
          <match lemma="nuit" tags="n.*"/>
          <match lemma="matin" tags="n.*"/>
          <match lemma="matinée" tags="n.*"/>
          <match lemma="après-midi" tags="n.*"/>
          <match lemma="soir" tags="n.*"/>
          <match lemma="soirée" tags="n.*"/>
          <match lemma="week-end" tags="n.*"/>
          <match lemma="weekend" tags="n.*"/>
          <match lemma="semaine" tags="n.*"/>
          <match lemma="mois" tags="n.*"/>
          <match lemma="année" tags="n.*"/>
          <match lemma="lustre" tags="n.*"/>
          <match lemma="décennie" tags="n.*"/>
          <match lemma="siècle" tags="n.*"/>
          <match lemma="vacances" tags="n.*"/>
        </or>
        <or>
          <match tags="det.*"/>
          <match tags="np.*"/>
        </or>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*"><select plemma="3"/></match>
        <repeat from="0" upto="2">
          <match tags="adv"/>
        </repeat>
        <or>
          <match tags="num.*"/>
          <match tags="num"/>
        </or>
        <repeat from="0" upto="2">
          <or>
            <match tags="preadv"/>
            <match tags="adv"/>
            <match tags="adj.*"/>
          </or>
        </repeat>
        <match tags="n.*"/>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*"><select plemma="3"/></match>
        <repeat from="0" upto="2">
          <match tags="adv"/>
        </repeat>
        <match lemma="de" tags="pr"/>
        <repeat from="0" upto="1">
          <match tags="det.def.*"/>
        </repeat>
        <repeat from="0" upto="2">
          <or>
            <match tags="preadv"/>
            <match tags="adv"/>
            <match tags="adj.*"/>
          </or>
        </repeat>
        <match tags="n.*.pl"/>
      </rule>
      <rule weight="1.0">
        <match lemma="le" tags="prn.pro.*"/>
        <match plemma="1" tags="vblex.*"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <match tags="vbser.*"/>
        <repeat from="0" upto="2">
          <match tags="adv"/>
        </repeat>
        <match plemma="1" tags="vblex.pp.*"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <or>
          <match tags="n.*"/>
          <match tags="adj.*"/>
          <match tags="vblex.pp.*"/>
        </or>
        <match plemma="1" tags="vblex.pp.*"><select plemma="3"/></match>
      </rule>
    </def-macro>

    <!-- p1 = verb fra, p2 = verb oci no pron, p3 = verb oci pron -->
    <def-macro n="verb_nopron_pron" npar="3">
      <rule weight="0.8">
        <match plemma="1" tags="vblex.*"><select plemma="2"/></match>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p1.*.sg"/>
        <match plemma="1" tags="vblex.*.p1.sg"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p1.*.sg"/>
        <match tags="prn.pro.*"/>
        <match plemma="1" tags="vblex.*.p1.sg"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*.p1.sg"><select plemma="3"/></match>
        <match tags="prn.enc.p1.*.sg"/>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p2.*.sg"/>
        <match plemma="1" tags="vblex.*.p2.sg"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p2.*.sg"/>
        <match tags="prn.pro.*"/>
        <match plemma="1" tags="vblex.*.p2.sg"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*.p2.sg"><select plemma="3"/></match>
        <match tags="prn.enc.p2.*.sg"/>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.ref.p3.*.sp"/>
        <or>
          <match plemma="1" tags="vblex.*.p3.sg"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.*.p3.pl"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.inf"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.ger"><select plemma="3"/></match>
        </or>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.ref.p3.*.sp"/>
        <match tags="prn.pro.*"/>
        <or>
          <match plemma="1" tags="vblex.*.p3.sg"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.*.p3.pl"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.inf"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.ger"><select plemma="3"/></match>
        </or>
      </rule>
      <rule weight="1.0">
        <or>
          <match plemma="1" tags="vblex.*.p3.sg"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.*.p3.pl"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.inf"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.ger"><select plemma="3"/></match>
        </or>
        <match tags="prn.enc.ref.p3.*.sp"/>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p1.*.pl"/>
        <match plemma="1" tags="vblex.*.p1.pl"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p1.*.pl"/>
        <match tags="prn.pro.*"/>
        <match plemma="1" tags="vblex.*.p1.pl"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*.p1.pl"><select plemma="3"/></match>
        <match tags="prn.enc.p1.*.pl"/>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p2.*.pl"/>
        <match plemma="1" tags="vblex.*.p2.pl"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p2.*.pl"/>
        <match tags="prn.pro.*"/>
        <match plemma="1" tags="vblex.*.p2.pl"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*.p2.pl"><select plemma="3"/></match>
        <match tags="prn.enc.p2.*.pl"/>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p3.*"/>
        <match plemma="1" tags="vblex.*.p3.*"><select plemma="3"/></match>
        <repeat from="0" upto="1">
          <or>
            <match tags="adv"/>
            <match tags="preadv"/>
          </or>
        </repeat>
        <or>
          <match tags="np.ant"/>
          <match tags="np.ant.*"/>
          <match tags="np.cog.*"/>
        </or>
      </rule>
      <rule weight="1.0">
        <match tags="vbser.*"/>
        <repeat from="0" upto="2">
          <match tags="adv"/>
        </repeat>
        <match plemma="1" tags="vblex.pp.*"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <match tags="n.*"/>
        <repeat from="0" upto="1">
          <match tags="adj.*"/>
        </repeat>
        <match plemma="1" tags="vblex.pp.*"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <or>
          <match tags="cm"/>
          <match tags="lpar"/>
        </or>
        <match plemma="1" tags="vblex.pp.*"><select plemma="3"/></match>
      </rule>
    </def-macro>
  </def-macros>

