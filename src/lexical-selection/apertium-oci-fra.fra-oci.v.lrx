        <match tags="np.ant.*"/>
        <match tags="np.cog.*"/>
        <match tags="" case="Aa"/>
        <match lemma="monsieur" tags="n.*"/>
        <match lemma="madame" tags="n.*"/>
        <match lemma="monseigneur" tags="n.*"/>
      </or>
    </rule>
    <rule weight="0.9">
      <match lemma="buter" tags="vblex.*"><select lemma="tuar"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <or>
        <match tags="det.*"/>
        <match tags="num.*"/>
        <match tags="num"/>
      </or>
      <or>
        <seq n="personne"/>
      </or>
    </rule>

    <!-- dresser -> dreçar, quilhar -->
    <macro n="verb_nopron_pron"><with-param v="dresser"/><with-param v="dreçar"/><with-param v="quilhar"/></macro>

    <!-- rouler -> rotlar, voludar/esbrohir, engarçar -->
    <rule weight="1.2">
      <match lemma="rouler" tags="vblex.*"><select lemma="engarçar"/></match>
      <match tags="det.*"/>
      <or>
        <seq n="personne"/>
      </or>
    </rule>
    <rule weight="1.2">
      <match lemma="rouler" tags="vblex.*"><select lemma="engarçar"/></match>
      <match lemma="quelqu'un" tags="prn.*"/>
    </rule>
    <rule weight="2.0">
      <match tags="prn.pro.p1.*.sg"/>
      <match lemma="faire" tags="vblex.*.p1.sg"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="rouler" tags="vblex.inf"><select lemma="engarçar"/></match>
    </rule>
    <rule weight="2.0">
      <match tags="prn.pro.p2.*.sg"/>
      <match lemma="faire" tags="vblex.*.p2.sg"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="rouler" tags="vblex.inf"><select lemma="engarçar"/></match>
    </rule>
    <rule weight="2.0">
      <match tags="prn.pro.p1.*.pl"/>
      <match lemma="faire" tags="vblex.*.p1.pl"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="rouler" tags="vblex.inf"><select lemma="engarçar"/></match>
    </rule>
    <rule weight="2.0">
      <match tags="prn.pro.p2.*.pl"/>
      <match lemma="faire" tags="vblex.*.p2.pl"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="rouler" tags="vblex.inf"><select lemma="engarçar"/></match>
    </rule>
    <rule weight="2.0">
      <match tags="prn.pro.ref.p3.*.sp"/>
      <or>
        <match lemma="faire" tags="vblex.*.p3.sg"/>
        <match lemma="faire" tags="vblex.*.p3.pl"/>
        <match lemma="faire" tags="vblex.inf"/>
        <match lemma="faire" tags="vblex.ger"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="rouler" tags="vblex.inf"><select lemma="engarçar"/></match>
    </rule>

    <rule weight="2.0">
      <match tags="prn.pro.p1.*.sg"/>
      <match tags="vbser.*.p1.sg"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="faire" tags="vblex.pp.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="rouler" tags="vblex.inf"><select lemma="engarçar"/></match>
    </rule>
    <rule weight="2.0">
      <match tags="prn.pro.p2.*.sg"/>
      <match tags="vbser.*.p2.sg"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="faire" tags="vblex.pp.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="rouler" tags="vblex.inf"><select lemma="engarçar"/></match>
    </rule>
    <rule weight="2.0">
      <match tags="prn.pro.p1.*.pl"/>
      <match tags="vbser.*.p1.pl"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="faire" tags="vblex.pp.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="rouler" tags="vblex.inf"><select lemma="engarçar"/></match>
    </rule>
    <rule weight="2.0">
      <match tags="prn.pro.p2.*.pl"/>
      <match tags="vbser.*.p2.pl"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="faire" tags="vblex.pp.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="rouler" tags="vblex.inf"><select lemma="engarçar"/></match>
    </rule>
    <rule weight="2.0">
      <match tags="prn.pro.ref.p3.*.sp"/>
      <or>
        <match tags="vbser.*.p3.sg"/>
        <match tags="vbser.*.p3.pl"/>
        <match tags="vbser.inf"/>
        <match tags="vbser.ger"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="faire" tags="vblex.pp.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="rouler" tags="vblex.inf"><select lemma="engarçar"/></match>
    </rule>

    <!-- décrocher >> descrocar, agantar/desgahar, despenjar -->
    <rule weight="0.8">
      <match lemma="décrocher" tags="vblex.*"><select lemma="despenjar"/></match>
    </rule>

    <!-- dérouler >> desenrotlar, debanar -->
    <macro n="verb_nopron_pron"><with-param v="dérouler"/><with-param v="desenrotlar"/><with-param v="debanar"/></macro>

    <!-- retrancher -> suprimir, fortificar -->
    <macro n="verb_nopron_pron"><with-param v="retrancher"/><with-param v="suprimir"/><with-param v="fortificar"/></macro>

    <!-- terrer >> amagar, enterrar -->
    <macro n="verb_nopron_pron"><with-param v="terrer"/><with-param v="enterrar"/><with-param v="amagar"/></macro>

    <!-- embrasser >> abraçar, poto(n)ar -->
    <rule weight="0.8">
      <match lemma="vous" tags="prn.pro.*"/>
      <match lemma="embrasser" tags="vblex.*"><select lemma="abraçar"/></match>
    </rule>

    <!-- engloutir >> engolir, englotir -->
    <rule weight="0.8">
      <match lemma="engloutir" tags="vblex.*"><select lemma="englotir"/></match>
    </rule>

    <!-- flotter >> flotar, plòure/plàver, bandejar -->
    <rule weight="0.8">
      <match lemma="flotter" tags="vblex.*"><select lemma="flotar"/></match>
    </rule>

    <rule weight="2.0">
      <or>
        <match lemma="me" tags="prn.pro.*"/>
        <match lemma="te" tags="prn.pro.*"/>
        <match lemma="se" tags="prn.pro.*"/>
        <match lemma="nous" tags="prn.pro.*"/>
        <match lemma="vous" tags="prn.pro.*"/>
      </or>
      <match lemma="ficher" tags="vblex.*" ><select lemma="trufar"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="de" tags="pr"/>
    </rule>
    <rule weight="2.0">
      <or>
        <match lemma="me" tags="prn.pro.*"/>
        <match lemma="te" tags="prn.pro.*"/>
        <match lemma="se" tags="prn.pro.*"/>
        <match lemma="nous" tags="prn.pro.*"/>
        <match lemma="vous" tags="prn.pro.*"/>
      </or>
      <match tags="vbser.*" />
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="ficher" tags="vblex.*" ><select lemma="trufar"/></match>
      <match lemma="de" tags="pr"/>
    </rule>


    <!-- filer >> filar/hilar, partir, córrer, escapar, passar/pèisher -->
    <rule weight="1.2">
      <match lemma="laisser" tags="vblex.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="filer" tags="vblex.inf"><select lemma="escapar"/></match>
    </rule>
    <rule weight="1.2">
      <match lemma="filer" tags="vblex.*"><select lemma="escapar"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="entre" tags="pr"/>
      <match tags="det.def.*"/>
      <match lemma="doigt" tags="n.m.pl"/>
    </rule>

    <!-- hanter >> obsedir, frequentar -->
    <rule weight="0.8">
      <match lemma="hanter" tags="vblex.*"><select lemma="frequentar"/></match>
    </rule>

    <rule weight="1.0">
      <or>
        <match lemma="me" tags="prn.pro.*"/>
        <match lemma="te" tags="prn.pro.*"/>
        <match lemma="nous" tags="prn.pro.*"/>
        <match lemma="vous" tags="prn.pro.*"/>
      </or>
      <match lemma="hanter" tags="vblex.*.p2.*" ><select lemma="obsedir"/></match>
    </rule>

    <rule weight="1.0">
      <or>
        <match lemma="souvenir" tags="n.*"/>
        <match lemma="pensée" tags="n.*"/>
        <match lemma="question" tags="n.*"/>
      </or>
      <match lemma="le" tags="prn.pro.*"/>
      <match lemma="hanter" tags="vblex.*.p2.*" ><select lemma="obsedir"/></match>
    </rule>

    <!-- primer >> premiar/primar -->
    <rule weight="0.8">
      <match lemma="primer" tags="vblex.*"><select lemma="premiar"/></match>
    </rule>

    <!-- repasser >> repassar, alisar -->
    <rule weight="0.8">
      <match lemma="repasser" tags="vblex.*"><select lemma="repassar"/></match>
    </rule>

    <!-- saisir >> sasir, arrapar -->
    <rule weight="0.8">
      <match lemma="saisir" tags="vblex.*"><select lemma="sasir"/></match>
    </rule>

    <!-- traduire >> traduire/tradusir, revirar -->
    <rule weight="0.8">
      <match lemma="traduire" tags="vblex.*"><select lemma="traduire"/></match>
    </rule>
    <rule weight="0.8">
      <match lemma="traduire" tags="vblex.*"><select lemma="tradusir"/></match>
    </rule>

    <!-- tromper >> enganar, trompar... -->
    <rule weight="0.8">
      <match lemma="tromper" tags="vblex.*"><select lemma="enganar"/></match>
    </rule>

    <!-- conduire >> conduire/condusir, menar/miar -->
    <rule weight="0.8">
      <match lemma="conduire" tags="vblex.*"><select lemma="conduire"/></match>
    </rule>
    <rule weight="0.8">
      <match lemma="conduire" tags="vblex.*"><select lemma="condusir"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="conduire" tags="vblex.*"><select lemma="menar"/></match>
        <match lemma="conduire" tags="vblex.*"><select lemma="miar"/></match>
      </or>
      <repeat from="0" upto="4">
        <or>
          <match tags="adv"/>
          <match tags="preadv"/>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="num"/>
          <match tags="adj.*"/>
          <match lemma="de" tags="pr"/>
        </or>
      </repeat>
      <or>
        <match lemma="véhicule" tags="n.*"/>
        <match lemma="voiture" tags="n.*"/>
        <match lemma="auto" tags="n.*"/>
        <match lemma="automobile" tags="n.*"/>
        <match lemma="camion" tags="n.*"/>
        <match lemma="car" tags="n.*"/>
        <match lemma="autocar" tags="n.*"/>
        <match lemma="bus" tags="n.*"/>
        <match lemma="autobus" tags="n.*"/>
        <match lemma="moto" tags="n.*"/>
        <match lemma="motocyclette" tags="n.*"/>
        <match lemma="char" tags="n.*"/>
        <match lemma="charrette" tags="n.*"/>
      </or>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="véhicule" tags="n.*"/>
        <match lemma="voiture" tags="n.*"/>
        <match lemma="auto" tags="n.*"/>
        <match lemma="automobile" tags="n.*"/>
        <match lemma="camion" tags="n.*"/>
        <match lemma="car" tags="n.*"/>
        <match lemma="bus" tags="n.*"/>
        <match lemma="autobus" tags="n.*"/>
        <match lemma="moto" tags="n.*"/>
        <match lemma="motocyclette" tags="n.*"/>
        <match lemma="char" tags="n.*"/>
        <match lemma="charrette" tags="n.*"/>
      </or>
      <repeat from="0" upto="4">
        <or>
          <match tags="cm"/>
          <match tags="adv"/>
          <match tags="preadv"/>
          <match tags="adj.*"/>
          <match tags="cnjcoo"/>
        </or>
      </repeat>
      <or>
        <match lemma="conduire" tags="vblex.*"><select lemma="menar"/></match>
        <match lemma="conduire" tags="vblex.*"><select lemma="miar"/></match>
      </or>
    </rule>

    <!-- faufiler >> filbastar, engulhar -->
    <macro n="verb_nopron_pron"><with-param v="faufiler"/><with-param v="filbastar"/><with-param v="engulhar"/></macro>

    <!-- tourner >> virar, rodar -->
    <rule weight="0.8">
      <match lemma="tourner" tags="vblex.*"><select lemma="virar"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="tourner" tags="vblex.*"><select lemma="rodar"/></match>
      <repeat from="0" upto="1">
        <match tags="adv"/>
      </repeat>
      <match tags="det.*"/>
      <match lemma="film" tags="n.*"/>
    </rule>

    <!-- fourrer >> forrar, garnir, encapiar -->
    <rule weight="0.8">
      <match lemma="fourrer" tags="vblex.*"><select lemma="forrar"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="fourrer" tags="vblex.*"><select lemma="garnir"/></match>
      <repeat from="0" upto="6">
        <or>
          <match tags="*"/>
          <match tags=""/>
        </or>
      </repeat>
      <or>
        <match lemma="ravioli" tags="n.*"/>
        <match lemma="biscuit" tags="n.*"/>
        <match lemma="crème" tags="n.*"/>
        <match lemma="pâte" tags="n.*"/>
        <match lemma="raisin" tags="n.*"/>
        <match lemma="raisin sec" tags="n.*"/>
        <match lemma="pignon" tags="n.*"/>
        <match lemma="amande" tags="n.*"/>
        <match lemma="prune" tags="n.*"/>
        <match lemma="épinard" tags="n.*"/>
      </or>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="ravioli" tags="n.*"/>
        <match lemma="biscuit" tags="n.*"/>
        <match lemma="crème" tags="n.*"/>
        <match lemma="pâte" tags="n.*"/>
        <match lemma="raisin" tags="n.*"/>
        <match lemma="raisin sec" tags="n.*"/>
        <match lemma="pignon" tags="n.*"/>
        <match lemma="amande" tags="n.*"/>
        <match lemma="prune" tags="n.*"/>
        <match lemma="épinard" tags="n.*"/>
      </or>
      <repeat from="0" upto="6">
        <or>
          <match tags="*"/>
          <match tags=""/>
        </or>
      </repeat>
      <match lemma="fourrer" tags="vblex.*"><select lemma="garnir"/></match>
    </rule>
    <rule weight="1.2">
      <match lemma="fourrer" tags="vblex.*"><select lemma="encapiar"/></match>
      <repeat from="0" upto="6">
        <or>
          <match tags="*"/>
          <match tags=""/>
        </or>
      </repeat>
      <match lemma="dans" tags="pr"/>
      <match tags="det.*"/>
      <or>
        <match lemma="crâne" tags="n.*"/>
        <match lemma="tête" tags="n.*"/>
      </or>
    </rule>

    <!-- couler >> rajar/colar, s'enfonsar/colar, enfonsar/ahonar -->
    <rule weight="0.8">
      <match lemma="couler" tags="vblex.*"><select lemma="rajar"/></match>
    </rule>
    <rule weight="0.9">
      <match lemma="couler" tags="vblex.*"><select lemma="colar"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <seq n="navire"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="couler" tags="vblex.*"><select lemma="enfonsar" tags="vblex.pron.*"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <seq n="navire"/>
      </or>
      <match tags="vbhaver.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="couler" tags="vblex.*"><select lemma="enfonsar" tags="vblex.pron.*"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <seq n="navire"/>
      </or>
      <match tags="adv"/>
      <match tags="vbhaver.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="couler" tags="vblex.*"><select lemma="enfonsar" tags="vblex.pron.*"/></match>
    </rule>
    <rule weight="1.2">
      <match lemma="couler" tags="vblex.*"><select lemma="enfonsar" tags="vblex.nopron.*"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match tags="det.*"/>
    </rule>
    <rule weight="1.2">
      <match lemma="couler" tags="vblex.*"><select lemma="enfonsar" tags="vblex.nopron.*"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="par" tags="pr"/>
    </rule>
    <rule weight="1.2">
      <match lemma="couler" tags="vblex.*"><select lemma="ahonar"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match tags="det.*"/>
    </rule>
    <rule weight="1.2">
      <match lemma="couler" tags="vblex.*"><select lemma="ahonar"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="par" tags="pr"/>
    </rule>

    <!-- décoller >> despegar, enlairar -->
    <macro n="verb_intrans_trans"><with-param v="décoller"/><with-param v="enlairar"/><with-param v="despegar"/></macro>

    <!-- déplafonner >> arrestar# la limitacion, arrestar# la limitacion de -->
    <macro n="verb_intrans_trans"><with-param v="déplafonner"/><with-param v="arrestar# la limitacion"/><with-param v="arrestar# la limitacion de"/></macro>

    <!-- gronder >> bronzir, cridar -->
    <macro n="verb_intrans_trans"><with-param v="gronder"/><with-param v="bronzir"/><with-param v="cridar"/></macro>
    <rule weight="1.2">
      <or>
        <seq n="personne"/>
        <seq n="parent"/>
      </or>
      <repeat from="0" upto="1">
        <match tags="adv"/>
      </repeat>
      <repeat from="0" upto="2">
        <match tags="prn.pro.*"/>
      </repeat>
      <match lemma="gronder" tags="vblex.*"><select lemma="cridar"/></match>
    </rule>

    <!-- souvenir >> recordar, rebrembar -->
    <macro n="verb_nopron_pron"><with-param v="souvenir"/><with-param v="recordar"/><with-param v="rebrembar"/></macro>

    <!-- décortiquer -> descloscar, derruscar, destecar -->
    <rule weight="0.8">
      <match lemma="décortiquer" tags="vblex.*"><select lemma="descloscar"/></match>
    </rule>

    <!-- voler >> volar / raubar -->
    <rule weight="0.8">
      <match lemma="voler" tags="vblex.*"><select lemma="volar"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="voler" tags="vblex.pp.*"><select lemma="raubar"/></match>
    </rule>
    <rule weight="1.0">
      <match tags="prn.pro.*"/>
      <match lemma="voler" tags="vblex.pp.*"><select lemma="raubar"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="voler" tags="vblex.*"><select lemma="raubar"/></match>
      <repeat from="0" upto="2">
        <or>
          <match tags="adv"/>
          <match tags="cnjadv"/>
        </or>
      </repeat>
      <match tags="det.*"/>
    </rule>
    <rule weight="1.0">
      <match lemma="voler" tags="vblex.*"><select lemma="raubar"/></match>
      <repeat from="0" upto="2">
        <or>
          <match tags="adv"/>
          <match tags="cnjadv"/>
        </or>
      </repeat>
      <match lemma="de" tags="pr"/>
      <match tags="det.*"/>
    </rule>
    <rule weight="1.0">
      <match lemma="voler" tags="vblex.*"><select lemma="raubar"/></match>
      <match tags="adv"/>
      <repeat from="0" upto="2">
        <or>
          <match tags="adv"/>
          <match tags="cnjadv"/>
        </or>
      </repeat>
      <match lemma="de" tags="pr"/>
      <or>
        <match tags="n.*.pl"/>
        <match tags="adj.*.pl"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match lemma="voler" tags="vblex.*"><select lemma="raubar"/></match>
      <repeat from="0" upto="2">
        <or>
          <match tags="adv"/>
          <match tags="cnjadv"/>
        </or>
      </repeat>
      <match tags="prn.tn.*"/>
    </rule>


    <!-- distraire >> divertir/destorbar -->
    <macro n="verb_nopron_pron"><with-param v="distraire"/><with-param v="destorbar"/><with-param v="divertir"/></macro>

    <!-- foncer >> (ar)ronçar/escurcir -->
    <macro n="verb_intrans_trans"><with-param v="foncer"/><with-param v="ronçar"/><with-param v="escurir"/></macro>

    <!-- repérer >> localizar/senhalar -->
    <rule weight="0.8">
        <match lemma="repérer" tags="vblex.*"><select lemma="localizar"/></match>
    </rule>

    <!-- recouper >> retalhar, concordar -->
    <macro n="verb_nopron_pron"><with-param v="recouper"/><with-param v="retalhar"/><with-param v="concordar"/></macro>

    <!-- découper >> destacar, copar -->
    <macro n="verb_nopron_pron"><with-param v="découper"/><with-param v="copar"/><with-param v="destacar"/></macro>

    <!-- rendre >> tornar, aller, far venir/har vàder, venir/vàder -->
    <rule weight="0.8">
        <match lemma="rendre" tags="vblex.*"><select lemma="tornar"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="me" tags="prn.pro.*"/>
        <match lemma="te" tags="prn.pro.*"/>
        <match lemma="se" tags="prn.pro.*"/>
        <match lemma="nos" tags="prn.pro.*"/>
        <match lemma="vos" tags="prn.pro.*"/>
      </or>
      <repeat from="0" upto="3">
        <or>
        <match tags="vbser.*"/>
        <match tags="adv"/>
        </or>
      </repeat>
      <match lemma="rendre" tags="vblex.*"><select lemma="anar"/></match>
      <repeat from="0" upto="2">
      <match tags="adv"/>
      </repeat>
      <or>
        <match lemma="à" tags="pr"/>
        <match lemma="sur" tags="pr"/>
        <match lemma="vers" tags="pr"/>
        <match lemma="chez" tags="pr"/>
        <match lemma="dans" tags="pr"/>
        <match lemma="chez moi" tags="adv"/>
        <match lemma="chez toi" tags="adv"/>
        <match lemma="chez lui" tags="adv"/>
        <match lemma="chez elle" tags="adv"/>
        <match lemma="chez nous" tags="adv"/>
        <match lemma="chez vous" tags="adv"/>
        <match lemma="chez eux" tags="adv"/>
        <match lemma="chez elles" tags="adv"/>
        <match lemma="chez soi" tags="adv"/>
        <match lemma="à la maison" tags="adv"/>
      </or>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="me" tags="prn.pro.*"/>
        <match lemma="te" tags="prn.pro.*"/>
        <match lemma="se" tags="prn.pro.*"/>
        <match lemma="nos" tags="prn.pro.*"/>
        <match lemma="vos" tags="prn.pro.*"/>
      </or>
      <repeat from="0" upto="3">
        <or>
        <match tags="vbser.*"/>
        <match tags="adv"/>
        </or>
      </repeat>
      <match lemma="rendre" tags="vblex.*"><select lemma="anar"/></match>
      <match lemma="en" tags="pr"/>
      <or>
        <match tags="np.top.*"/>
        <match tags="" case="Aa"/>
      </or>
    </rule>

    <!-- vantar >> vanter, louer -->
    <macro n="verb_nopron_pron"><with-param v="vantar"/><with-param v="louer"/><with-param v="vanter"/></macro>

    <!-- borner >> bornar, limitar -->
    <macro n="verb_nopron_pron"><with-param v="borner"/><with-param v="bornar"/><with-param v="limitar"/></macro>

    <!-- viser >> mirar, visar -->
    <rule weight="0.8">
        <match lemma="viser" tags="vblex.*"><select lemma="mirar"/></match>
    </rule>

    <!-- gronder ->  cridar, bronzir/bronir-->
    <rule weight="1.0">
      <match tags="prn.pro.*"/>
      <match lemma="gronder" tags="vblex.*"><select lemma="cridar"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="gronder" tags="vblex.*"><select lemma="cridar"/></match>
      <match tags="det.*"/>
    </rule>
    <rule weight="1.0">
      <match lemma="gronder" tags="vblex.*"><select lemma="cridar"/></match>
      <match tags="np.*"/>
    </rule>
  </rules>
</lrx>

