<?xml version="1.0" encoding="UTF-8"?>
<lrx>
  <rules>
  <!-- Règlas per evitar la traduccion d'un mot dempuèi una autra varietat -->
<rule weight="0.8">
 <match lemma="lo" tags="prn.*"><select lemma="le"/></match>
</rule>
<rule weight="0.8">
 <match lemma="lo" tags="prn.*"><select lemma="le"/></match>
</rule>
<rule weight="0.8">
 <match lemma="lo" tags="prn.*"><select lemma="le"/></match>
</rule>




  </rules>
</lrx>

