<?xml version="1.0" encoding="UTF-8"?>
<lrx>
  <def-seqs>
  </def-seqs>

  <rules>
    <!-- police >> polícia/policia, polissa -->
    <rule weight="0.8">
      <match lemma="police" tags="n.*"><select lemma="policia"/></match>
    </rule>
  </rules>
</lrx>

