<?xml version="1.0" encoding="UTF-8"?>
<lrx>
  <def-seqs>
  </def-seqs>

  <rules>
    <!-- **************** N **************** -->
    
    <!-- police >> polícia/policia, polissa -->
    <rule weight="0.8">
      <match lemma="police" tags="n.*"><select lemma="policia"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="police" tags="n.*"><select lemma="polissa"/></match>
      <repeat from="0" upto="6">
        <or>
          <match tags="*"/>
          <match tags=""/>
        </or>
      </repeat>
      <or>
        <match lemma="assurance" tags="n.*"/>
        <match lemma="écriture" tags="n.*"/>
        <match lemma="caractère" tags="n.*"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match lemma="police" tags="n.*"><select lemma="polissa"/></match>
      <or>
        <match lemma="gras" tags="adj.*"/>
        <match lemma="italique" tags="adj.*"/>
        <match lemma="souligné" tags="adj.*"/>
      </or>
    </rule>

    <!-- père >> paire, mossen -->
    <rule weight="0.8">
      <match lemma="père" tags="n.*"><select lemma="paire"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="père" tags="n.*"><select lemma="mossen"/></match>
      <match tags="np.ant.*"/>
    </rule>
  </rules>
</lrx>

<!--
Resources:
    https://wiki.apertium.org/wiki/How_to_get_started_with_lexical_selection_rules
    https://wiki.apertium.org/wiki/Constraint-based_lexical_selection
    https://wiki.apertium.org/wiki/Lexical_selection
    https://wiki.apertium.org/wiki/Learning_rules_from_parallel_and_non-parallel_corpora
-->
