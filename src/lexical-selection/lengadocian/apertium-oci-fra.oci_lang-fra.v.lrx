    </rule>
    <rule weight="1.0">
      <match lemma="far# mestièr" tags="vblex.*"><select lemma="tenir# lieu"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="de" tags="pr"/>
      <or>
        <match tags="n.*.sg"/>
        <match tags="adj.*.sg"/>
      </or>
    </rule>
    <rule weight="1.2">
      <or>
        <seq n="prn_ci"/>
      </or>
      <match lemma="far# mestièr" tags="vblex.*"><select lemma="avoir# besoin"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="de" tags="pr"/>
      <or>
        <match tags="n.*.sg"/>
        <match tags="adj.*.sg"/>
      </or>
    </rule>
    <rule weight="1.0">
      <or>
        <seq n="prn_ci"/>
      </or>
      <match lemma="far# mestièr" tags="vblex.*"><select lemma="avoir# besoin de"/></match>
      <repeat from="0" upto="2">
        <or>
        <match tags="adv"/>
        <match tags="prn.pro.*"/>
        </or>
      </repeat>
      <match tags="*.inf"/>
    </rule>

    <!-- quitar >> quitter, arrêter -->
    <rule weight="0.8">
      <match lemma="quitar" tags="vblex.*"><select lemma="quitter"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="quitar" tags="vblex.*"><select lemma="arrêter"/></match>
      <repeat from="0" upto="2">
        <or>
          <match tags="adv"/>
          <match tags="preadv"/>
        </or>
      </repeat>
      <match lemma="de" tags="pr"/>
    </rule>

    <!-- mutar >> muter, parler -->
    <rule weight="0.8">
      <match lemma="mutar" tags="vblex.*"><select lemma="muter"/></match>
    </rule>
    <rule weight="0.8">
      <match lemma="sens" tags="pr"/>
      <match lemma="mutar" tags="vblex.*"><select lemma="parler"/></match>
    </rule>

    <!-- rajar >> couler, rayonner -->
    <rule weight="0.8">
      <match lemma="rajar" tags="vblex.*"><select lemma="couler"/></match>
    </rule>
  </rules>
</lrx>

