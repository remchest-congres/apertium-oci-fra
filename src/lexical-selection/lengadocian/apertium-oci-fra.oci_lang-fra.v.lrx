      <match lemma="zapatista" tags="n.*"/>
      <match lemma="zoologista" tags="n.*"/>
      <match lemma="zutista" tags="n.*"/>

      <match lemma="allergològue" tags="n.*"/>
      <match lemma="andrològue" tags="n.*"/>
      <match lemma="angiològue" tags="n.*"/>
      <match lemma="antropològue" tags="n.*"/>
      <match lemma="apològue" tags="n.*"/>
      <match lemma="arqueològue" tags="n.*"/>
      <match lemma="astrològue" tags="n.*"/>
      <match lemma="bacteriològue" tags="n.*"/>
      <match lemma="bibliològue" tags="n.*"/>
      <match lemma="biològue" tags="n.*"/>
      <match lemma="briològue" tags="n.*"/>
      <match lemma="cancerològue" tags="n.*"/>
      <match lemma="cardiològue" tags="n.*"/>
      <match lemma="climatològue" tags="n.*"/>
      <match lemma="colagògue" tags="n.*"/>
      <match lemma="cosmològue" tags="n.*"/>
      <match lemma="criminològue" tags="n.*"/>
      <match lemma="demagògue" tags="n.*"/>
      <match lemma="dermatològue" tags="n.*"/>
      <match lemma="dialectològue" tags="n.*"/>
      <match lemma="egiptològue" tags="n.*"/>
      <match lemma="ematològue" tags="n.*"/>
      <match lemma="endocrinològue" tags="n.*"/>
      <match lemma="enològue" tags="n.*"/>
      <match lemma="epatològue" tags="n.*"/>
      <match lemma="epistemològue" tags="n.*"/>
      <match lemma="espeleològue" tags="n.*"/>
      <match lemma="estomatològue" tags="n.*"/>
      <match lemma="esturlògue" tags="n.*"/>
      <match lemma="etnològue" tags="n.*"/>
      <match lemma="farmacològue" tags="n.*"/>
      <match lemma="fenomenològue" tags="n.*"/>
      <match lemma="filològue" tags="n.*"/>
      <match lemma="fisiològue" tags="n.*"/>
      <match lemma="flebològue" tags="n.*"/>
      <match lemma="fonològue" tags="n.*"/>
      <match lemma="frenològue" tags="n.*"/>
      <match lemma="ftisiològue" tags="n.*"/>
      <match lemma="futurològue" tags="n.*"/>
      <match lemma="gastroenterològue" tags="n.*"/>
      <match lemma="gemmològue" tags="n.*"/>
      <match lemma="geològue" tags="n.*"/>
      <match lemma="geomorfològue" tags="n.*"/>
      <match lemma="gerontològue" tags="n.*"/>
      <match lemma="ginecològue" tags="n.*"/>
      <match lemma="grafològue" tags="n.*"/>
      <match lemma="ictiològue" tags="n.*"/>
      <match lemma="ideològue" tags="n.*"/>
      <match lemma="idrològue" tags="n.*"/>
      <match lemma="immunològue" tags="n.*"/>
      <match lemma="iridològue" tags="n.*"/>
      <match lemma="islamològue" tags="n.*"/>
      <match lemma="lexicològue" tags="n.*"/>
      <match lemma="marxològue" tags="n.*"/>
      <match lemma="meteorològue" tags="n.*"/>
      <match lemma="micològue" tags="n.*"/>
      <match lemma="mistagògue" tags="n.*"/>
      <match lemma="mitològue" tags="n.*"/>
      <match lemma="museològue" tags="n.*"/>
      <match lemma="musicològue" tags="n.*"/>
      <match lemma="nefrològue" tags="n.*"/>
      <match lemma="neurològue" tags="n.*"/>
      <match lemma="nivològue" tags="n.*"/>
      <match lemma="oceanològue" tags="n.*"/>
      <match lemma="odontològue" tags="n.*"/>
      <match lemma="oftalmològue" tags="n.*"/>
      <match lemma="omològue" tags="n.*"/>
      <match lemma="oncològue" tags="n.*"/>
      <match lemma="onirològue" tags="n.*"/>
      <match lemma="ornitològue" tags="n.*"/>
      <match lemma="otorinolaringològue" tags="n.*"/>
      <match lemma="paleològue" tags="n.*"/>
      <match lemma="paleontològue" tags="n.*"/>
      <match lemma="palinològue" tags="n.*"/>
      <match lemma="papirològue" tags="n.*"/>
      <match lemma="patològue" tags="n.*"/>
      <match lemma="pedagògue" tags="n.*"/>
      <match lemma="pedològue" tags="n.*"/>
      <match lemma="pneumològue" tags="n.*"/>
      <match lemma="podològue" tags="n.*"/>
      <match lemma="politològue" tags="n.*"/>
      <match lemma="pomològue" tags="n.*"/>
      <match lemma="proctològue" tags="n.*"/>
      <match lemma="psicològue" tags="n.*"/>
      <match lemma="radiològue" tags="n.*"/>
      <match lemma="raumatològue" tags="n.*"/>
      <match lemma="rumatològue" tags="n.*"/>
      <match lemma="semiològue" tags="n.*"/>
      <match lemma="sexològue" tags="n.*"/>
      <match lemma="sialagògue" tags="n.*"/>
      <match lemma="sidològue" tags="n.*"/>
      <match lemma="sinològue" tags="n.*"/>
      <match lemma="sismològue" tags="n.*"/>
      <match lemma="sitològue" tags="n.*"/>
      <match lemma="sociològue" tags="n.*"/>
      <match lemma="sovietològue" tags="n.*"/>
      <match lemma="tecnològue" tags="n.*"/>
      <match lemma="teratològue" tags="n.*"/>
      <match lemma="toxicològue" tags="n.*"/>
      <match lemma="traumatològue" tags="n.*"/>
      <match lemma="urològue" tags="n.*"/>
      <match lemma="virològue" tags="n.*"/>
      <match lemma="vulcanològue" tags="n.*"/>
    </or></def-seq>
  </def-seqs>

  <rules>
    <!-- **************** VBLEX **************** -->

    <!-- téner >> tenir, tendre -->
    <rule weight="0.8">
      <match lemma="téner" tags="vblex.*"><select lemma="tenir"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="téner" tags="vblex.*"><select lemma="tendre"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <repeat from="0" upto="2">
        <or>
          <match lemma="de" tags="pr"/>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <or>
        <match lemma="tenda" tags="n.*"/>
        <match lemma="trapèla" tags="n.*"/>
        <match lemma="tracanard" tags="n.*"/>
      </or>
    </rule>

    <!-- embolhar -> embrouiller, brouiller -->
    <rule weight="0.8">
      <match lemma="embolhar" tags="vblex.*"><select lemma="embrouiller"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="embolhar" tags="vblex.*"><select lemma="brouiller"/></match>
      <repeat from="1" upto="4">
        <or>
          <match tags="adv"/>
          <match tags="preadv"/>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="num"/>
          <match tags="adj.*"/>
          <match lemma="de" tags="pr"/>
        </or>
      </repeat>
      <or>
        <match lemma="emission" tags="n.*"/>
        <match lemma="transmission" tags="n.*"/>
        <match lemma="comunicacion" tags="n.*"/>
        <match lemma="messatge" tags="n.*"/>
        <match lemma="senhal" tags="n.*"/>
        <match lemma="radar" tags="n.*"/>
        <match lemma="telefòne" tags="n.*"/>
        <match lemma="telefon" tags="n.*"/>
      </or>
    </rule>

    <!-- armar >> armer, tendre -->
    <rule weight="0.8">
      <match lemma="armar" tags="vblex.*"><select lemma="armer"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="armar" tags="vblex.*"><select lemma="tendre"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <repeat from="0" upto="2">
        <or>
          <match lemma="de" tags="pr"/>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <or>
        <match lemma="tenda" tags="n.*"/>
        <match lemma="trapèla" tags="n.*"/>
        <match lemma="tracanard" tags="n.*"/>
      </or>
    </rule>

    <!-- preparar >> préparer, tendre -->
    <rule weight="0.8">
      <match lemma="preparar" tags="vblex.*"><select lemma="préparer"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="preparar" tags="vblex.*"><select lemma="tendre"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <repeat from="0" upto="2">
        <or>
          <match lemma="de" tags="pr"/>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <or>
        <match lemma="emboscada" tags="n.*"/>
        <match lemma="embuscada" tags="n.*"/>
      </or>
    </rule>

    <!-- aisir >> faciliter, mettre# à l'aise -->
    <macro n="verb_nopron_pron"><with-param v="aisir"/><with-param v="faciliter"/><with-param v="mettre# à l'aise"/></macro>

    <!-- aisinar >> faciliter, mettre# à l'aise -->
    <macro n="verb_nopron_pron"><with-param v="aisinar"/><with-param v="faciliter"/><with-param v="mettre# à l'aise"/></macro>

    <!-- aprigondir >> approfondir, creuser -->
    <macro n="verb_nopron_pron"><with-param v="aprigondir"/><with-param v="approfondir"/><with-param v="creuser"/></macro>

    <!-- escridassar >> huer, égosiller/écrier -->
    <macro n="verb_nopron_pron"><with-param v="escridassar"/><with-param v="huer"/><with-param v="égosiller"/></macro>

    <!-- gandir -> préserver/garantir, prémunir -->
    <macro n="verb_nopron_pron"><with-param v="gandir"/><with-param v="préserver"/><with-param v="prémunir"/></macro>

    <!-- amassar >> amasser, rassembler/réunir -->
    <rule weight="0.8">
      <match lemma="amassar" tags="vblex.*"><select lemma="amasser"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <seq n="personas"/>
      </or>
      <repeat from="0" upto="2">
        <or>
          <match tags="adj.*"/>
          <match tags="adv"/>
          <match tags="preadv"/>
        </or>
      </repeat>
      <repeat from="0" upto="1">
        <match tags="prn.pro.ref.*"/>
      </repeat>
      <match lemma="amassar" tags="vblex.*"><select lemma="rassembler"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="amassar" tags="vblex.*"><select lemma="rassembler"/></match>
      <repeat from="0" upto="4">
        <or>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="adj.*"/>
          <match tags="adv"/>
          <match tags="preadv"/>
          <match lemma="de" tags="pr"/>
        </or>
      </repeat>
      <or>
        <seq n="personas"/>
        <match lemma="país" tags="n.*"/>
        <match lemma="region" tags="n.*"/>
        <match lemma="vila" tags="n.*"/>
        <match lemma="parlament" tags="n.*"/>
        <match lemma="senat" tags="n.*"/>
        <match lemma="tribunal" tags="n.*"/>
        <match lemma="congrès" tags="n.*"/>
        <match lemma="amassada" tags="n.*"/>
        <match lemma="assamblada" tags="n.*"/>
        <match lemma="conselh" tags="n.*"/>
      </or>
    </rule>

    <!-- alludir >> faire# allusion, avoir# allusion à -->
    <macro n="verb_intrans_trans"><with-param v="alludir"/><with-param v="faire# allusion"/><with-param v="faire# allusion à"/></macro>

    <!-- en·horatar >> blouser, terrer -->
    <macro n="verb_intrans_trans"><with-param v="en·horatar"/><with-param v="blouser"/><with-param v="terrer"/></macro>

    <!-- prémer >> appuyer, appuyer# sur -->
    <macro n="verb_intrans_trans"><with-param v="prémer"/><with-param v="appuyer"/><with-param v="appuyer# sur"/></macro>

    <!-- priorizar >> donner# la priorité, donner# la priorité à -->
    <macro n="verb_intrans_trans"><with-param v="priorizar"/><with-param v="donner# la priorité"/><with-param v="donner# la priorité à"/></macro>

    <!-- vetar >> mettre# son veto, mettre# son veto à -->
    <macro n="verb_intrans_trans"><with-param v="vetar"/><with-param v="mettre# son veto"/><with-param v="mettre# son veto à"/></macro>

    <!-- tombar >> tomber, faire# tomber -->
    <macro n="verb_intrans_trans"><with-param v="tombar"/><with-param v="tomber"/><with-param v="faire# tomber"/></macro>
    <rule weight="1.2">
      <or>
        <match tags="vbser.*"/>
        <match lemma="semblar" tags="vblex.*"/>
        <match lemma="paréisser" tags="vblex.*"/>
        <match lemma="paréisher" tags="vblex.*"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="tombar" tags="vblex.pp.*"><select lemma="tomber"/></match>
    </rule>
    <rule weight="1.2">
      <or>
        <match tags="vbser.*"/>
        <match lemma="daissar" tags="vblex.*"/>
        <match lemma="laissar" tags="vblex.*"/>
        <match lemma="deishar" tags="vblex.*"/>
        <match lemma="leishar" tags="vblex.*"/>
        <match lemma="far" tags="vblex.*"/>
        <match lemma="har" tags="vblex.*"/>
        <match lemma="hèr" tags="vblex.*"/>
        <match lemma="hèser" tags="vblex.*"/>
        <match lemma="faire" tags="vblex.*"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="tombar" tags="vblex.inf"><select lemma="tomber"/></match>
    </rule>
    <rule weight="1.2">
      <match tags="vbhaver.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="tombar" tags="vblex.pp.*"><select lemma="faire# tomber"/></match>
    </rule>
    <rule weight="1.2">
      <or>
        <match tags="n.*"/>
        <match tags="adj.*"/>
        <match tags="vblex.pp.*"/>
      </or>
      <repeat from="0" upto="2">
      <or>
          <match tags="preadv"/>
          <match tags="adv"/>
      </or>
      </repeat>
      <match lemma="tombar" tags="vblex.pp.*"><select lemma="tomber"/></match>
    </rule>

    <!-- cargar >> charger, mettre (leng) -->
    <!-- passar >> passar, mettre (gascon) -->
    <rule weight="0.8">
      <match lemma="cargar" tags="vblex.*"><select lemma="charger"/></match>
    </rule>

    <rule weight="1.0">
      <match tags="prn.pro.p1.*.sg"/>
      <repeat from="0" upto="1">
        <match tags="prn.pro.*"/>
      </repeat>
      <match lemma="cargar" tags="vblex.*.p1.sg"><select lemma="mettre"/></match>
      <repeat from="0" upto="3">
        <or>
          <match lemma="de" tags="pr"/>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="preadv"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <or>
        <seq n="vestit"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match lemma="cargar" tags="vblex.*.p1.sg"><select lemma="mettre"/></match>
      <match tags="prn.enc.p1.*.sg"/>
      <repeat from="0" upto="3">
        <or>
          <match lemma="de" tags="pr"/>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="preadv"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <or>
        <seq n="vestit"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match tags="prn.pro.p2.*.sg"/>
      <repeat from="0" upto="1">
        <match tags="prn.pro.*"/>
      </repeat>
      <match lemma="cargar" tags="vblex.*.p2.sg"><select lemma="mettre"/></match>
      <repeat from="0" upto="3">
        <or>
          <match lemma="de" tags="pr"/>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="preadv"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <or>
        <seq n="vestit"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match lemma="cargar" tags="vblex.*.p2.sg"><select lemma="mettre"/></match>
      <match tags="prn.enc.p2.*.sg"/>
      <repeat from="0" upto="3">
        <or>
          <match lemma="de" tags="pr"/>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="preadv"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <or>
        <seq n="vestit"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match tags="prn.pro.ref.p3.*.sp"/>
      <repeat from="0" upto="1">
        <match tags="prn.pro.*"/>
      </repeat>
      <or>
        <match lemma="cargar" tags="vblex.*.p3.sg"><select lemma="mettre"/></match>
        <match lemma="cargar" tags="vblex.*.p3.pl"><select lemma="mettre"/></match>
        <match lemma="cargar" tags="vblex.inf"><select lemma="mettre"/></match>
        <match lemma="cargar" tags="vblex.ger"><select lemma="mettre"/></match>
      </or>
      <repeat from="0" upto="3">
        <or>
          <match lemma="de" tags="pr"/>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="preadv"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <or>
        <seq n="vestit"/>
      </or>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="cargar" tags="vblex.*.p3.sg"><select lemma="mettre"/></match>
        <match lemma="cargar" tags="vblex.*.p3.pl"><select lemma="mettre"/></match>
        <match lemma="cargar" tags="vblex.inf"><select lemma="mettre"/></match>
        <match lemma="cargar" tags="vblex.ger"><select lemma="mettre"/></match>
      </or>
      <match tags="prn.enc.ref.p3.*.sp"/>
      <repeat from="0" upto="3">
        <or>
          <match lemma="de" tags="pr"/>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="preadv"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <or>
        <seq n="vestit"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match tags="prn.pro.p1.*.pl"/>
      <repeat from="0" upto="1">
        <match tags="prn.pro.*"/>
      </repeat>
      <match lemma="cargar" tags="vblex.*.p1.pl"><select lemma="mettre"/></match>
      <repeat from="0" upto="3">
        <or>
          <match lemma="de" tags="pr"/>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="preadv"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <or>
        <seq n="vestit"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match lemma="cargar" tags="vblex.*.p1.pl"><select lemma="mettre"/></match>
      <match tags="prn.enc.p1.*.pl"/>
      <repeat from="0" upto="3">
        <or>
          <match lemma="de" tags="pr"/>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="preadv"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <or>
        <seq n="vestit"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match tags="prn.pro.p2.*.pl"/>
      <repeat from="0" upto="1">
        <match tags="prn.pro.*"/>
      </repeat>
      <match lemma="cargar" tags="vblex.*.p2.pl"><select lemma="mettre"/></match>
      <repeat from="0" upto="3">
        <or>
          <match lemma="de" tags="pr"/>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="preadv"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <or>
        <seq n="vestit"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match lemma="cargar" tags="vblex.*.p2.pl"><select lemma="mettre"/></match>
      <match tags="prn.enc.p2.*.pl"/>
      <repeat from="0" upto="3">
        <or>
          <match lemma="de" tags="pr"/>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="preadv"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <or>
        <seq n="vestit"/>
      </or>
    </rule>

    <rule weight="1.0">
      <match tags="vbser.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="cargar" tags="vblex.pp.*"><select lemma="mettre"/></match>
      <repeat from="0" upto="3">
        <or>
          <match lemma="de" tags="pr"/>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="preadv"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <or>
        <seq n="vestit"/>
      </or>
    </rule>

    <!-- dòler >> faire# mal, avoir# mal à -->
    <rule weight="0.8">
      <match lemma="dòler" tags="vblex.*"><select lemma="faire# mal"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="dòler" tags="vblex.*"><select lemma="avoir# mal à"/></match>
      <repeat from="0" upto="2">
        <or>
          <match tags="det.*"/>
          <match tags="num.*"/>
        </or>
      </repeat>
      <or>
        <seq n="partidas_cos"/>
      </or>
    </rule>

    <!-- dòler# de >> souffrir# de, avoir# mal à -->
    <rule weight="0.8">
      <match lemma="dòler# de" tags="vblex.*"><select lemma="souffrir# de"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="dòler# de" tags="vblex.*"><select lemma="avoir# mal à"/></match>
      <repeat from="0" upto="2">
        <or>
          <match tags="det.*"/>
          <match tags="num.*"/>
        </or>
      </repeat>
      <or>
        <seq n="partidas_cos"/>
      </or>
    </rule>

    <!-- mancar >> manquer, rater, faillir, brouiller, falloir -->
    <macro n="verb_nopron_pron"><with-param v="mancar"/><with-param v="manquer"/><with-param v="brouiller"/></macro>
    <rule weight="2.0">
      <match tags="n.*"/>
      <repeat from="0" upto="2">
        <or>
          <match tags="adj.*"/>
          <match tags="preadv"/>
          <match tags="adv"/>
        </or>
      </repeat>
      <match lemma="mancar" tags="vblex.pp.*"><select lemma="manquer"/></match>
    </rule>
    <rule weight="2.0">
      <match lemma="se" tags="prn.pro.*"/>
      <match lemma="ne" tags="prn.pro.*"/>
      <match lemma="mancar" tags="vblex.*"><select lemma="falloir"/></match>
    </rule>
    <rule weight="2.0">
      <match lemma="mancar" tags="vblex.*"><select lemma="rater"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="de" tags="pr"/>
      <or><match tags="vblex.inf"/><match tags="vblex.tv.inf"/><match tags="vbser.inf"/><match tags="vbhaver.inf"/><match tags="vbmod.inf"/></or>
    </rule>
    <rule weight="2.0">
