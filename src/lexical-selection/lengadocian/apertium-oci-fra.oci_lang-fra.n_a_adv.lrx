  <rules>
    <!-- **************** ADJ **************** -->

    <!-- miei >> demi, moyen -->
    <rule weight="0.8">
      <match lemma="miei" tags="adj.*"><select lemma="demi"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match tags="n.*"/>
        <match tags="np.top.*"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="adj.*"/>
      </repeat>
      <match lemma="miei" tags="adj.*"><select lemma="moyen"/></match>
    </rule>

    <!-- brave >> gentil, bon/gros -->
    <rule weight="0.8">
      <match lemma="brave" tags="adj.*"><select lemma="gentil"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="brave" tags="adj.*"><select lemma="bon"/></match>
      <match tags="n.*"/>
    </rule>
    <rule weight="1.2">
      <match lemma="brave" tags="adj.*"><select lemma="gentil"/></match>
      <or>
        <seq n="personas"/>
      </or>
    </rule>

    <!-- vertadièr >> vrai, véritable -->
    <rule weight="0.8">
      <match lemma="vertadièr" tags="adj.*"><select lemma="vrai"/></match>
    </rule>

    <!-- nòu >> nouveau, neuf -->
    <rule weight="0.8">
      <match lemma="nòu" tags="adj.*"><select lemma="nouveau"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <seq n="vestit"/>
        <match lemma="ostal" tags="n.*"/>
        <match lemma="apartament" tags="n.*"/>
        <match lemma="immòble" tags="n.*"/>
        <match lemma="bastiment" tags="n.*"/>
        <match lemma="infraestructura" tags="n.*"/>
        <match lemma="cambra" tags="n.*"/>
        <match lemma="veitura" tags="n.*"/>
        <match lemma="autò" tags="n.*"/>
        <match lemma="auto" tags="n.*"/>
        <match lemma="automobila" tags="n.*"/>
        <match lemma="bicicleta" tags="n.*"/>
        <match lemma="moto" tags="n.*"/>
        <match lemma="motò" tags="n.*"/>
        <match lemma="mobileta" tags="n.*"/>
        <match lemma="batèl" tags="n.*"/>
        <match lemma="ordenador" tags="n.*"/>
        <match lemma="telefòne" tags="n.*"/>
        <match lemma="esmartfòne" tags="n.*"/>
        <match lemma="mantèl" tags="n.*"/>
        <match lemma="vèsta" tags="n.*"/>
        <match lemma="tunica" tags="n.*"/>
        <match lemma="castèl" tags="n.*"/>
        <match lemma="vila" tags="n.*"/>
        <match lemma="pòrta" tags="n.*"/>
        <match lemma="material" tags="n.*"/>
      </or>
      <match lemma="nòu" tags="adj.*"><select lemma="neuf"/></match>
    </rule>

    <!-- pebrat >> poivré, grivois -->
    <rule weight="0.8">
      <match lemma="pebrat" tags="adj.*"><select lemma="poivré"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="cançon" tags="n.*"/>
        <match lemma="istòria" tags="n.*"/>
      </or>
      <match lemma="pebrat" tags="adj.*"><select lemma="grivois"/></match>
    </rule>

    <!-- sadol >> repu, saoûl -->
    <rule weight="0.8">
      <match lemma="sadol" tags="adj.*"><select lemma="repu"/></match>
    </rule>

    <!-- **************** N **************** -->

    <!-- glacet >> glaçon, glace-->
    <rule weight="0.8">
      <match lemma="glacet" tags="n.*"><select lemma="glaçon"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="manjar" tags="vblex.*"/>
        <match lemma="minjar" tags="vblex.*"/>
        <match lemma="galapar" tags="vblex.*"/>
        <match lemma="galavardejar" tags="vblex.*"/>
        <match lemma="glotonejar" tags="vblex.*"/>
        <match lemma="lecar" tags="vblex.*"/>
        <match lemma="lepar" tags="vblex.*"/>
        <match lemma="lafrar" tags="vblex.*"/>
      </or>
      <repeat from="0" upto="3">
        <or>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="adj.*"/>
          <match tags="adv"/>
          <match tags="preadv"/>
          <match lemma="de" tags="pr"/>
        </or>
      </repeat>
      <match lemma="glacet" tags="n.*"><select lemma="glace"/></match>
    </rule>

    <!-- batent >> battant, volet -->
    <rule weight="0.8">
      <match lemma="batent" tags="n.*"><select lemma="battant"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="batent" tags="n.*"><select lemma="volet"/></match>
      <or>
        <match lemma="economic" tags="adj.*"/>
        <match lemma="politic" tags="adj.*"/>
        <match lemma="social" tags="adj.*"/>
        <match lemma="cultural" tags="adj.*"/>
        <match lemma="sindical" tags="adj.*"/>
        <match lemma="administratiu" tags="adj.*"/>
        <match lemma="diplomatic" tags="adj.*"/>
        <match lemma="militar" tags="adj.*"/>
        <match lemma="militari" tags="adj.*"/>
        <match lemma="religiós" tags="adj.*"/>
        <match lemma="judicial" tags="adj.*"/>
        <match lemma="penal" tags="adj.*"/>
      </or>
    </rule>

    <!-- sòu >> sou, argent -->
    <rule weight="0.8">
      <match lemma="sòu" tags="n.*"><select lemma="sou"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="sòu" tags="n.m.pl"><select lemma="argent"/></match>
    </rule>
    <rule weight="1.2">
      <or><match tags="num"/><match tags="num.*"/></or>
      <match lemma="sòu" tags="n.*"><select lemma="sou"/></match>
    </rule>

    <!-- charradissa >> causerie, discours -->
    <rule weight="0.8">
      <match lemma="charradissa" tags="n.*"><select lemma="causerie"/></match>
    </rule>

    <!-- dintrada >> entrée, rentrée -->
    <rule weight="0.8">
      <match lemma="dintrada" tags="n.*"><select lemma="entrée"/></match>
    </rule>
    <rule weight="1.1">
      <match lemma="dintrada" tags="n.m.*"><select lemma="rentrée"/></match>
      <repeat from="0" upto="5">
        <or>
          <match tags="*"/>
          <match tags=""/>
        </or>
      </repeat>
      <or>
        <match lemma="escòla" tags="n.*"/>
        <match lemma="collègi" tags="n.*"/>
        <match lemma="licèu" tags="n.*"/>
        <match lemma="pedagogia" tags="n.*"/>
        <match lemma="escolan" tags="n.*"/>
        <match lemma="ensenhar" tags="vblex.*"/>
        <match lemma="apréner" tags="vblex.*"/>
        <match lemma="aprene" tags="vblex.*"/>
        <match lemma="ensenhaire" tags="n.*"/>
        <match lemma="primari" tags="n.*"/>
        <match lemma="primària" tags="n.*"/>
        <match lemma="mairala" tags="n.*"/>
        <match lemma="mairau" tags="n.*"/>
        <match lemma="calandreta" tags="n.*"/>
        <match lemma="Calandreta" tags="np.*"/>
        <match lemma="bilingüe" tags="n.*"/>
        <match lemma="monoligüe" tags="n.*"/>
        <match lemma="occitan" tags="n.*"/>
        <match lemma="classa" tags="n.*"/>
        <match lemma="cors" tags="n.*"/>
        <match lemma="eslhève" tags="n.*"/>
        <match lemma="pòste" tags="n.*"/>
        <match lemma="primari" tags="adj.*"/>
        <match lemma="mairal" tags="adj.*"/>
        <match lemma="regent" tags="n.*"/>
        <match lemma="ensenhaire" tags="n.*"/>
        <match lemma="institutor" tags="n.*"/>
        <match lemma="professor" tags="n.*"/>
        <match lemma="mèstre" tags="n.*"/>
      </or>
    </rule>
    <rule weight="1.1">
      <or>
        <match lemma="escòla" tags="n.*"/>
        <match lemma="collègi" tags="n.*"/>
        <match lemma="licèu" tags="n.*"/>
        <match lemma="pedagogia" tags="n.*"/>
        <match lemma="escolan" tags="n.*"/>
        <match lemma="ensenhar" tags="vblex.*"/>
        <match lemma="apréner" tags="vblex.*"/>
        <match lemma="aprene" tags="vblex.*"/>
        <match lemma="ensenhaire" tags="n.*"/>
        <match lemma="primari" tags="n.*"/>
        <match lemma="primària" tags="n.*"/>
        <match lemma="mairala" tags="n.*"/>
        <match lemma="mairau" tags="n.*"/>
        <match lemma="calandreta" tags="n.*"/>
        <match lemma="Calandreta" tags="np.*"/>
        <match lemma="bilingüe" tags="n.*"/>
        <match lemma="monoligüe" tags="n.*"/>
        <match lemma="occitan" tags="n.*"/>
        <match lemma="classa" tags="n.*"/>
        <match lemma="cors" tags="n.*"/>
        <match lemma="eslhève" tags="n.*"/>
        <match lemma="pòste" tags="n.*"/>
        <match lemma="primari" tags="adj.*"/>
        <match lemma="mairal" tags="adj.*"/>
        <match lemma="regent" tags="n.*"/>
        <match lemma="ensenhaire" tags="n.*"/>
        <match lemma="institutor" tags="n.*"/>
        <match lemma="professor" tags="n.*"/>
        <match lemma="mèstre" tags="n.*"/>
      </or>
      <repeat from="0" upto="5">
        <or>
          <match tags="*"/>
          <match tags=""/>
        </or>
      </repeat>
      <match lemma="dintrada" tags="n.m.*"><select lemma="rentrée"/></match>
    </rule>

    <!-- fonduda >> fonte, fondue -->
    <rule weight="0.8">
      <match lemma="fonduda" tags="n.*"><select lemma="fonte"/></match>
    </rule>

    <!-- casa >> maison, case -->
    <rule weight="0.8">
      <match lemma="casa" tags="n.*"><select lemma="maison"/></match>
    </rule>

    <!-- monde >> monde, gens -->
    <rule weight="0.8">
      <match lemma="monde" tags="n.*"><select lemma="monde"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="monde" tags="n.*"><select lemma="gens"/></match>
      <repeat from="0" upto="1">
        <or>
          <match tags="adv"/>
          <match tags="adv.enon"/>
        </or>
      </repeat>
      <repeat from="0" upto="2">
        <match tags="prn.pro.*"/>
      </repeat>
      <or><match tags="vblex.*.pl"/><match tags="vbser.*.pl"/><match tags="vbhaver.*.pl"/><match tags="vbmod.*.pl"/></or>
    </rule>
    <rule weight="1.0">
      <or><match tags="vblex.*"/><match tags="vbser.*"/><match tags="vbhaver.*"/><match tags="vbmod.*"/></or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="de" tags="pr"/>
      <match lemma="monde" tags="n.*"><select lemma="gens"/></match>
      <repeat from="0" upto="1">
        <match tags="adv"/>
      </repeat>
      <or>
        <match lemma="que" tags="rel.*"/>
        <match lemma="qui" tags="rel.*"/>
      </or>
    </rule>
    <rule weight="1.0">
      <or><match tags="vblex.*"/><match tags="vbser.*"/><match tags="vbhaver.*"/><match tags="vbmod.*"/></or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="a" tags="pr"/>
      <match tags="det.def.*"/>
      <match lemma="monde" tags="n.*"><select lemma="gens"/></match>
      <or>
        <match lemma="que" tags="rel.*"/>
        <match lemma="qui" tags="rel.*"/>
      </or>
    </rule>
    <rule weight="1.2">
      <or><match tags="vblex.*"/><match tags="vbser.*"/><match tags="vbhaver.*"/><match tags="vbmod.*"/></or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="de" tags="pr"/>
      <match lemma="monde" tags="n.*"><select lemma="monde"/></match>
      <repeat from="0" upto="1">
        <match tags="adv"/>
      </repeat>
      <or>
        <match lemma="que" tags="rel.*"/>
        <match lemma="qui" tags="rel.*"/>
      </or>
      <repeat from="0" upto="1">
        <or>
          <match tags="adv"/>
          <match tags="adv.enon"/>
        </or>
      </repeat>
      <repeat from="0" upto="2">
        <match tags="prn.pro.*"/>
      </repeat>
      <or><match tags="vblex.*.p3.sg"/><match tags="vbser.*.p3.sg"/><match tags="vbhaver.*.p3.sg"/><match tags="vbmod.*.p3.sg"/></or>
    </rule>
    <rule weight="1.2">
      <or><match tags="vblex.*"/><match tags="vbser.*"/><match tags="vbhaver.*"/><match tags="vbmod.*"/></or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="a" tags="pr"/>
      <match tags="det.def.*"/>
      <match lemma="monde" tags="n.*"><select lemma="monde"/></match>
      <or>
        <match lemma="que" tags="rel.*"/>
        <match lemma="qui" tags="rel.*"/>
      </or>
      <repeat from="0" upto="1">
        <or>
          <match tags="adv"/>
          <match tags="adv.enon"/>
        </or>
      </repeat>
      <repeat from="0" upto="2">
        <match tags="prn.pro.*"/>
      </repeat>
      <or><match tags="vblex.*.p3.sg"/><match tags="vbser.*.p3.sg"/><match tags="vbhaver.*.p3.sg"/><match tags="vbmod.*.p3.sg"/></or>
    </rule>
    <rule weight="1.2">
      <match lemma="monde" tags="n.*"><select lemma="gens"/></match>
      <match lemma="que" tags="rel.*"><select lemma="qui"/></match>
      <repeat from="0" upto="1">
        <or>
          <match tags="adv"/>
          <match tags="adv.enon"/>
        </or>
      </repeat>
      <repeat from="0" upto="2">
        <match tags="prn.pro.*"/>
      </repeat>
      <or><match tags="vblex.*.p3.pl"/><match tags="vbser.*.p3.pl"/><match tags="vbhaver.*.p3.pl"/><match tags="vbmod.*.p3.pl"/></or>
    </rule>
    <rule weight="1.2">
      <match lemma="monde" tags="n.*"><select lemma="gens"/></match>
      <match lemma="qui" tags="rel.*"><select lemma="qui"/></match>
      <repeat from="0" upto="1">
        <or>
          <match tags="adv"/>
          <match tags="adv.enon"/>
        </or>
      </repeat>
      <repeat from="0" upto="2">
        <match tags="prn.pro.*"/>
      </repeat>
      <or><match tags="vblex.*.p3.pl"/><match tags="vbser.*.p3.pl"/><match tags="vbhaver.*.p3.pl"/><match tags="vbmod.*.p3.pl"/></or>
    </rule>
    <rule weight="1.0">
      <match lemma="monde" tags="n.*"><select lemma="gens"/></match>
      <repeat from="0" upto="1">
        <or>
          <match lemma="quan" tags="rel.*"/>
          <match lemma="quand" tags="rel.*"/>
          <match lemma="ont" tags="rel.*"/>
          <match lemma="on" tags="rel.*"/>
        </or>
      </repeat>
      <repeat from="0" upto="2">
        <match tags="prn.pro.*"/>
      </repeat>
      <or><match tags="vblex.*.pl"/><match tags="vbser.*.pl"/><match tags="vbhaver.*.pl"/><match tags="vbmod.*.pl"/></or>
    </rule>
    <rule weight="1.2">
      <match lemma="monde" tags="n.m.pl"><select lemma="monde"/></match>
    </rule>
    <rule weight="1.2">
      <match lemma="de" tags="pr"/>
      <match tags="det.*"/>
      <repeat from="0" upto="1">
        <match tags="adj.*"/>
      </repeat>
      <match lemma="monde" tags="n.*"><select lemma="monde"/></match>
    </rule>
    <rule weight="1.2">
      <or>
        <match lemma="en" tags="pr"/>
        <match lemma="dins" tags="pr"/>
      </or>
      <match tags="det.*"/>
      <repeat from="0" upto="1">
        <match tags="adj.*"/>
      </repeat>
      <match lemma="monde" tags="n.*"><select lemma="monde"/></match>
    </rule>

    <!-- darr(i)èr >> dernier, derrière -->
    <rule weight="0.8">
      <match lemma="darrièr" tags="n.*"><select lemma="derrière"/></match>
    </rule>

    <!-- pòst >> poste, planche -->
    <rule weight="0.8">
      <match lemma="pòst" tags="n.*"><select lemma="poste"/></match>
    </rule>

    <!-- gras >> gras, degré -->
    <rule weight="0.8">
      <match lemma="gras" tags="n.*"><select lemma="degré"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="en" tags="pr"/>
      <match lemma="gras" tags="n.*"><select lemma="degré"/></match>
    </rule>

    <!-- mèca >> morve, mèche -->
    <rule weight="0.8">
      <match lemma="mèca" tags="n.*"><select lemma="morve"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="mèca" tags="n.*"><select lemma="mèche"/></match>
      <match lemma="de" tags="pr"/>
    </rule>

    <!-- mèl >> e-mail, miel -->
    <rule weight="0.8">
      <match lemma="mèl" tags="n.*"><select lemma="miel"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="mandar" tags="vblex.*"/>
        <match lemma="enviar" tags="vblex.*"/>
        <match lemma="escriure" tags="vblex.*"/>
        <match lemma="escríver" tags="vblex.*"/>
        <match lemma="redigir" tags="vblex.*"/>
        <match lemma="transferir" tags="vblex.*"/>
        <match lemma="legir" tags="vblex.*"/>
        <match lemma="mandar" tags="vblex.*"/>
        <match lemma="mandar" tags="vblex.*"/>
        <match lemma="recebre" tags="vblex.*"/>
        <match lemma="recéber" tags="vblex.*"/>
        <match lemma="corregir" tags="vblex.*"/>
        <match lemma="dobrir" tags="vblex.*"/>
        <match lemma="obrir" tags="vblex.*"/>
        <match lemma="aviar" tags="vblex.*"/>
        <match lemma="postar" tags="vblex.*"/>
        <match lemma="adreçar" tags="vblex.*"/>
        <match lemma="piratar" tags="vblex.*"/>
      </or>
      <repeat from="0" upto="3">
        <or>
          <match tags="adv"/>
          <match tags="det.*"/>
          <match tags="num"/>
          <match tags="num.*"/>
          <match lemma="de" tags="pr"/>
        </or>
      </repeat>
      <repeat from="0" upto="3">
        <or>
          <match tags="adv"/>
          <match tags="preadv"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <match lemma="mèl" tags="n.*"><select lemma="e-mail"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="respondre" tags="vblex.*"/>
        <match lemma="respónder" tags="vblex.*"/>
        <match lemma="respóner" tags="vblex.*"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="a" tags="pr"/>
      <repeat from="0" upto="3">
        <or>
          <match tags="det.*"/>
          <match tags="num"/>
          <match tags="num.*"/>
          <match lemma="de" tags="pr"/>
          <match tags="adv"/>
          <match tags="preadv"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <match lemma="mèl" tags="n.*"><select lemma="e-mail"/></match>
    </rule>

    <!-- niu >> nid, nuage -->
    <rule weight="0.8">
      <match lemma="niu" tags="n.*"><select lemma="nid"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="niu" tags="n.m.pl"><select lemma="nuage"/></match>
    </rule>


