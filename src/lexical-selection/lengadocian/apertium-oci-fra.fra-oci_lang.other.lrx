<?xml version="1.0" encoding="UTF-8"?>
<lrx>
  <rules>
    <!-- **************** PREP **************** -->

    <!-- vis-à-vis de >> de cap a -->
    <rule weight="0.6">
      <match lemma="vis-a-vis de" tags="pr"><select lemma="de cap a"/></match>
    </rule>

    <!-- dans >> dins, en -->
    <rule weight="0.8">
      <match lemma="dans" tags="pr"><select lemma="dins"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="dans" tags="pr"><select lemma="en"/></match>
      <match lemma="tout" tags="predet.*"/>
      <match lemma="le" tags="det.*"/>
      <match tags="np.top.*"/>
    </rule>

    <!-- pour >> per/entà -->
    <rule weight="0.8">
      <match lemma="pour" tags="pr"><select lemma="per"/></match>
    </rule>

    <!-- sous l'effet de >> a causa de, jos l'efièch de -->
    <rule weight="0.8">
      <match lemma="sous l'effet de" tags="pr"><select lemma="a causa de"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="sous l'effet de" tags="pr"><select lemma="jos l'efièch de"/></match>
      <repeat from="0" upto="2">
        <or>
          <match tags=""/>
          <match tags="*"/>
        </or>
      </repeat>
      <or>
        <match lemma="drogue" tags="n.*"/>
        <match lemma="alcool" tags="n.*"/>
        <match lemma="cannabis" tags="n.*"/>
        <match lemma="cocaïne" tags="n.*"/>
        <match lemma="héroïne" tags="n.*"/>
        <match lemma="hashish" tags="n.*"/>
        <match lemma="LMD" tags="n.*"/>
        <match lemma="ecstasy" tags="n.*"/>
        <match lemma="boisson" tags="n.*"/>
        <match lemma="vin" tags="n.*"/>
        <match lemma="bière" tags="n.*"/>
        <match lemma="whisky" tags="n.*"/>
        <match lemma="champagne" tags="n.*"/>
        <match lemma="apéritif" tags="n.*"/>
        <match lemma="liqueur" tags="n.*"/>
        <match lemma="eau-de-vie" tags="n.*"/>
      </or>
    </rule>

    <!-- **************** REL **************** -->

    <!-- qui rel >> que -->
    <rule weight="0.8">
      <match lemma="qui" tags="rel.*"><select lemma="que"/></match>
    </rule>

    <!-- celui que >> lo que -->
    <rule weight="0.8">
      <match lemma="celui que" tags="rel.*"><select lemma="lo que"/></match>
    </rule>

    <!-- celui qui >> lo que -->
    <rule weight="0.8">
      <match lemma="celui qui" tags="rel.*"><select lemma="lo que"/></match>
    </rule>

    <!-- ceux et celles que >> los e las que -->
    <rule weight="0.8">
      <match lemma="ceux et celles que" tags="rel.*"><select lemma="los e las que"/></match>
    </rule>

    <!-- celles et ceux que >> la e lo que -->
    <rule weight="0.8">
      <match lemma="celles et ceux que" tags="rel.*"><select lemma="las e los que"/></match>
    </rule>

    <!-- ceux et celles qui >> los e las que -->
    <rule weight="0.8">
      <match lemma="ceux et celles qui" tags="rel.*"><select lemma="los e las que"/></match>
    </rule>

    <!-- celles et ceux qui >> las e los que -->
    <rule weight="0.8">
      <match lemma="celles et ceux qui" tags="rel.*"><select lemma="las e los que"/></match>
    </rule>

    <!-- où -> où, que -->
    <rule weight="0.8">
      <match lemma="où" tags="rel.*"><select lemma="ont"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="heure"/>
        <match lemma="moment"/>
        <match lemma="jour"/>
        <match lemma="année"/>
        <match lemma="mois"/>
        <match lemma="minute"/>
        <match lemma="instant"/>
      </or>
      <match lemma="où" tags="rel.*"><select lemma="que"/></match>
    </rule>

    <!-- **************** PRN **************** -->

    <!-- lui prn.pro >> li, lo prn.pro.p3.*.sg (lengadocian) -->
    <rule weight="0.8">
      <match lemma="lui" tags="prn.pro.*"><select lemma="li"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="lui" tags="prn.pro.*"><select lemma="lo" tags="prn.pro.p3.m.sg"/></match>
      <or>
        <match lemma="rendre# visite" tags="vblex.*"/>
        <match lemma="faire# face" tags="vblex.*"/>
        <match lemma="décerner# un prix" tags="vblex.*"/>
        <match lemma="donner# la priorité" tags="vblex.*"/>
        <match lemma="mettre# son veto" tags="vblex.*"/>
        <match lemma="mettre# son véto" tags="vblex.*"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match lemma="lui" tags="prn.pro.*"><select lemma="lo" tags="prn.pro.p3.m.sg"/></match>
      <match tags="vbhaver.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <or>
        <match lemma="rendre# visite" tags="vblex.*"/>
        <match lemma="faire# face" tags="vblex.*"/>
        <match lemma="décerner# un prix" tags="vblex.*"/>
        <match lemma="donner# la priorité" tags="vblex.*"/>
        <match lemma="mettre# son veto" tags="vblex.*"/>
        <match lemma="mettre# son véto" tags="vblex.*"/>
      </or>
    </rule>

    <!-- leur prn.pro >> li, lo prn.pro.p3.*.pl (lengadocian) -->
    <rule weight="0.8">
      <match lemma="leur" tags="prn.pro.*"><select lemma="li"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="leur" tags="prn.pro.*"><select lemma="lo" tags="prn.pro.p3.m.pl"/></match>
      <or>
        <match lemma="rendre# visite" tags="vblex.*"/>
        <match lemma="faire# face" tags="vblex.*"/>
        <match lemma="décerner# un prix" tags="vblex.*"/>
        <match lemma="donner# la priorité" tags="vblex.*"/>
        <match lemma="mettre# son veto" tags="vblex.*"/>
        <match lemma="mettre# son véto" tags="vblex.*"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match lemma="lui" tags="prn.pro.*"><select lemma="lo" tags="prn.pro.p3.m.pl"/></match>
      <match tags="vbhaver.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <or>
        <match lemma="rendre# visite" tags="vblex.*"/>
        <match lemma="faire# face" tags="vblex.*"/>
        <match lemma="décerner# un prix" tags="vblex.*"/>
        <match lemma="donner# la priorité" tags="vblex.*"/>
        <match lemma="mettre# son veto" tags="vblex.*"/>
        <match lemma="mettre# son véto" tags="vblex.*"/>
      </or>
    </rule>
  </rules>
</lrx>

<!--
Resources:
    https://wiki.apertium.org/wiki/How_to_get_started_with_lexical_selection_rules
    https://wiki.apertium.org/wiki/Constraint-based_lexical_selection
    https://wiki.apertium.org/wiki/Lexical_selection
    https://wiki.apertium.org/wiki/Learning_rules_from_parallel_and_non-parallel_corpora
-->
