      <match lemma="estudiant" tags="n.*"/>
      <match lemma="universitari" tags="n.*"/>
      <match lemma="curat" tags="n.*"/>
      <match lemma="curè" tags="n.*"/>
      <match lemma="capelan" tags="n.*"/>
      <match lemma="caperan" tags="n.*"/>
      <match lemma="paisan" tags="n.*"/>
      <match lemma="pagés" tags="n.*"/>
      <match lemma="pacan" tags="n.*"/>
      <match lemma="politic" tags="n.*"/>
      <match lemma="politician" tags="n.*"/>
