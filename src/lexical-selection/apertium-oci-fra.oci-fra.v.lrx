<?xml version="1.0" encoding="UTF-8"?>
<lrx>
  <def-macros>
    <!-- Aquesta macro tria el verb p2 si p1 és intransitiu i p3 si p1 és transitiu -->
    <!-- p1 = verb fra, p2 = verb cat intransitiu, p3 = verb cat transitiu -->
    <!-- la manera de veure que el verb és transitiu és molt barroera -->
    <def-macro n="verb_intrans_trans" npar="3">
      <rule weight="0.8">
        <match plemma="1" tags="vblex.*"><select plemma="2"/></match>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*"><select plemma="3"/></match>
        <repeat from="0" upto="2">
          <match tags="adv"/>
        </repeat>
        <or>
          <match tags="det.*"/>
          <match tags="np.*"/>
        </or>
      </rule>
      <rule weight="1.2">
        <match plemma="1" tags="vblex.*"><select plemma="2"/></match>
        <repeat from="0" upto="2">
          <match tags="adv"/>
        </repeat>
        <match tags="det.*"/>
        <or>
          <seq n="jorns"/>
          <seq n="meses"/>
          <seq n="sasons"/>
          <seq n="parts_jorn"/>
          <match lemma="velha" tags="n.*"/>
          <match lemma="vegelha" tags="n.*"/>
          <match lemma="vigília" tags="n.*"/>
          <match lemma="dimenjada" tags="n.*"/>
          <match tags="num"/>
        </or>
      </rule>
      <rule weight="1.4">
        <match plemma="1" tags="vblex.*"><select plemma="3"/></match>
        <repeat from="0" upto="2">
          <match tags="adv"/>
        </repeat>
        <match tags="det.*"/>
        <or>
          <seq n="jorns"/>
          <seq n="meses"/>
          <seq n="sasons"/>
          <seq n="parts_jorn"/>
          <match lemma="velha" tags="n.*"/>
          <match lemma="vegelha" tags="n.*"/>
          <match lemma="vigília" tags="n.*"/>
          <match lemma="dimenjada" tags="n.*"/>
          <match tags="num"/>
        </or>
        <repeat from="0" upto="1">
          <match tags="adj.*"/>
        </repeat>
        <or>
          <match tags="det.*"/>
          <match tags="np.*"/>
        </or>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*"><select plemma="3"/></match>
        <repeat from="0" upto="2">
          <match tags="adv"/>
        </repeat>
        <or>
          <match tags="num.*"/>
          <match tags="num"/>
        </or>
          <or>
            <match tags="preadv"/>
            <match tags="adv"/>
            <match tags="adj.*"/>
          </or>
        <match tags="n.*"/>
      </rule>
      <rule weight="1.0">
        <match tags="vbser.*"/>
        <repeat from="0" upto="2">
          <match tags="adv"/>
        </repeat>
        <match plemma="1" tags="vblex.pp.*"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <or>
          <match tags="n.*"/>
          <match tags="adj.*"/>
          <match tags="vblex.pp.*"/>
        </or>
        <match plemma="1" tags="vblex.pp.*"><select plemma="3"/></match>
      </rule>
    </def-macro>

    <!-- p1 = verb oci, p2 = verb fra no pron, p3 = verb fra pron -->
    <def-macro n="verb_nopron_pron" npar="3">
      <rule weight="0.8">
        <match plemma="1" tags="vblex.*"><select plemma="2"/></match>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p1.*.sg"/>
        <match plemma="1" tags="vblex.*.p1.sg"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p1.*.sg"/>
        <match tags="prn.pro.*"/>
        <match plemma="1" tags="vblex.*.p1.sg"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*.p1.sg"><select plemma="3"/></match>
        <match tags="prn.enc.p1.*.sg"/>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p2.*.sg"/>
        <match plemma="1" tags="vblex.*.p2.sg"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p2.*.sg"/>
        <match tags="prn.pro.*"/>
        <match plemma="1" tags="vblex.*.p2.sg"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*.p2.sg"><select plemma="3"/></match>
        <match tags="prn.enc.p2.*.sg"/>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.ref.p3.*.sp"/>
        <or>
          <match plemma="1" tags="vblex.*.p3.sg"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.*.p3.pl"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.inf"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.ger"><select plemma="3"/></match>
        </or>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.ref.p3.*.sp"/>
        <match tags="prn.pro.*"/>
        <or>
          <match plemma="1" tags="vblex.*.p3.sg"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.*.p3.pl"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.inf"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.ger"><select plemma="3"/></match>
        </or>
      </rule>
      <rule weight="1.0">
        <or>
          <match plemma="1" tags="vblex.*.p3.sg"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.*.p3.pl"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.inf"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.ger"><select plemma="3"/></match>
        </or>
        <match tags="prn.enc.ref.p3.*.sp"/>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p1.*.pl"/>
        <match plemma="1" tags="vblex.*.p1.pl"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p1.*.pl"/>
        <match tags="prn.pro.*"/>
        <match plemma="1" tags="vblex.*.p1.pl"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*.p1.pl"><select plemma="3"/></match>
        <match tags="prn.enc.p1.*.pl"/>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p2.*.pl"/>
        <match plemma="1" tags="vblex.*.p2.pl"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p2.*.pl"/>
        <match tags="prn.pro.*"/>
        <match plemma="1" tags="vblex.*.p2.pl"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*.p2.pl"><select plemma="3"/></match>
        <match tags="prn.enc.p2.*.pl"/>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p3.*"/>
        <match plemma="1" tags="vblex.*.p3.*"><select plemma="3"/></match>
        <repeat from="0" upto="1">
          <or>
            <match tags="adv"/>
            <match tags="preadv"/>
          </or>
        </repeat>
        <or>
          <match tags="np.ant"/>
          <match tags="np.ant.*"/>
          <match tags="np.cog.*"/>
        </or>
      </rule>
      <rule weight="1.0">
        <match tags="vbser.*"/>
        <repeat from="0" upto="2">
          <match tags="adv"/>
        </repeat>
        <match plemma="1" tags="vblex.pp.*"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <match tags="n.*"/>
        <repeat from="0" upto="1">
          <match tags="adj.*"/>
        </repeat>
        <match plemma="1" tags="vblex.pp.*"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <or>
          <match tags="cm"/>
          <match tags="lpar"/>
        </or>
        <match plemma="1" tags="vblex.pp.*"><select plemma="3"/></match>
      </rule>
    </def-macro>

    <!-- Aquesta macro tria el verb p2 si p1 no és pronominal i p3 si p1 és pronominal i va seguit de la preposició p4 -->
    <!-- p1 = verb oci, p2 = verb fra no pron, p3 = verb fra pron, p4 = prep oci -->
    <def-macro n="verb_nopron_pron_prep" npar="4">
      <rule weight="0.8">
        <match plemma="1" tags="vblex.*"><select plemma="2"/></match>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p1.*.sg"/>
        <match plemma="1" tags="vblex.*.p1.sg"><select plemma="3"/></match>
        <match plemma="4" tags="pr"/>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p1.*.sg"/>
        <match tags="prn.pro.*"/>
        <match plemma="1" tags="vblex.*.p1.sg"><select plemma="3"/></match>
        <match plemma="4" tags="pr"/>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*.p1.sg"><select plemma="3"/></match>
        <match tags="prn.enc.p1.*.sg"/>
        <match plemma="4" tags="pr"/>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p2.*.sg"/>
        <match plemma="1" tags="vblex.*.p2.sg"><select plemma="3"/></match>
        <match plemma="4" tags="pr"/>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p2.*.sg"/>
        <match tags="prn.pro.*"/>
        <match plemma="1" tags="vblex.*.p2.sg"><select plemma="3"/></match>
        <match plemma="4" tags="pr"/>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*.p2.sg"><select plemma="3"/></match>
        <match tags="prn.enc.p2.*.sg"/>
        <match plemma="4" tags="pr"/>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.ref.p3.*.sp"/>
        <or>
          <match plemma="1" tags="vblex.*.p3.sg"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.*.p3.pl"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.inf"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.ger"><select plemma="3"/></match>
        </or>
        <match plemma="4" tags="pr"/>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.ref.p3.*.sp"/>
        <match tags="prn.pro.*"/>
        <or>
          <match plemma="1" tags="vblex.*.p3.sg"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.*.p3.pl"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.inf"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.ger"><select plemma="3"/></match>
        </or>
        <match plemma="4" tags="pr"/>
      </rule>
      <rule weight="1.0">
        <or>
          <match plemma="1" tags="vblex.*.p3.sg"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.*.p3.pl"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.inf"><select plemma="3"/></match>
          <match plemma="1" tags="vblex.ger"><select plemma="3"/></match>
        </or>
        <match tags="prn.enc.ref.p3.*.sp"/>
        <match plemma="4" tags="pr"/>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p1.*.pl"/>
        <match plemma="1" tags="vblex.*.p1.pl"><select plemma="3"/></match>
        <match plemma="4" tags="pr"/>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p1.*.pl"/>
        <match tags="prn.pro.*"/>
        <match plemma="1" tags="vblex.*.p1.pl"><select plemma="3"/></match>
        <match plemma="4" tags="pr"/>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*.p1.pl"><select plemma="3"/></match>
        <match tags="prn.enc.p1.*.pl"/>
        <match plemma="4" tags="pr"/>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p2.*.pl"/>
        <match plemma="1" tags="vblex.*.p2.pl"><select plemma="3"/></match>
        <match plemma="4" tags="pr"/>
      </rule>
      <rule weight="1.0">
        <match tags="prn.pro.p2.*.pl"/>
        <match tags="prn.pro.*"/>
        <match plemma="1" tags="vblex.*.p2.pl"><select plemma="3"/></match>
        <match plemma="4" tags="pr"/>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*.p2.pl"><select plemma="3"/></match>
        <match tags="prn.enc.p2.*.pl"/>
        <match plemma="4" tags="pr"/>
      </rule>
      <rule weight="1.0">
        <match tags="vbser.*"/>
        <repeat from="0" upto="2">
          <match tags="adv"/>
        </repeat>
        <match plemma="1" tags="vblex.pp.*"><select plemma="3"/></match>
        <match plemma="4" tags="pr"/>
      </rule>
    </def-macro>

    <!-- p1 = verb oci (amb complement predicatiu), p2 = verb fra amb adj en masc sg, p3 = verb fra amb adj en fem sg, p4 = verb fra amb adj en masc pl, p5 = verb fra amb adj en fem pl -->
    <def-macro n="verb-predicatiu_adjmsg_adjfsg_adjmpl_adjfpl" npar="5">
      <rule weight="0.8">
        <match plemma="1" tags="vblex.*"><select plemma="2"/></match>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*"><select plemma="3"/></match>
        <match tags="det.*.f.sg"/>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*"><select plemma="4"/></match>
        <match tags="det.*.pl"/>
      </rule>
      <rule weight="1.2">
        <match plemma="1" tags="vblex.*"><select plemma="5"/></match>
        <match tags="det.*.f.pl"/>
      </rule>
      <rule weight="1.4">
        <match plemma="1" tags="vblex.pp.f.sg"><select plemma="3"/></match>
      </rule>
      <rule weight="1.4">
        <match plemma="1" tags="vblex.pp.m.pl"><select plemma="4"/></match>
      </rule>
      <rule weight="1.4">
        <match plemma="1" tags="vblex.pp.f.pl"><select plemma="5"/></match>
      </rule>
    </def-macro>

    <!-- p1 = verb oci, p2 = verb fra per p1.sg, p3 = verb fra per p2.sg, p4 = verb fra per p3.sg, p5 = verb fra per p1.pl, ... -->
    <def-macro n="verb_p1sg_p2sg_p3sg_p1pl_p2pl_p3pl" npar="7">
      <rule weight="0.8">
        <match plemma="1" tags="vblex.*"><select plemma="4"/></match>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*.p1.sg"><select plemma="2"/></match>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*.p2.sg"><select plemma="3"/></match>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*.p1.pl"><select plemma="5"/></match>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*.p2.pl"><select plemma="6"/></match>
      </rule>
      <rule weight="1.0">
        <match plemma="1" tags="vblex.*.p3.pl"><select plemma="7"/></match>
      </rule>
    </def-macro>
  </def-macros>

  <def-seqs>
    <def-seq n="jorns"><or>
      <match lemma="diluns"/>
      <match lemma="dimars"/>
      <match lemma="dimècres"/>
      <match lemma="dimèrcs"/>
      <match lemma="dijòus"/>
      <match lemma="dijaus"/>
      <match lemma="divendres"/>
      <match lemma="divés"/>
      <match lemma="dissabte"/>
      <match lemma="dimenge"/>
    </or></def-seq>

    <def-seq n="meses"><or>
      <match lemma="genèr" tags="n.*"/>
      <match lemma="genièr" tags="n.*"/>
      <match lemma="janvièr" tags="n.*"/>
      <match lemma="gèr" tags="n.*"/>
      <match lemma="febrièr" tags="n.*"/>
      <match lemma="heurèr" tags="n.*"/>
      <match lemma="hrevèr" tags="n.*"/>
      <match lemma="herevèr" tags="n.*"/>
      <match lemma="herbèr" tags="n.*"/>
      <match lemma="hiurèr" tags="n.*"/>
      <match lemma="març" tags="n.*"/>
      <match lemma="abrial" tags="n.*"/>
      <match lemma="abril" tags="n.*"/>
      <match lemma="abrieu" tags="n.*"/>
      <match lemma="mai" tags="n.*"/>
      <match lemma="junh" tags="n.*"/>
      <match lemma="julh" tags="n.*"/>
      <match lemma="juin" tags="n.*"/>
      <match lemma="gulh" tags="n.*"/>
      <match lemma="julhet" tags="n.*"/>
      <match lemma="gulhet" tags="n.*"/>
      <match lemma="junhsèga" tags="n.*"/>
      <match lemma="agost" tags="n.*"/>
      <match lemma="aost" tags="n.*"/>
      <match lemma="setembre" tags="n.*"/>
      <match lemma="seteme" tags="n.*"/>
      <match lemma="octobre" tags="n.*"/>
      <match lemma="octòbre" tags="n.*"/>
      <match lemma="novembre" tags="n.*"/>
      <match lemma="noveme" tags="n.*"/>
      <match lemma="decembre" tags="n.*"/>
      <match lemma="deceme" tags="n.*"/>
    </or></def-seq>

    <def-seq n="sasons"><or>
        <match lemma="prima" tags="n.*"/>
        <match lemma="primtemps" tags="n.*"/>
        <match lemma="primavèra" tags="n.*"/>
        <match lemma="estiu" tags="n.*"/>
        <match lemma="auton" tags="n.*"/>
        <match lemma="abòr" tags="n.*"/>
        <match lemma="davalada" tags="n.*"/>
        <match lemma="tardor" tags="n.*"/>
        <match lemma="agòr" tags="n.*"/>
        <match lemma="gòrra" tags="n.*"/>
        <match lemma="ivèrn" tags="n.*"/>
    </or></def-seq>

    <def-seq n="parts_jorn"><or>
        <match lemma="matin" tags="n.*"/>
        <match lemma="maitin" tags="n.*"/>
        <match lemma="matinada" tags="n.*"/>
        <match lemma="matiada" tags="n.*"/>
        <match lemma="aprèp-miègjorn" tags="n.*"/>
        <match lemma="aprèp-dinnada" tags="n.*"/>
        <match lemma="après-miègjorn" tags="n.*"/>
        <match lemma="après-dinnada" tags="n.*"/>
        <match lemma="vèspre" tags="n.*"/>
        <match lemma="vrèspe" tags="n.*"/>
        <match lemma="vesprada" tags="n.*"/>
        <match lemma="ser" tags="n.*"/>
        <match lemma="sera" tags="n.*"/>
        <match lemma="nuèch" tags="n.*"/>
        <match lemma="nuech" tags="n.*"/>
        <match lemma="nuòch" tags="n.*"/>
        <match lemma="nueit" tags="n.*"/>
        <match lemma="nuèit" tags="n.*"/>
        <match lemma="neit" tags="n.*"/>
        <match lemma="net" tags="n.*"/>
    </or></def-seq>

    <def-seq n="prn_ref"><or>
      <match lemma="me" tags="prn.pro.*"/>
      <match lemma="te" tags="prn.pro.*"/>
      <match lemma="se" tags="prn.pro.*"/>
      <match lemma="nos" tags="prn.pro.*"/>
      <match lemma="vos" tags="prn.pro.*"/>
    </or></def-seq>

    <def-seq n="prn_ci"><or>
      <match lemma="me" tags="prn.pro.*"/>
      <match lemma="te" tags="prn.pro.*"/>
      <match lemma="li" tags="prn.pro.*"/>
      <match lemma="nos" tags="prn.pro.*"/>
      <match lemma="vos" tags="prn.pro.*"/>
    </or></def-seq>

    <def-seq n="personas"><or>
      <match lemma="persona" tags="n.*"/>
      <match lemma="òme" tags="n.*"/>
      <match lemma="òmi" tags="n.*"/>
