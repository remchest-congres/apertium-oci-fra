    <macro n="verb_nopron_pron"><with-param v="bandar"/><with-param v="bander"/><with-param v="enivrer"/></macro>

    <!-- mauméter >> malmener, brouiller -->
    <macro n="verb_nopron_pron"><with-param v="mauméter"/><with-param v="malmener"/><with-param v="brouiller"/></macro>

    <!-- pintar >> peindre, picoler -->
    <rule weight="0.8">
