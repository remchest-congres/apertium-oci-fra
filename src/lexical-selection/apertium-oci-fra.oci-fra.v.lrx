        <match lemma="armada" tags="n.*"/>
        <match lemma="regiment" tags="n.*"/>
        <match lemma="equipatge" tags="n.*"/>
        <match lemma="chorma" tags="n.*"/>
        <match lemma="còla" tags="n.*"/>
        <match lemma="equipa" tags="n.*"/>
        <match lemma="marina" tags="n.*"/>
        <match lemma="tropa" tags="n.*"/>
