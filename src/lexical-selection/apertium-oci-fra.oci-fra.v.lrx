    <!-- hlorir >> fleurir, moisir -->
    <macro n="verb_nopron_pron"><with-param v="florir"/><with-param v="fleurir"/><with-param v="moisir"/></macro>
    <macro n="verb_nopron_pron"><with-param v="hlorir"/><with-param v="fleurir"/><with-param v="moisir"/></macro>

    <!-- lançar >> foncer, lancer -->
    <macro n="verb_nopron_pron"><with-param v="lançar"/><with-param v="foncer"/><with-param v="lancer"/></macro>

    <!-- pressar >> presser, empresser -->
    <rule weight="0.8">
      <match lemma="pressar" tags="vblex.*"><select lemma="presser"/></match>
    </rule>
    <rule weight="1.0">
      <match tags="prn.pro.*"/>
      <match lemma="pressar" tags="vblex.*"><select lemma="empresser"/></match>
      <repeat from="0" upto="2">
      <match tags="adv"/>
      </repeat>
      <or>
        <match lemma="de" tags="pr"/>
        <match lemma="entà" tags="pr"/>
        <match lemma="enta" tags="pr"/>
        <match lemma="tà" tags="pr"/>
      </or>
      <repeat from="0" upto="3">
        <or>
        <match tags="adv"/>
        <match tags="prn.pro.*"/>
        </or>
      </repeat>
      <match tags="vblex.inf"/>
    </rule>

    <!-- cochar >> chasser/coucher, presser, empresser (de) -->
    <rule weight="3.0">
      <match tags="prn.pro.*"/>
      <match lemma="cochar" tags="vblex.*"><select lemma="empresser"/></match>
      <repeat from="0" upto="2">
      <match tags="adv"/>
      </repeat>
      <or>
        <match lemma="de" tags="pr"/>
        <match lemma="entà" tags="pr"/>
        <match lemma="enta" tags="pr"/>
        <match lemma="tà" tags="pr"/>
      </or>
      <repeat from="0" upto="3">
        <or>
        <match tags="adv"/>
        <match tags="prn.pro.*"/>
        </or>
      </repeat>
      <match tags="vblex.inf"/>
    </rule>

