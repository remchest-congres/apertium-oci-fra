      <match lemma="senator" tags="n.*"/>
      <match lemma="senador" tags="n.*"/>
      <match lemma="elegit" tags="n.*"/>
      <match lemma="elejut" tags="n.*"/>

      <match lemma="cantaire" tags="n.*"/>
      <match lemma="compositor" tags="n.*"/>
      <match lemma="escrivan" tags="n.*"/>
      <match lemma="escriveire" tags="n.*"/>
      <match lemma="poèta" tags="n.*"/>
      <match lemma="musician" tags="n.*"/>
