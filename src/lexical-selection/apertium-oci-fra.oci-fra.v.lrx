    <!-- revlincar >> corder, fausser, tordre -->
    <rule weight="0.8">
      <match lemma="revlincar" tags="vblex.*"><select lemma="tordre"/></match>
    </rule>

    <!-- ronhar >> ronronner, grogner -->
    <rule weight="0.8">
      <match lemma="ronhar" tags="vblex.*"><select lemma="ronronner"/></match>
    </rule>

    <!-- sagelar >> sceller, timbrer -->
    <rule weight="0.8">
      <or>
        <match lemma="sagelar" tags="vblex.*"><select lemma="sceller"/></match>
        <match lemma="sagerar" tags="vblex.*"><select lemma="sceller"/></match>
      </or>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="sagelar" tags="vblex.*"><select lemma="timbrer"/></match>
        <match lemma="sagerar" tags="vblex.*"><select lemma="timbrer"/></match>
      </or>
      <repeat from="0" upto="3">
        <or>
          <match tags=""/>
          <match tags="*"/>
        </or>
      </repeat>
      <or>
        <match lemma="envolopa" tags="n.*"/>
        <match lemma="còlis" tags="n.*"/>
        <match lemma="paquet" tags="n.*"/>
        <match lemma="envolòp" tags="n.*"/>
        <match lemma="estrop" tags="n.*"/>
        <match lemma="envolòpa" tags="n.*"/>
        <match lemma="letra" tags="n.*"/>
        <match lemma="carta" tags="n.*"/>
        <match lemma="corrièr" tags="n.*"/>
      </or>
    </rule>

    <!-- tinturar >> teindre, teinter -->
    <rule weight="0.8">
      <match lemma="tinturar" tags="vblex.*"><select lemma="teindre"/></match>
    </rule>

    <!-- arrapar >> saisir, agripper -->
    <rule weight="0.8">
      <match lemma="arrapar" tags="vblex.*"><select lemma="saisir"/></match>
    </rule>
    <rule weight="1.0">
      <or>
        <seq n="prn_ref"/>
      </or>
      <match lemma="arrapar" tags="vblex.*"><select lemma="agripper"/></match>
    </rule>
    <rule weight="1.2">
      <or>
        <seq n="prn_ref"/>
      </or>
      <match lemma="arrapar" tags="vblex.*"><select lemma="saisir"/></match>
      <match lemma="de" tags="pr"/>
    </rule>

    <!-- apear >> appuyer, avoir pied -->
    <rule weight="1.0">
      <match lemma="apear" tags="vblex.*"><select lemma="appuyer"/></match>
      <or>
        <match lemma="sur" tags="pr"/>
        <match lemma="sus" tags="pr"/>
        <match lemma="subre" tags="pr"/>
        <match lemma="suber" tags="pr"/>
      </or>
    </rule>

    <!-- devirar >> passer, faire, transformer, sortir -->
    <rule weight="1.0">
      <match lemma="se" tags="prn.pro.*"/>
      <match lemma="devirar" tags="vblex.*"><select lemma="faire"/></match>
      <repeat from="0" upto="2">
        <or>
          <match tags="adv"/>
          <match tags="preadv"/>
        </or>
      </repeat>
      <or>
        <match tags="adj.*"/>
        <match  tags="n.*"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match lemma="se" tags="prn.pro.*"/>
      <match tags="vbser.*.p3.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="devirar" tags="vblex.pp.*"><select lemma="faire"/></match>
      <repeat from="0" upto="2">
        <or>
          <match tags="adv"/>
          <match tags="preadv"/>
        </or>
      </repeat>
      <or>
        <match tags="adj.*"/>
        <match  tags="n.*"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match lemma="se" tags="prn.pro.*"/>
      <or>
        <match tags="vbmod.*.p3.*"/>
        <match lemma="anar" tags="vblex.*.p3.*"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="devirar" tags="vblex.inf"><select lemma="faire"/></match>
      <repeat from="0" upto="2">
        <or>
          <match tags="adv"/>
          <match tags="preadv"/>
        </or>
      </repeat>
      <or>
        <match tags="adj.*"/>
        <match  tags="n.*"/>
      </or>
    </rule>
    <rule weight="1.0">
      <match lemma="se" tags="prn.pro.*"/>
      <match lemma="devirar" tags="vblex.*"><select lemma="transformer"/></match>
      <match lemma="en" tags="pr"/>
      <repeat from="0" upto="1">
        <match tags="det.*"/>
      </repeat>
      <repeat from="0" upto="1">
        <match tags="preadv"/>
      </repeat>
      <repeat from="0" upto="1">
        <match tags="adj.*"/>
      </repeat>
      <match  tags="n.*"/>
    </rule>
    <rule weight="1.0">
      <match lemma="se" tags="prn.pro.*"/>
      <match tags="vbser.*.p3.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="devirar" tags="vblex.pp.*"><select lemma="transformer"/></match>
      <match lemma="en" tags="pr"/>
      <repeat from="0" upto="1">
        <match tags="det.*"/>
      </repeat>
      <repeat from="0" upto="1">
        <match tags="preadv"/>
      </repeat>
      <repeat from="0" upto="1">
        <match tags="adj.*"/>
      </repeat>
      <match  tags="n.*"/>
    </rule>
    <rule weight="1.0">
      <match lemma="se" tags="prn.pro.*"/>
      <or>
        <match tags="vbmod.*.p3.*"/>
        <match lemma="anar" tags="vblex.*.p3.*"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="devirar" tags="vblex.inf"><select lemma="transformer"/></match>
      <match lemma="en" tags="pr"/>
      <repeat from="0" upto="1">
        <match tags="det.*"/>
      </repeat>
      <repeat from="0" upto="1">
        <match tags="preadv"/>
      </repeat>
      <repeat from="0" upto="1">
        <match tags="adj.*"/>
      </repeat>
      <match  tags="n.*"/>
    </rule>
    <rule weight="1.0">
      <match lemma="se" tags="prn.pro.*"/>
      <match tags="vbser.*.p3.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <or>
        <match tags="vbmod.pp.*"/>
        <match lemma="anar" tags="vblex.pp.*"/>
      </or>
      <match lemma="devirar" tags="vblex.inf"><select lemma="transformer"/></match>
      <match lemma="en" tags="pr"/>
      <repeat from="0" upto="1">
        <match tags="det.*"/>
      </repeat>
      <repeat from="0" upto="1">
        <match tags="preadv"/>
      </repeat>
      <repeat from="0" upto="1">
        <match tags="adj.*"/>
      </repeat>
      <match  tags="n.*"/>
    </rule>
    <rule weight="1.0">
      <match lemma="se" tags="prn.pro.*"/>
      <or>
        <match lemma="en" tags="prn.pro.adv"/>
        <match lemma="ac" tags="prn.pro.*"/>
      </or>
      <match lemma="devirar" tags="vblex.*"><select lemma="sortir"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="se" tags="prn.pro.*"/>
      <or>
        <match lemma="en" tags="prn.pro.adv"/>
        <match lemma="ac" tags="prn.pro.*"/>
      </or>
      <match tags="vbser.*.p3.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="devirar" tags="vblex.pp.*"><select lemma="sortir"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="se" tags="prn.pro.*"/>
      <or>
        <match lemma="en" tags="prn.pro.adv"/>
        <match lemma="ac" tags="prn.pro.*"/>
      </or>
      <or>
        <match tags="vbmod.*.p3.*"/>
        <match lemma="anar" tags="vblex.*.p3.*"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="devirar" tags="vblex.inf"><select lemma="sortir"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="se" tags="prn.pro.*"/>
      <or>
        <match lemma="en" tags="prn.pro.adv"/>
        <match lemma="ac" tags="prn.pro.*"/>
      </or>
      <match tags="vbser.*.p3.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <or>
        <match tags="vbmod.pp.*"/>
        <match lemma="anar" tags="vblex.pp.*"/>
      </or>
      <match lemma="devirar" tags="vblex.inf"><select lemma="sortir"/></match>
    </rule>
  </rules>
</lrx>

