      <match lemma="abitant" tags="n.*"/>
      <match lemma="estatjant" tags="n.*"/>
      <match lemma="demoraire" tags="n.*"/>
      <match lemma="poblant" tags="n.*"/>
      <match lemma="cap" tags="n.mf.*"/>
