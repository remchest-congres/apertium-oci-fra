      <match lemma="briològue" tags="n.*"/>
      <match lemma="cancerològue" tags="n.*"/>
      <match lemma="cardiològue" tags="n.*"/>
      <match lemma="climatològue" tags="n.*"/>
      <match lemma="colagògue" tags="n.*"/>
      <match lemma="cosmològue" tags="n.*"/>
      <match lemma="criminològue" tags="n.*"/>
      <match lemma="demagògue" tags="n.*"/>
      <match lemma="dermatològue" tags="n.*"/>
      <match lemma="dialectològue" tags="n.*"/>
      <match lemma="egiptològue" tags="n.*"/>
      <match lemma="ematològue" tags="n.*"/>
      <match lemma="endocrinològue" tags="n.*"/>
      <match lemma="enològue" tags="n.*"/>
      <match lemma="epatològue" tags="n.*"/>
      <match lemma="epistemològue" tags="n.*"/>
      <match lemma="espeleològue" tags="n.*"/>
      <match lemma="estomatològue" tags="n.*"/>
      <match lemma="esturlògue" tags="n.*"/>
      <match lemma="etnològue" tags="n.*"/>
      <match lemma="farmacològue" tags="n.*"/>
      <match lemma="fenomenològue" tags="n.*"/>
      <match lemma="filològue" tags="n.*"/>
      <match lemma="fisiològue" tags="n.*"/>
      <match lemma="flebològue" tags="n.*"/>
      <match lemma="fonològue" tags="n.*"/>
      <match lemma="frenològue" tags="n.*"/>
      <match lemma="ftisiològue" tags="n.*"/>
      <match lemma="futurològue" tags="n.*"/>
      <match lemma="gastroenterològue" tags="n.*"/>
      <match lemma="gemmològue" tags="n.*"/>
      <match lemma="geològue" tags="n.*"/>
      <match lemma="geomorfològue" tags="n.*"/>
      <match lemma="gerontològue" tags="n.*"/>
      <match lemma="ginecològue" tags="n.*"/>
      <match lemma="grafològue" tags="n.*"/>
      <match lemma="ictiològue" tags="n.*"/>
      <match lemma="ideològue" tags="n.*"/>
      <match lemma="idrològue" tags="n.*"/>
      <match lemma="immunològue" tags="n.*"/>
      <match lemma="iridològue" tags="n.*"/>
      <match lemma="islamològue" tags="n.*"/>
      <match lemma="lexicològue" tags="n.*"/>
      <match lemma="marxològue" tags="n.*"/>
      <match lemma="meteorològue" tags="n.*"/>
      <match lemma="micològue" tags="n.*"/>
      <match lemma="mistagògue" tags="n.*"/>
      <match lemma="mitològue" tags="n.*"/>
      <match lemma="museològue" tags="n.*"/>
      <match lemma="musicològue" tags="n.*"/>
      <match lemma="nefrològue" tags="n.*"/>
      <match lemma="neurològue" tags="n.*"/>
      <match lemma="nivològue" tags="n.*"/>
      <match lemma="oceanològue" tags="n.*"/>
      <match lemma="odontològue" tags="n.*"/>
      <match lemma="oftalmològue" tags="n.*"/>
      <match lemma="omològue" tags="n.*"/>
      <match lemma="oncològue" tags="n.*"/>
      <match lemma="onirològue" tags="n.*"/>
      <match lemma="ornitològue" tags="n.*"/>
      <match lemma="otorinolaringològue" tags="n.*"/>
      <match lemma="paleològue" tags="n.*"/>
      <match lemma="paleontològue" tags="n.*"/>
      <match lemma="palinològue" tags="n.*"/>
      <match lemma="papirològue" tags="n.*"/>
      <match lemma="patològue" tags="n.*"/>
      <match lemma="pedagògue" tags="n.*"/>
      <match lemma="pedològue" tags="n.*"/>
      <match lemma="pneumològue" tags="n.*"/>
      <match lemma="podològue" tags="n.*"/>
      <match lemma="politològue" tags="n.*"/>
      <match lemma="pomològue" tags="n.*"/>
      <match lemma="proctològue" tags="n.*"/>
      <match lemma="psicològue" tags="n.*"/>
      <match lemma="radiològue" tags="n.*"/>
      <match lemma="raumatològue" tags="n.*"/>
      <match lemma="rumatològue" tags="n.*"/>
      <match lemma="semiològue" tags="n.*"/>
      <match lemma="sexològue" tags="n.*"/>
      <match lemma="sialagògue" tags="n.*"/>
      <match lemma="sidològue" tags="n.*"/>
      <match lemma="sinològue" tags="n.*"/>
      <match lemma="sismològue" tags="n.*"/>
      <match lemma="sitològue" tags="n.*"/>
      <match lemma="sociològue" tags="n.*"/>
      <match lemma="sovietològue" tags="n.*"/>
      <match lemma="tecnològue" tags="n.*"/>
      <match lemma="teratològue" tags="n.*"/>
      <match lemma="toxicològue" tags="n.*"/>
      <match lemma="traumatològue" tags="n.*"/>
      <match lemma="urològue" tags="n.*"/>
      <match lemma="virològue" tags="n.*"/>
      <match lemma="vulcanològue" tags="n.*"/>
    </or></def-seq>
  </def-seqs>

  <rules>
    <!-- **************** VBSER **************** -->

    <!-- vbser >> être, avoir -->
    <rule weight="0.8">
      <match tags="vbser.*"><select lemma="être"/></match>
    </rule>
    <rule weight="1.0">
      <match tags="vbser.*"><select lemma="avoir"/></match>
      <repeat from="0" upto="3">
        <match tags="adv"/>
      </repeat>
      <or>
        <match lemma="èsser" tags="vbser.pp.*"/>
        <match lemma="èsser" tags="vblex.pp.*"/>
        <match lemma="estar" tags="vbser.pp.*"/>
        <match lemma="estar" tags="vblex.pp.*"/>
      </or>
    </rule>


    <!-- **************** VBMOD **************** -->

    <!-- sòler >> avoir# l'habitude de, avoir# l'habitude -->
    <rule weight="0.8">
      <match lemma="sòler" tags="vbmod.*"><select lemma="avoir# l'habitude"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="sòler" tags="vbmod.*"><select lemma="avoir# l'habitude de"/></match>
      <repeat from="0" upto="3">
        <or>
          <match tags="adv"/>
          <match tags="prn.pro.*"/>
        </or>
      </repeat>
      <match tags="*.inf"/>
    </rule>


    <!-- **************** VBLEX **************** -->

    <!-- esguitar >> jaillir, poindre -->
    <rule weight="0.8">
      <match lemma="esguitar" tags="vblex.*"><select lemma="jaillir"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="esguitar" tags="vblex.*"><select lemma="poindre"/></match>
      <repeat from="0" upto="4">
        <or>
          <match tags="*"/>
          <match tags=""/>
        </or>
      </repeat>
      <or>
        <match lemma="solelh" tags="n.*"/>
        <match lemma="sorelh" tags="n.*"/>
        <match lemma="solei" tags="n.*"/>
        <match lemma="só" tags="n.*"/>
        <match lemma="sóu" tags="n.*"/>
        <match lemma="alba" tags="n.*"/>
        <match lemma="auba" tags="n.*"/>
        <match lemma="primalba" tags="n.*"/>
        <match lemma="jorn" tags="n.*"/>
        <match lemma="dia" tags="n.*"/>
        <match lemma="matin" tags="n.*"/>
      </or>
    </rule>

    <!-- téner >> tenir, tendre -->
    <rule weight="0.8">
      <match lemma="téner" tags="vblex.*"><select lemma="tenir"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="téner" tags="vblex.*"><select lemma="tendre"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <repeat from="0" upto="2">
        <or>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <or>
        <match lemma="tenda" tags="n.*"/>
        <match lemma="trapèla" tags="n.*"/>
        <match lemma="tracanard" tags="n.*"/>
      </or>
    </rule>

    <!-- armar >> armer, tendre -->
    <rule weight="0.8">
      <match lemma="armar" tags="vblex.*"><select lemma="armer"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="armar" tags="vblex.*"><select lemma="tendre"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <repeat from="0" upto="2">
        <or>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <or>
        <match lemma="tenda" tags="n.*"/>
        <match lemma="trapèla" tags="n.*"/>
        <match lemma="tracanard" tags="n.*"/>
      </or>
    </rule>

    <!-- preparar >> préparer, tendre -->
    <rule weight="0.8">
      <match lemma="preparar" tags="vblex.*"><select lemma="préparer"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="preparar" tags="vblex.*"><select lemma="tendre"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <repeat from="0" upto="2">
        <or>
          <match tags="det.*"/>
          <match tags="num.*"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <or>
        <match lemma="emboscada" tags="n.*"/>
        <match lemma="embuscada" tags="n.*"/>
      </or>
    </rule>

    <!-- parar >> parer, tendre -->
    <rule weight="0.8">
      <match lemma="parar" tags="vblex.*"><select lemma="parer"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="parar" tags="vblex.*"><select lemma="tendre"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <or>
        <match tags="det.def.*"/>
        <match tags="det.pos.*"/>
      </or>
      <or>
        <match lemma="aurelha" tags="n.*"/>
        <match lemma="man" tags="n.*"/>
      </or>
    </rule>

    <!-- trepejar >> piétiner, fouler -->
    <rule weight="0.8">
      <match lemma="trepejar" tags="vblex.*"><select lemma="piétiner"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="trepejar" tags="vblex.*"><select lemma="fouler"/></match>
      <repeat from="0" upto="4">
        <or>
          <match tags="*"/>
          <match tags=""/>
        </or>
      </repeat>
      <or>
        <match lemma="tèrra" tags="n.*"/>
        <match lemma="bòsc" tags="n.*"/>
        <match lemma="forèst" tags="n.*"/>
        <match lemma="selva" tags="n.*"/>
        <match lemma="sèlva" tags="n.*"/>
        <match lemma="seuva" tags="n.*"/>
        <match lemma="sèuva" tags="n.*"/>
        <match lemma="illa" tags="n.*"/>
        <match lemma="ilha" tags="n.*"/>
        <match lemma="isla" tags="n.*"/>
        <match lemma="iscla" tags="n.*"/>
        <match lemma="ièrla" tags="n.*"/>
      </or>
    </rule>
    <rule weight="1.0">
      <or>
        <match lemma="tèrra" tags="n.*"/>
        <match lemma="bòsc" tags="n.*"/>
        <match lemma="forèst" tags="n.*"/>
        <match lemma="selva" tags="n.*"/>
        <match lemma="sèlva" tags="n.*"/>
        <match lemma="seuva" tags="n.*"/>
        <match lemma="sèuva" tags="n.*"/>
        <match lemma="illa" tags="n.*"/>
        <match lemma="ilha" tags="n.*"/>
        <match lemma="isla" tags="n.*"/>
        <match lemma="iscla" tags="n.*"/>
        <match lemma="ièrla" tags="n.*"/>
      </or>
      <repeat from="0" upto="4">
        <or>
          <match tags="*"/>
          <match tags=""/>
        </or>
      </repeat>
      <match lemma="trepejar" tags="vblex.*"><select lemma="fouler"/></match>
    </rule>

    <!-- despatolhar >> dépatouiller, débrouiller -->
    <macro n="verb_nopron_pron"><with-param v="despatolhar"/><with-param v="dépatouiller"/><with-param v="débrouiller"/></macro>

    <!-- engenhar >> machiner, débrouiller -->
    <macro n="verb_nopron_pron"><with-param v="engenhar"/><with-param v="machiner"/><with-param v="débrouiller"/></macro>

    <!-- esberrocar >> bramer, égosiller -->
    <macro n="verb_nopron_pron"><with-param v="esberrocar"/><with-param v="bramer"/><with-param v="égosiller"/></macro>

    <!-- honir >> foncer, précipiter -->
    <macro n="verb_nopron_pron"><with-param v="honir"/><with-param v="foncer"/><with-param v="précipiter"/></macro>

    <!-- morir >> mourir, mourir non-pron -->
    <rule weight="0.8">
      <match lemma="morir" tags="vblex.*"><select lemma="mourir" tags="vblex.non-pron.*"/></match>
    </rule>

    <!-- afortir >> renforcer, affirmer -->
    <rule weight="0.8">
      <match lemma="afortir" tags="vblex.*"><select lemma="renforcer"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="afortir" tags="vblex.*"><select lemma="affirmer"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="que" tags="cnjsub"/>
    </rule>

    <!-- assolidar >> consolider, affirmer -->
    <rule weight="0.8">
      <match lemma="assolidar" tags="vblex.*"><select lemma="consolider"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="assolidar" tags="vblex.*"><select lemma="affirmer"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="que" tags="cnjsub"/>
    </rule>

    <!-- amassar >> amasser, rassembler/réunir -->
    <rule weight="0.8">
      <match lemma="amassar" tags="vblex.*"><select lemma="amasser"/></match>
    </rule>

    <!-- premiar >> primer, décerner# un prix, décerner# un prix à -->
    <rule weight="0.8">
      <match lemma="premiar" tags="vblex.*"><select lemma="primer"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="premiar" tags="vblex.*"><select lemma="décerner# un prix à"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <repeat from="0" upto="1">
        <match tags="det.*"/>
      </repeat>
      <or>
        <seq n="personas"/>
        <match tags="np.ant.*"/>
        <match tags="np.cog.*"/>
      </or>
    </rule>

    <!-- ahumar >> enfumer, irriter -->
    <macro n="verb_intrans_trans"><with-param v="ahumar"/><with-param v="enfumer"/><with-param v="irriter"/></macro>
    <rule weight="1.2">
      <or>
        <match tags="n.*"/>
        <match tags="adj.*"/>
      </or>
      <match lemma="ahumar" tags="vblex.pp.*"><select lemma="enfumer"/></match>
    </rule>
    <rule weight="1.4">
      <or>
        <seq n="personas"/>
      </or>
      <repeat from="0" upto="2">
        <or>
          <match tags="preadv"/>
          <match tags="adv"/>
          <match tags="adj.*"/>
        </or>
      </repeat>
      <match lemma="ahumar" tags="vblex.pp.*"><select lemma="irriter"/></match>
    </rule>

    <!-- alludir >> faire# allusion, avoir# allusion à -->
    <macro n="verb_intrans_trans"><with-param v="alludir"/><with-param v="faire# allusion"/><with-param v="faire# allusion à"/></macro>

    <!-- en·horatar >> blouser, terrer -->
    <macro n="verb_intrans_trans"><with-param v="en·horatar"/><with-param v="blouser"/><with-param v="terrer"/></macro>

    <!-- prémer >> appuyer, appuyer# sur -->
    <macro n="verb_intrans_trans"><with-param v="prémer"/><with-param v="appuyer"/><with-param v="appuyer# sur"/></macro>

    <!-- priorizar >> donner# la priorité, donner# la priorité à -->
    <macro n="verb_intrans_trans"><with-param v="priorizar"/><with-param v="donner# la priorité"/><with-param v="donner# la priorité à"/></macro>

    <!-- vetar >> mettre# son veto, mettre# son veto à -->
    <macro n="verb_intrans_trans"><with-param v="vetar"/><with-param v="mettre# son veto"/><with-param v="mettre# son veto à"/></macro>

    <!-- tombar >> tomber, faire# tomber -->
    <macro n="verb_intrans_trans"><with-param v="tombar"/><with-param v="tomber"/><with-param v="faire# tomber"/></macro>
    <rule weight="1.2">
      <or>
        <match tags="vbser.*"/>
        <match lemma="semblar" tags="vblex.*"/>
        <match lemma="paréisser" tags="vblex.*"/>
        <match lemma="paréisher" tags="vblex.*"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="tombar" tags="vblex.pp.*"><select lemma="tomber"/></match>
    </rule>
    <rule weight="1.2">
      <or>
        <match tags="vbser.*"/>
        <match lemma="daissar" tags="vblex.*"/>
        <match lemma="laissar" tags="vblex.*"/>
        <match lemma="deishar" tags="vblex.*"/>
        <match lemma="leishar" tags="vblex.*"/>
        <match lemma="far" tags="vblex.*"/>
        <match lemma="har" tags="vblex.*"/>
        <match lemma="hèr" tags="vblex.*"/>
        <match lemma="hèser" tags="vblex.*"/>
        <match lemma="faire" tags="vblex.*"/>
      </or>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="tombar" tags="vblex.inf"><select lemma="tomber"/></match>
    </rule>
    <rule weight="1.2">
      <match tags="vbhaver.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="tombar" tags="vblex.pp.*"><select lemma="faire# tomber"/></match>
    </rule>
    <rule weight="1.2">
      <or>
        <match tags="n.*"/>
        <match tags="adj.*"/>
        <match tags="vblex.pp.*"/>
      </or>
      <repeat from="0" upto="2">
      <or>
          <match tags="preadv"/>
          <match tags="adv"/>
      </or>
      </repeat>
      <match lemma="tombar" tags="vblex.pp.*"><select lemma="tomber"/></match>
    </rule>

    <!-- avergonhar >> faire# honte, avoir# honte -->
    <macro n="verb_nopron_pron"><with-param v="avergonhar"/><with-param v="faire# honte"/><with-param v="avoir# honte"/></macro>

    <!-- avergonhir >> faire# honte, avoir# honte -->
    <macro n="verb_nopron_pron"><with-param v="avergonhir"/><with-param v="faire# honte"/><with-param v="avoir# honte"/></macro>

    <!-- eishorrisclar >> rire# aux éclats, bidonner -->
    <macro n="verb_nopron_pron"><with-param v="eishorrisclar"/><with-param v="rire# aux éclats"/><with-param v="bidonner"/></macro>

    <!-- espossar >> crever, épuiser -->
    <macro n="verb_nopron_pron"><with-param v="espossar"/><with-param v="crever"/><with-param v="épuiser"/></macro>

    <!-- sietar >> siéger, asseoir -->
    <macro n="verb_nopron_pron"><with-param v="sietar"/><with-param v="siéger"/><with-param v="asseoir"/></macro>

    <!-- tarridar >> plaisanter, faire# du souci -->
    <macro n="verb_nopron_pron"><with-param v="tarridar"/><with-param v="plaisanter"/><with-param v="faire# du souci"/></macro>

    <!-- tartucar >> hésiter, faire# du souci -->
    <macro n="verb_nopron_pron"><with-param v="tartucar"/><with-param v="hésiter"/><with-param v="faire# du souci"/></macro>

    <!-- des·har >> défaire, débarrasser (de) -->
    <macro n="verb_nopron_pron_prep"><with-param v="des·har"/><with-param v="défaire"/><with-param v="débarrasser"/><with-param v="de"/></macro>

    <!-- des·hèr >> défaire, débarrasser (de) -->
    <macro n="verb_nopron_pron_prep"><with-param v="des·hèr"/><with-param v="défaire"/><with-param v="débarrasser"/><with-param v="de"/></macro>

    <!-- espaimar >> évanouir, pâmer (de) -->
    <macro n="verb_nopron_pron_prep"><with-param v="espaimar"/><with-param v="évanouir"/><with-param v="pâmer"/><with-param v="de"/></macro>

    <!-- avisar >> aviser, rendre# compte (de), occuper (de) -->
    <macro n="verb_nopron_pron_prep"><with-param v="avisar"/><with-param v="aviser"/><with-param v="rendre# compte"/><with-param v="de"/></macro>
    <rule weight="2.0">
      <match tags="prn.pro.*"/>
      <match lemma="avisar" tags="vblex.*"><select lemma="occuper"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="de" tags="pr"/>
      <repeat from="0" upto="2">
        <match tags="prn.pro.*"/>
      </repeat>
      <match tags="*.inf"/>
    </rule>
    <rule weight="2.0">
      <match tags="prn.pro.*"/>
      <match tags="vbser.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="avisar" tags="vblex,pp.*"><select lemma="occuper"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="de" tags="pr"/>
      <repeat from="0" upto="2">
        <match tags="prn.pro.*"/>
      </repeat>
      <match tags="*.inf"/>
    </rule>

    <!-- trachar >> apercevoir, rendre# compte (de), occuper (de) -->
    <macro n="verb_nopron_pron_prep"><with-param v="trachar"/><with-param v="apercevoir"/><with-param v="rendre# compte"/><with-param v="de"/></macro>
    <rule weight="2.0">
      <match tags="prn.pro.*"/>
      <match lemma="trachar" tags="vblex.*"><select lemma="occuper"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="de" tags="pr"/>
      <repeat from="0" upto="2">
        <match tags="prn.pro.*"/>
      </repeat>
      <match tags="*.inf"/>
    </rule>
    <rule weight="2.0">
      <match tags="prn.pro.*"/>
      <match tags="vbser.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="trachar" tags="vblex,pp.*"><select lemma="occuper"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="de" tags="pr"/>
      <repeat from="0" upto="2">
        <match tags="prn.pro.*"/>
      </repeat>
      <match tags="*.inf"/>
    </rule>

    <!-- entrevar >> informer, occuper (de) -->
    <rule weight="0.8">
      <match lemma="entrevar" tags="vblex.*"><select lemma="informer"/></match>
    </rule>
    <rule weight="2.0">
      <match tags="prn.pro.*"/>
      <match lemma="entrevar" tags="vblex.*"><select lemma="occuper"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="de" tags="pr"/>
      <repeat from="0" upto="2">
        <match tags="prn.pro.*"/>
      </repeat>
      <match tags="*.inf"/>
    </rule>
    <rule weight="2.0">
      <match tags="prn.pro.*"/>
      <match tags="vbser.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="entrevar" tags="vblex,pp.*"><select lemma="occuper"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="de" tags="pr"/>
      <repeat from="0" upto="2">
