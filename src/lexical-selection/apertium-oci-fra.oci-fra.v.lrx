    <macro n="verb_nopron_pron"><with-param v="recordar"/><with-param v="rappeler"/><with-param v="souvenir"/></macro>

    <!-- dire >> dire, appeler -->
    <rule weight="0.8">
      <match lemma="díser" tags="vblex.*"><select lemma="dire"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="se" tags="prn.pro.*"/>
      <match lemma="díser" tags="vblex.*.p3.sg"><select lemma="appeler"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match tags="det.*"/>
    </rule>

    <rule weight="0.8">
      <match lemma="díser" tags="vblex.*"><select lemma="dire"/></match>
    </rule>
    <rule weight="1.0">
      <match lemma="se" tags="prn.pro.*"/>
      <match lemma="díser" tags="vblex.*.p3.sg"><select lemma="appeler"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match tags="det.*"/>
    </rule>

    <!-- enlairar >> élever, décoller -->
    <macro n="verb_nopron_pron"><with-param v="enlairar"/><with-param v="élever"/><with-param v="décoller"/></macro>

    <!-- sonar >> sonner, appeler -->
    <macro n="verb_nopron_pron"><with-param v="sonar"/><with-param v="sonner"/><with-param v="appeler"/></macro>
    <rule weight="1.4">
      <match lemma="sonar" tags="vblex.*"><select lemma="appeler"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="«" tags="lpar"/>
    </rule>
    <rule weight="1.4">
      <match lemma="lo" tags="prn.pro.*"/>
      <match lemma="sonar" tags="vblex.*"><select lemma="appeler"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <or>
        <match tags="n.*"/>
        <match tags="np.*"/>
        <match tags="" case="Aa"/>
        <match lemma="«" tags="lpar"/>
      </or>
    </rule>
    <rule weight="1.4">
      <match lemma="lo" tags="prn.pro.*"/>
      <match tags="vbhaver.*"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="sonar" tags="vblex.pp.*"><select lemma="appeler"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <or>
        <match tags="n.*"/>
        <match tags="np.*"/>
        <match tags="" case="Aa"/>
        <match lemma="«" tags="lpar"/>
      </or>
    </rule>
    <rule weight="1.4">
      <or>
        <match lemma="tanben"/>
        <match tags="vbser,*"/>
      </or>
      <match lemma="sonar" tags="vblex.pp.*"><select lemma="appeler"/></match>
      <or>
        <match tags="n.*"/>
        <match tags="np.*"/>
        <match tags="" case="Aa"/>
        <match lemma="«" tags="lpar"/>
      </or>
    </rule>
    <rule weight="1.4">
      <match tags="cm"/>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <match lemma="sonar" tags="vblex.pp.*"><select lemma="appeler"/></match>
      <or>
        <match tags="n.*"/>
        <match tags="np.*"/>
        <match tags="" case="Aa"/>
        <match lemma="«" tags="lpar"/>
      </or>
    </rule>
    <rule weight="1.4">
      <match lemma="sonar" tags="vblex.*"><select lemma="appeler"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <repeat from="0" upto="1">
        <match tags="det.def.*"/>
      </repeat>
      <or>
        <match tags="np.*"/>
        <match tags="" case="Aa"/>
      </or>
    </rule>
    <rule weight="1.4">
      <match lemma="sonar" tags="vblex.*"><select lemma="appeler"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <or>
        <match tags="det.*"/>
        <match tags="num.*"/>
        <match tags="num"/>
      </or>
      <or>
        <seq n="personas"/>
        <match lemma="familha" tags="n.*"/>
      </or>
    </rule>
    <rule weight="1.4">
      <match lemma="sonar" tags="vblex.*"><select lemma="appeler"/></match>
      <repeat from="0" upto="2">
        <match tags="adv"/>
      </repeat>
      <or>
        <seq n="personas"/>
        <match lemma="familha" tags="n.*.pl"/>
