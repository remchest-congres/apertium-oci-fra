<?xml version="1.0" encoding="UTF-8"?>
<modes>

  <!-- fra → oci -->

  <mode name="fra-oci" install="yes" gendebug="yes">
    <pipeline>
      <program name="lt-proc -w">
        <file name="bin/fra-oci.automorf.bin"/>
      </program>
      <program name="cg-proc -w" debug-suff="disamb">
        <file name="bin/fra-oci.rlx.bin"/>
      </program>
      <program name="apertium-tagger -g $2">
        <file name="bin/fra-oci.prob"/>
      </program>
      <program name="apertium-pretransfer"/>
      <!-- fichier spécifique à la variété courrante -->
      <!-- <program name="lsx-proc" debug-suff="lsx1_lang">
        <file name="bin/fra-oci.autosep1_lang.bin"/>
      </program> -->
      <program name="lsx-proc" debug-suff="lsx1_common">
        <file name="bin/fra-oci.autosep1.bin"/> <!-- fichier commun à toutes les variétés -->
      </program>
      <program name="lt-proc -b">
        <file name="bin/fra-oci.autobil.bin"/>
      </program>
      <!-- on désambiguise avant le transfer selon les préférences de l'utilisateur (aka on fait un pré tri dans le dico bilingue)-->
      <program name="cg-proc" debug-suff="biprefs">
        <file name="bin/fra-oci.biprefs.rlx.bin"/>
      </program>
      <program name="lrx-proc -m" debug-suff="lex_np">
        <file name="bin/fra-oci.np.autolex.bin"/>
      </program>
      <program name="lrx-proc -m" debug-suff="lex_n">
        <file name="bin/fra-oci.n_a_adv.autolex.bin"/>
      </program>
      <program name="lrx-proc -m" debug-suff="lex_v">
        <file name="bin/fra-oci.v.autolex.bin"/>
      </program>
      <program name="lrx-proc -m" debug-suff="lex">
        <file name="bin/fra-oci.other.autolex.bin"/>
      </program>
      <program name="apertium-transfer -b">
        <file name="build/fra-oci.t1x"/>
        <file name="bin/fra-oci.t1x.bin"/>
      </program>
      <program name="apertium-interchunk" debug-suff="interchunk_ini">
        <file name="src/transfer/interchunks/apertium-oci-fra.fra-oci.t2x_ini"/>
        <file name="bin/fra-oci.t2x_ini.bin"/>
      </program>
      <program name="apertium-interchunk">
        <file name="build/fra-oci_lang.t2x"/>
        <file name="bin/fra-oci_lang.t2x.bin"/>
      </program>
      <program name="apertium-interchunk">
        <file name="build/fra-oci.t2x"/>
        <file name="bin/fra-oci.t2x.bin"/>
      </program>
      <program name="apertium-interchunk" debug-suff="interchunk_bis">
        <file name="build/fra-oci.t2x_bis"/>
        <file name="bin/fra-oci.t2x_bis.bin"/>
      </program>
      <program name="apertium-interchunk" debug-suff="interchunk_pas">
        <file name="src/transfer/interchunks/apertium-oci-fra.fra-oci.t2x_pas"/>
        <file name="bin/fra-oci.t2x_pas.bin"/>
      </program>
      <program name="apertium-interchunk" debug-suff="interchunk_pro">
        <file name="src/transfer/interchunks/apertium-oci-fra.fra-oci.t2x_pro"/>
        <file name="bin/fra-oci.t2x_pro.bin"/>
      </program>
      <program name="apertium-postchunk">
        <file name="src/transfer/postchunks/apertium-oci-fra.fra-oci.t3x"/>
        <file name="bin/fra-oci.t3x.bin"/>
      </program>
      <program name="apertium-transfer -n" debug-suff="t4x">
        <file name="src/transfer/final-rules/apertium-oci-fra.fra-oci.t4x"/>
        <file name="bin/fra-oci.t4x.bin"/>
      </program>
      <program name="lsx-proc" debug-suff="lsx2">
        <file name="bin/fra-oci.autosep2.bin"/>
      </program>
      <program name="apertium-posttransfer" debug-suff="posttransfer"/>
      <program name="lt-proc $1 -b" debug-suff="dgen">
        <file name="bin/fra-oci.autogen.bin"/>
      </program>
      <!-- on désambiguise les réponses du dico monoligue en fonction des règles de préférence du dico monoligue et des  variables de l'utilisateur -->
      <program name="cg-proc -1 -n -g" debug-suff="genprefs">
        <file name="bin/fra-oci.genprefs.rlx.bin"/>
      </program>
      <program name="lt-proc -p">
        <file name="bin/fra-oci.autopgen.bin"/>
      </program>
    </pipeline>
  </mode>

  <mode name="fra-oci-disam" install="no">
