    <rule comment="RÈGLA: SV_pers pas CNJSUB DE SN_pl PREP DET SN SV_pers (vòli pas que de cançons de l'ostal sián > NE veux pas que des chansons de la maison soient)">
      <pattern>
        <pattern-item n="SV_pers"/>
        <pattern-item n="pas"/>
        <pattern-item n="cnjsub"/>
        <pattern-item n="PREP_de"/>
        <pattern-item n="SN_pl"/>
        <pattern-item n="PREP"/>
        <pattern-item n="Det"/>
        <pattern-item n="SN_UNK"/>
        <pattern-item n="SV_pers_UNK"/>
      </pattern>
      <action>
        <call-macro n="gen_ne"><with-param pos="1"/></call-macro>
        <out>
          <chunk>
            <get-case-from pos="2">
              <clip pos="1" part="lem"/>
            </get-case-from>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="whole"/>
          </chunk>
          <b pos="2"/>
          <chunk>
            <clip pos="3" part="whole"/>
          </chunk>
          <b pos="3"/>
          <chunk>
            <clip pos="4" part="whole"/>
          </chunk>
          <b pos="4"/>
          <chunk>
            <clip pos="5" part="whole"/>
          </chunk>
          <b pos="5"/>
          <chunk>
            <clip pos="6" part="whole"/>
          </chunk>
          <b pos="6"/>
          <chunk>
            <clip pos="7" part="whole"/>
          </chunk>
          <b pos="7"/>
          <chunk>
            <clip pos="8" part="whole"/>
          </chunk>
          <b pos="8"/>
          <chunk>
            <clip pos="9" part="whole"/>
          </chunk>
        </out>
        <let><var n="v_det_pron_neg"/><lit v="false"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: SV_pers pas CNJSUB DE SN_pl PREP SN SPron_pro SV_pers (vòli pas que de cançons de trabalh i sián > NE veux pas que des chansons de travail y soient)">
      <pattern>
        <pattern-item n="SV_pers"/>
        <pattern-item n="pas"/>
        <pattern-item n="cnjsub"/>
        <pattern-item n="PREP_de"/>
        <pattern-item n="SN_pl"/>
        <pattern-item n="PREP"/>
        <pattern-item n="SN_UNK"/>
        <pattern-item n="SPron_pro"/>
        <pattern-item n="SV_pers_UNK"/>
      </pattern>
      <action>
        <call-macro n="gen_ne"><with-param pos="1"/></call-macro>
        <out>
          <chunk>
            <get-case-from pos="2">
              <clip pos="1" part="lem"/>
            </get-case-from>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="whole"/>
          </chunk>
          <b pos="2"/>
          <chunk>
            <clip pos="3" part="whole"/>
          </chunk>
          <b pos="3"/>
          <chunk>
            <clip pos="4" part="whole"/>
          </chunk>
          <b pos="4"/>
          <chunk>
            <clip pos="5" part="whole"/>
          </chunk>
          <b pos="5"/>
          <chunk>
            <clip pos="6" part="whole"/>
          </chunk>
          <b pos="6"/>
          <chunk>
            <clip pos="7" part="whole"/>
          </chunk>
          <b pos="7"/>
          <chunk>
            <clip pos="8" part="whole"/>
          </chunk>
