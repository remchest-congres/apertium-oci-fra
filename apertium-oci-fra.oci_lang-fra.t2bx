    <rule comment="RÈGLA: SV_pers pas CNJSUB DE SN_pl PREP DET SN SPron_pro SV_pers (vòli pas que de cançons de l'ostal i sián > NE veux pas que des chansons de la maison y soient)">
      <pattern>
        <pattern-item n="SV_pers"/>
        <pattern-item n="pas"/>
        <pattern-item n="cnjsub"/>
        <pattern-item n="PREP_de"/>
        <pattern-item n="SN_pl"/>
        <pattern-item n="PREP"/>
        <pattern-item n="Det"/>
        <pattern-item n="SN_UNK"/>
        <pattern-item n="SPron_pro"/>
        <pattern-item n="SV_pers_UNK"/>
      </pattern>
      <action>
        <call-macro n="gen_ne"><with-param pos="1"/></call-macro>
        <out>
          <chunk>
            <get-case-from pos="2">
              <clip pos="1" part="lem"/>
            </get-case-from>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="whole"/>
          </chunk>
          <b pos="2"/>
          <chunk>
            <clip pos="3" part="whole"/>
          </chunk>
          <b pos="3"/>
          <chunk>
