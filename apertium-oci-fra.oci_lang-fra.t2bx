<?xml version="1.0" encoding="UTF-8"?>
<interchunk>
  <section-def-cats>
    <def-cat n="SN">
      <cat-item tags="SN"/>
      <cat-item tags="SN.*"/>
    </def-cat>
    <def-cat n="SN_UNK">
      <cat-item tags="SN"/>
      <cat-item tags="SN.*"/>
      <cat-item lemma="unkwnown" tags="unknown"/>
    </def-cat>
    <def-cat n="SN_pl">
      <cat-item tags="SN.*.pl"/>
      <cat-item tags="SN.*.pl.*"/>
    </def-cat>
    <def-cat n="SPron">
      <cat-item tags="SPron"/>
      <cat-item tags="SPron.*"/>
    </def-cat>
    <def-cat n="SPron_pro">
      <cat-item tags="SPron.pro"/>
      <cat-item tags="SPron.pro.*"/>
    </def-cat>
    <def-cat n="SAdv">
      <cat-item tags="SAdv"/>
      <cat-item tags="SAdv.*"/>
      <cat-item lemma="donc" tags="cnjadv"/>
      <cat-item lemma="cependant" tags="cnjadv"/>
      <cat-item lemma="néanmoins" tags="cnjadv"/>
      <cat-item lemma="nonobstant" tags="cnjadv"/>
      <cat-item lemma="tout de même" tags="cnjadv"/>
      <cat-item lemma="toutefois" tags="cnjadv"/>
    </def-cat>
    <def-cat n="ne">
      <cat-item lemma="ne" tags="SAdv"/>
      <cat-item lemma="ne" tags="SAdv.*"/>
    </def-cat>
    <def-cat n="pas">
      <cat-item lemma="pas" tags="SAdv"/>
      <cat-item lemma="pas" tags="SAdv.*"/>
      <cat-item lemma="même pas" tags="SAdv"/>
      <cat-item lemma="même pas" tags="SAdv.*"/>
    </def-cat>
    <def-cat n="SV">
      <cat-item tags="SV"/>
      <cat-item tags="SV.*"/>
    </def-cat>

    <def-cat n="SV_pers"><!--Formas personals e ger (qualqu'uns imperatius son excloses per ara) -->
      <cat-item tags="SV.*.p1.*"/>
      <cat-item tags="SV.*.p2.*"/>
      <cat-item tags="SV.*.p3.*"/>
      <cat-item tags="SVneg.*.p1.*"/>
      <cat-item tags="SVneg.*.p2.*"/>
      <cat-item tags="SVneg.*.p3.*"/>
      <cat-item lemma="sercj" tags="SV.*"/>
      <cat-item lemma="sercj" tags="SVneg.*"/>
      <cat-item lemma="verbcj" tags="SV.*"/>
      <cat-item lemma="verbcj" tags="SVneg.*"/>
      <cat-item lemma="havercj" tags="SV.*"/>
      <cat-item lemma="havercj" tags="SVneg.*"/>
      <cat-item tags="SV.*.ger"/>
      <cat-item tags="SVneg.*.ger"/>
    </def-cat>
    <def-cat n="SV_pers_UNK">
      <cat-item tags="SV.*.p1.*"/>
      <cat-item tags="SV.*.p2.*"/>
      <cat-item tags="SV.*.p3.*"/>
      <cat-item tags="SVneg.*.p1.*"/>
      <cat-item tags="SVneg.*.p2.*"/>
      <cat-item tags="SVneg.*.p3.*"/>
      <cat-item lemma="sercj" tags="SV.*"/>
      <cat-item lemma="sercj" tags="SVneg.*"/>
      <cat-item lemma="verbcj" tags="SV.*"/>
      <cat-item lemma="verbcj" tags="SVneg.*"/>
      <cat-item lemma="havercj" tags="SV.*"/>
      <cat-item lemma="havercj" tags="SVneg.*"/>
      <cat-item tags="SV.*.ger"/>
      <cat-item tags="SVneg.*.ger"/>
      <cat-item lemma="unkwnown" tags="unknown"/>
    </def-cat>

    <def-cat n="Det">
      <cat-item tags="Det"/>
      <cat-item tags="Det.*"/>
    </def-cat>

    <def-cat n="PREP">
      <cat-item tags="PREP"/>
    </def-cat>
    <def-cat n="PREP_de">
      <cat-item lemma="de" tags="PREP"/>
    </def-cat>

    <def-cat n="cnjsub">
      <cat-item tags="cnjsub"/>
      <cat-item tags="cnjsub.*"/>
    </def-cat>

    <def-cat n="unknown">
      <cat-item lemma="unkwnown" tags="unknown"/>
    </def-cat>
  </section-def-cats>

  <section-def-attrs>
    <def-attr n="chunk">
      <attr-item tags="SN"/>
      <attr-item tags="SV"/>
    </def-attr>
  </section-def-attrs>

  <section-def-vars>
    <def-var n="v_det_pron_neg" v="false"/>
  </section-def-vars>

  <section-def-macros>
    <def-macro n="f_bcond" npar="2"><!--Per mirar si el blanc conté o no format. Cal posar aquesta funció en les regles en què desaparegui alguna paraula, per tal de decidir si el blanc de la paraula eliminada s'ha d'eliminar o conservar. Si conté format cal conservar-la, si no en conté cal eliminar-la perquè no apareguin dos espais seguits. -->
     <choose>
       <when>
         <test>
           <not>
             <equal>
               <b pos="1"/>
               <lit v=" "/>
             </equal>
            </not>
         </test>
         <out>
           <b pos="1"/>
         </out>
       </when>
     </choose>
    </def-macro>

    <def-macro n="gen_ne" npar="1">
      <out>
        <chunk>
          <get-case-from pos="1">
            <lit v="ne"/>
          </get-case-from>
          <lit-tag v="SAdv"/>
          <lit v="{^"/>
          <get-case-from pos="1">
            <lit v="ne"/>
          </get-case-from>
          <lit-tag v="adv"/>
          <lit v="$}"/>
        </chunk>
        <b/>
      </out>
    </def-macro>
  </section-def-macros>

  <section-rules>
    <rule comment="RÈGLA: SV_pers pas CNJSUB DE SN_pl (cantes pas que de cançons tradicionalas > NE chantes que des chansons traditionnelles)">
      <pattern>
        <pattern-item n="SV_pers"/>
        <pattern-item n="pas"/>
        <pattern-item n="cnjsub"/>
        <pattern-item n="PREP_de"/>
        <pattern-item n="SN_pl"/>
      </pattern>
      <action>
        <call-macro n="gen_ne"><with-param pos="1"/></call-macro>
        <out>
          <chunk>
            <get-case-from pos="2">
              <clip pos="1" part="lem"/>
            </get-case-from>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
        </out>
        <call-macro n="f_bcond"><with-param pos="2"/><with-param pos="3"/></call-macro>
        <out>
          <chunk>
            <clip pos="3" part="whole"/>
          </chunk>
          <b pos="3"/>
          <chunk>
            <clip pos="4" part="whole"/>
          </chunk>
          <b pos="4"/>
          <chunk>
            <clip pos="5" part="whole"/>
          </chunk>
        </out>
        <let><var n="v_det_pron_neg"/><lit v="false"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: SV_pers pas CNJSUB DE SN_pl SV_pers (vòli pas que de cançons tradicionalas sián > NE veux pas que des chansons traditionnelles soient)">
      <pattern>
        <pattern-item n="SV_pers"/>
        <pattern-item n="pas"/>
        <pattern-item n="cnjsub"/>
        <pattern-item n="PREP_de"/>
        <pattern-item n="SN_pl"/>
        <pattern-item n="SV_pers_UNK"/>
      </pattern>
      <action>
        <call-macro n="gen_ne"><with-param pos="1"/></call-macro>
        <out>
          <chunk>
            <get-case-from pos="2">
              <clip pos="1" part="lem"/>
            </get-case-from>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="whole"/>
          </chunk>
          <b pos="2"/>
          <chunk>
            <clip pos="3" part="whole"/>
          </chunk>
          <b pos="3"/>
          <chunk>
            <clip pos="4" part="whole"/>
          </chunk>
          <b pos="4"/>
          <chunk>
            <clip pos="5" part="whole"/>
          </chunk>
          <b pos="5"/>
          <chunk>
            <clip pos="6" part="whole"/>
          </chunk>
        </out>
        <let><var n="v_det_pron_neg"/><lit v="false"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: SV_pers pas CNJSUB DE SN_pl SPron_pro SV_pers (vòli pas que de cançons tradicionalas i sián > NE veux pas que des chansons traditionnelles y soient)">
      <pattern>
        <pattern-item n="SV_pers"/>
        <pattern-item n="pas"/>
        <pattern-item n="cnjsub"/>
        <pattern-item n="PREP_de"/>
        <pattern-item n="SN_pl"/>
        <pattern-item n="SPron_pro"/>
        <pattern-item n="SV_pers_UNK"/>
      </pattern>
      <action>
        <call-macro n="gen_ne"><with-param pos="1"/></call-macro>
        <out>
          <chunk>
            <get-case-from pos="2">
              <clip pos="1" part="lem"/>
            </get-case-from>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="whole"/>
          </chunk>
          <b pos="2"/>
          <chunk>
            <clip pos="3" part="whole"/>
          </chunk>
          <b pos="3"/>
          <chunk>
            <clip pos="4" part="whole"/>
          </chunk>
          <b pos="4"/>
          <chunk>
            <clip pos="5" part="whole"/>
          </chunk>
          <b pos="5"/>
          <chunk>
            <clip pos="6" part="whole"/>
          </chunk>
          <b pos="6"/>
          <chunk>
            <clip pos="7" part="whole"/>
          </chunk>
        </out>
        <let><var n="v_det_pron_neg"/><lit v="false"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: SV_pers pas CNJSUB DE SN_pl SPron_pro SPron_pro SV_pers (vòli pas que de cançons tradicionalas li i sián > NE veux pas que des chansons traditionnelles lui y soient)">
      <pattern>
        <pattern-item n="SV_pers"/>
        <pattern-item n="pas"/>
        <pattern-item n="cnjsub"/>
        <pattern-item n="PREP_de"/>
        <pattern-item n="SN_pl"/>
        <pattern-item n="SPron_pro"/>
        <pattern-item n="SPron_pro"/>
        <pattern-item n="SV_pers_UNK"/>
      </pattern>
      <action>
        <call-macro n="gen_ne"><with-param pos="1"/></call-macro>
        <out>
          <chunk>
            <get-case-from pos="2">
              <clip pos="1" part="lem"/>
            </get-case-from>
            <clip pos="1" part="tags"/>
            <clip pos="1" part="chcontent"/>
          </chunk>
          <b pos="1"/>
          <chunk>
            <clip pos="2" part="whole"/>
          </chunk>
          <b pos="2"/>
          <chunk>
            <clip pos="3" part="whole"/>
          </chunk>
          <b pos="3"/>
          <chunk>
            <clip pos="4" part="whole"/>
          </chunk>
          <b pos="4"/>
          <chunk>
            <clip pos="5" part="whole"/>
          </chunk>
          <b pos="5"/>
          <chunk>
            <clip pos="6" part="whole"/>
          </chunk>
          <b pos="6"/>
          <chunk>
            <clip pos="7" part="whole"/>
          </chunk>
          <b pos="7"/>
          <chunk>
            <clip pos="8" part="whole"/>
          </chunk>
        </out>
        <let><var n="v_det_pron_neg"/><lit v="false"/></let>
      </action>
    </rule>

    <rule comment="RÈGLA: SV_pers pas CNJSUB DE SN_pl PREP SN SV_pers (vòli pas que de cançons de trabalh sián > NE veux pas que des chansons de travail soient)">
      <pattern>
